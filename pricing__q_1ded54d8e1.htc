2:Ta02,{"@context":"https://schema.org","@graph":[{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Pricing","item":"https://www.melius.com/pricing"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do credits work?","acceptedAnswer":{"@type":"Answer","text":"Credits are used when generating images, videos, and running AI-powered workflows in Melius. Different models and workflows consume different amounts of credits based on complexity and compute requirements. Before running any generation, you'll always be able to see the expected credit cost. You can track your remaining balance and usage at any time from your Team Settings."}},{"@type":"Question","name":"Can I cancel or change plans anytime?","acceptedAnswer":{"@type":"Answer","text":"For Creator, Growth, and Professional plans, you can upgrade, downgrade, or cancel at any time. Plan changes are prorated automatically based on your billing cycle. If you cancel, your subscription will remain active until the end of your current billing period."}},{"@type":"Question","name":"Do you offer custom plans?","acceptedAnswer":{"@type":"Answer","text":"Yes. Enterprise plans can be tailored to your team's needs, including custom credit allocations, onboarding, workspace configuration, dedicated support, training, and procurement requirements. Contact our team to discuss a plan built around your workflow."}},{"@type":"Question","name":"Can I purchase additional credits?","acceptedAnswer":{"@type":"Answer","text":"Yes. If you use all of your monthly credits, you can purchase a credit top-up at any time without upgrading your plan. You can also upgrade to a higher plan if you need additional recurring credits."}},{"@type":"Question","name":"Who owns the content I create?","acceptedAnswer":{"@type":"Answer","text":"You retain ownership of the content you create on Melius. Your creations remain yours to use, publish, and distribute, subject to the terms of the underlying AI model providers. Melius does not claim ownership of your content."}},{"@type":"Question","name":"How does Melius handle my data and creations?","acceptedAnswer":{"@type":"Answer","text":"Your content remains private to your workspace. Melius does not use your content to train generative AI models or replicate your styles, assets, or brand characteristics."}},{"@type":"Question","name":"Still have questions?","acceptedAnswer":{"@type":"Answer","text":"We're here to help. Reach out to support@melius.com and our team will get back to you as soon as possible."}}]}]}6:X
