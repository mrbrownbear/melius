bel":"E-commerce: Product Motion"}}}],"connections":[{"from":"node-1-1","to":"node-2"},{"from":"node-1-2","to":"node-2"},{"from":"node-2","to":"node-3"}]}},{"_key":"canvas-showcase-filmmaking","label":"Filmmaking","prompt":"Create a cinematic trailer frame from character, environment, camera, lens, lighting, and atmosphere references","background":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/filmmaking/background.webp","width":2880,"height":1624,"alt":"Filmmaking background"}},"scene":{"width":1820,"media":[{"_key":"filmmaking-node-1","id":"node-1","x":56,"y":164,"maxWidth":300,"tag":"Image","title":"Still Sketch","model":"GPT Image 2","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/filmmaking/node-1.webp","width":873,"height":492,"alt":"Filmmaking: Still Sketch"}}},{"_key":"filmmaking-node-2","id":"node-2","x":445,"y":143,"maxWidth":380,"tag":"Image","title":"Character Study","model":"Nano Banana 2","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/filmmaking/node-2.webp","width":1311,"height":732,"alt":"Filmmaking: Character Study"}}},{"_key":"filmmaking-node-3","id":"node-3","x":915,"y":115,"maxWidth":380,"tag":"Video","title":"Movie Cut 1","model":"Seedance 2.0","media":{"type":"video","video":{"src":"/media/pages/home/canvas-showcase/filmmaking/node-3.webm","width":1311,"height":732,"label":"Filmmaking: Movie Cut 1"}}},{"_key":"filmmaking-node-4","id":"node-4","x":1385,"y":185,"maxWidth":380,"tag":"Video","title":"Movie Cut 2","model":"Seedance 2.0","media":{"type":"video","video":{"src":"/media/pages/home/canvas-showcase/filmmaking/node-4.webm","width":1311,"height":732,"label":"Filmmaking: Movie Cut 2"}}}],"connections":[{"from":"node-1","to":"node-2"},{"from":"node-2","to":"node-3"},{"from":"node-3","to":"node-4"}]}},{"_key":"canvas-showcase-fashion","label":"Fashion","prompt":"Turn a fabric swatch and croquis into a technical flat and campaign-ready garment images","background":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/fashion/background.webp","width":2880,"height":1624,"alt":"Fashion background"}},"scene":{"width":1020,"media":[{"_key":"fashion-node-1-1","id":"node-1-1","x":54,"y":15,"maxWidth":135,"tag":"Image","title":"Croquis","model":"Ideogram 4","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/fashion/node-1-1.webp","width":660,"height":882,"alt":"Fashion: Croquis"}}},{"_key":"fashion-node-1-2","id":"node-1-2","x":54,"y":285,"maxWidth":135,"tag":"Image","title":"Fabric Swatch","model":"GPT Image 2","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/fashion/node-1-2.webp","width":660,"height":882,"alt":"Fashion: Fabric Swatch"}}},{"_key":"fashion-node-2","id":"node-2","x":280,"y":56,"tag":"Image","title":"Garment Mockup","model":"Nano Banana Pro","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/fashion/node-2.webp","width":786,"height":1101,"alt":"Fashion: Garment Mockup"}}},{"_key":"fashion-node-3","id":"node-3","x":645,"y":56,"tag":"Image","title":"Campaign Garment","model":"Nano Banana Pro","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/fashion/node-3.webp","width":786,"height":1101,"alt":"Fashion: Campaign Garment"}}}],"connections":[{"from":"node-1-1","to":"node-2"},{"from":"node-1-2","to":"node-2"},{"from":"node-2","to":"node-3"}]}},{"_key":"canvas-showcase-branding","label":"Branding","prompt":"Turn icon variations into a selected mark, website mockup, and out-of-home billboard","background":{"type":"video","video":{"src":"/media/pages/home/canvas-showcase/branding/background.webm","width":1920,"height":1080,"label":"Branding background"}},"scene":{"width":1190,"media":[{"_key":"branding-node-1-1","id":"node-1-1","x":40,"y":30,"maxWidth":180,"reducedX":20,"reducedY":20,"tag":"Image","title":"Icon 01","model":"Ideogram 4","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/branding/node-1-1.webp","width":784,"height":784,"alt":"Branding: Icon 01"}}},{"_key":"branding-node-1-2","id":"node-1-2","x":244,"y":30,"maxWidth":180,"reducedX":200,"reducedY":20,"tag":"Image","title":"Icon 02","model":"Ideogram 4","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/branding/node-1-2.webp","width":784,"height":784,"alt":"Branding: Icon 02"}}},{"_key":"branding-node-1-3","id":"node-1-3","x":40,"y":275,"maxWidth":180,"reducedX":20,"reducedY":275,"tag":"Image","title":"Icon 03","model":"Ideogram 4","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/branding/node-1-3.webp","width":784,"height":784,"alt":"Branding: Icon 03"}}},{"_key":"branding-node-1-4","id":"node-1-4","x":244,"y":275,"maxWidth":180,"reducedX":200,"reducedY":275,"tag":"Image","title":"Icon 04","model":"Ideogram 4","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/branding/node-1-4.webp","width":784,"height":784,"alt":"Branding: Icon 04"}}},{"_key":"branding-node-2-1","id":"node-2-1","x":520,"y":15,"maxWidth":190,"reducedX":360,"reducedY":20,"tag":"Image","title":"Selected Mark","model":"Ideogram 4","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/branding/node-2-1.webp","width":1530,"height":1494,"alt":"Branding: Selected Mark"}}},{"_key":"branding-node-2-2","id":"node-2-2","x":520,"y":290,"maxWidth":190,"reducedX":360,"reducedY":300,"tag":"Image","title":"Website Mockup","model":"Nano Banana Pro","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/branding/node-2-2.webp","width":1530,"height":1494,"alt":"Branding: Website Mockup"}}},{"_key":"branding-node-3","id":"node-3","x":810,"y":92,"maxWidth":320,"reducedX":560,"reducedY":154,"tag":"Image","title":"OOH Billboard","model":"Nano Banana Pro","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/branding/node-3.webp","width":1530,"height":1494,"alt":"Branding: OOH Billboard"}}}],"connections":[{"from":"node-1-1","to":"node-1-2"},{"from":"node-1-3","to":"node-1-4"},{"from":"node-1-2","to":"node-2-1"},{"from":"node-1-4","to":"node-2-2"},{"from":"node-2-1","to":"node-3"},{"from":"node-2-2","to":"node-3"}]}}]},"faq":{"_key":"home-faq","menuLabel":"FAQ","menuSlug":{"current":"faq"},"title":"Frequently asked questions","items":[{"_key":"home-faq-what-is-melius","question":"What is Melius?","answer":[{"_type":"block","_key":"pt2","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"pt1","text":"Melius is a node-based creative canvas for AI image, video, and audio. Every prompt, image, video, and audio clip is a node on an infinite canvas, and edges connect them so one node's output feeds the next. That's how you build a multi-step pipeline like reference image to image to video to voiceover to final cut. Describe what you want and the Mel agent wires the nodes, picks the right model for each, and leaves every prompt editable so you can rewire or re-run any step.","marks":[]}]}]},{"_key":"home-faq-node-based-canvas","question":"What is a node-based AI canvas?","answer":[{"_type":"block","_key":"pt4","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"pt3","text":"A node-based canvas represents creative work as a graph instead of a chat thread. Every step is a node with its own model, settings, and version history: a prompt, a generated image, a video, an audio track, an uploaded reference. Edges pass output from one node into the next. Because the whole pipeline is visible, you can change an early step and re-run everything downstream, branch to compare variations side by side, and reuse a working graph as a template. On Melius, that graph is also what the Mel agent and external agents connected over MCP read and edit.","marks":[]}]}]},{"_key":"home-faq-best-canvas-for","question":"What kind of work is the Melius canvas best for?","answer":[{"_type":"block","_key":"pt6","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"pt5","text":"Anything that takes more than one generation to get right. Video production teams storyboard, generate shots on parallel branches, and assemble takes in the built-in multi-track editor. Advertising and campaign teams build a graph per concept, then fan the approved one out to every placement and aspect ratio. E-commerce teams reuse one product photo as a reference node across lifestyle scenes and crops. Brand and design teams pin assets, fonts, and references as nodes so downstream generations stay on-brand, and agencies share canvases so feedback lands on a specific node rather than a finished file.","marks":[]}]}]},{"_key":"home-faq-how-video-works","question":"How does AI video generation work on Melius?","answer":[{"_type":"block","_key":"pt8","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"pt7","text":"You start from a text prompt or an existing image, choose a video model or let Mel pick one, and Melius generates the clip. You can guide it with reference images, first and last frames, or input footage, then trim and assemble clips in the built-in video editor.","marks":[]}]}]},{"_key":"home-faq-is-free","question":"Is Melius free?","answer":[{"_type":"block","_key":"pt10","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"pt9","text":"You can create a Melius account for free, but generating images, video, or audio uses credits â€” and the only way to get credits is a paid plan or a one-time credit purchase. So it's free to sign up and explore, and you pay only for what you generate. Paid plans start at $18 per month.","marks":[]}]}]},{"_key":"home-faq-models","question":"What AI models does Melius support?","answer":[{"_type":"block","_key":"pt12","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"pt11","text":"Melius gives you access to a library of leading AI models for image, video, audio, and text. That includes image models like Nano Banana, GPT Image, Flux, Seedream, and Ideogram; video models like Seedance, Veo, Sora, and Kling; and audio and voice models like ElevenLabs, from providers including OpenAI, Google, ByteDance, and Black Forest Labs. The Mel agent can choose the best model for your prompt automatically, or you can pick one yourself.","marks":[]}]}]},{"_key":"home-faq-ownership","question":"Who owns the content I create, and can I use it commercially?","answer":[{"_type":"block","_key":"pt14","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"pt13","text":"You own the content you create on Melius and can use, publish, and distribute it commercially, subject to the underlying model providers' terms. Melius doesn't claim ownership of your work and doesn't use it to train AI models.","marks":[]}]}]},{"_key":"home-faq-vs-single-tool","question":"How is Melius different from single-model tools like Midjourney?","answer":[{"_type":"block","_key":"pt16","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"pt15","text":"A single-model tool gives you one model and one output at a time, with no record of how you got there. Melius is a node-based canvas: one subscription covers many models across image, video, and audio, and the graph keeps every step connected, editable, and re-runnable. You can swap the model on a single node, branch to compare two directions, and reuse the whole workflow as a template, instead of juggling several separate tools and rebuilding the process from scratch each time.","marks":[]}]}]}]},"footer":{"newsletterTitle":"Don't miss out","newsletterDescription":"Enter your email for news and updates","newsletter":{"id":"footer-newsletter","submit":"Subscribe","successMsg":"Thanks for subscribing!","errorMsg":"Something went wrong. Please try again."},"linkColumns":[{"title":"Product","links":[{"label":"Web app","url":"https://app.melius.com/","isNewTab":true},{"label":"Desktop app","url":"/desktop-app","isNewTab":false},{"label":"Pricing","url":"/pricing","isNewTab":false},{"label":"Models","url":"/models","isNewTab":false},{"label":"Enterprise","url":"/enterprise","isNewTab":false},{"label":"Docs","url":"https://docs.melius.com/","isNewTab":true},{"label":"MCP","url":"https://docs.melius.com/mcp/overview","isNewTab":true}]},{"title":"Company","links":[{"label":"About","url":"/about","isNewTab":false},{"label":"Blog","url":"/blog","isNewTab":false},{"label":"Manifesto","url":"/manifesto"},{"label":"Brand","url":"/brand","isNewTab":false},{"label":"Contact","url":"/contact","isNewTab":false},{"label":"Careers","url":"https://jobs.ashbyhq.com/melius","isNewTab":true}]},{"title":"Community","links":[{"label":"X","url":"https://x.com/trymelius","isNewTab":true},{"label":"LinkedIn","url":"https://www.linkedin.com/company/meliusai/","isNewTab":true},{"label":"Instagram","url":"https://www.instagram.com/trymelius","isNewTab":true},{"label":"Discord","url":"https://discord.gg/hkvwjteArP","isNewTab":true}]}],"legalLinks":[{"label":"Terms of Service","url":"/terms","isNewTab":false},{"label":"Privacy Policy","url":"/privacy","isNewTab":false}],"copyright":"Â© 2026 Melius AI, Inc.","easterEgg":{"enableEasterEgg":true,"easterEggImages":[{"_type":"localImage","src":"/media/layout/footer/easter-egg-01.webp","width":670,"height":670,"alt":""},{"_type":"localImage","src":"/media/layout/footer/easter-egg-02.webp","width":670,"height":670,"alt":""},{"_type":"localImage","src":"/media/layout/footer/easter-egg-03.webp","width":670,"height":670,"alt":""},{"_type":"localImage","src":"/media/layout/footer/easter-egg-04.webp","width":670,"height":930,"alt":""},{"_type":"localImage","src":"/media/layout/footer/easter-egg-05.webp","width":670,"height":670,"alt":""},{"_type":"localImage","src":"/media