3:["$","$L16",null,{"data":{"header":{"signInLink":{"url":"https://app.melius.com/login","label":"Sign In","isNewTab":false},"startFreeLink":{"url":"https://app.melius.com/signup","label":"Start for Free","isNewTab":false}},"hero":{"title":{"prefix":"Create any","words":["image","audio","video","campaign","movie"],"suffix":"you imagine","accessibleTitle":"Create anything you imagine"},"description":"AI agents for creative work.\nBring your creative vision and collaborate with AI agents until the images, video, and audio land exactly as you imagined.","menuSlug":{"current":"hero"},"animation":{"images":[{"asset":{"_ref":"image-hero1-670x670-webp"},"src":"/images/hero/hero-1.webp"},{"asset":{"_ref":"image-hero2-670x670-webp"},"src":"/images/hero/hero-2.webp"},{"asset":{"_ref":"image-hero3-670x670-webp"},"src":"/images/hero/hero-3.webp"},{"asset":{"_ref":"image-hero4-670x670-webp"},"src":"/images/hero/hero-4.webp"},{"asset":{"_ref":"image-hero5-670x670-webp"},"src":"/images/hero/hero-5.webp"},{"asset":{"_ref":"image-hero6-670x670-webp"},"src":"/images/hero/hero-6.webp"},{"asset":{"_ref":"image-hero7-670x670-webp"},"src":"/images/hero/hero-7.webp"},{"asset":{"_ref":"image-hero8-670x670-webp"},"src":"/images/hero/hero-8.webp"},{"asset":{"_ref":"image-hero9-670x670-webp"},"src":"/images/hero/hero-9.webp"},{"asset":{"_ref":"image-hero10-670x670-webp"},"src":"/images/hero/hero-10.webp"},{"asset":{"_ref":"image-hero11-670x670-webp"},"src":"/images/hero/hero-11.webp"},{"asset":{"_ref":"image-hero12-670x670-webp"},"src":"/images/hero/hero-12.webp"},{"asset":{"_ref":"image-hero13-670x670-webp"},"src":"/images/hero/hero-13.webp"},{"asset":{"_ref":"image-hero14-670x670-webp"},"src":"/images/hero/hero-14.webp"},{"asset":{"_ref":"image-hero15-670x670-webp"},"src":"/images/hero/hero-15.webp"},{"asset":{"_ref":"image-hero16-670x670-webp"},"src":"/images/hero/hero-16.webp"},{"asset":{"_ref":"image-hero17-670x670-webp"},"src":"/images/hero/hero-17.webp"},{"asset":{"_ref":"image-hero18-