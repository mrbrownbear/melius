afternoon on the canvas. Pack shots, on-model, hero imagery, all brand-consistent across every frame, at the pace of your ambitions.","image":{"asset":{"_ref":"image-ecommerce-1024x1024-webp"},"src":"/images/personas/ecommerce.webp"},"useCases":[{"useCaseTitle":"Pack Shots","useCaseImage":{"asset":{"_ref":"image-packshots-1024x1024-webp"},"src":"/images/use-cases/pack-shots.webp"},"models":[{"vendor":"GOOGLE","items":["Nano Banana"]}]},{"useCaseTitle":"On-Model Imagery","useCaseImage":{"asset":{"_ref":"image-onmodelimagery-1024x1024-webp"},"src":"/images/use-cases/on-model-imagery.webp"},"models":[{"vendor":"BLACK FOREST LABS","items":["FLUX 1.1","FLUX Kontext"]}]},{"useCaseTitle":"Lifestyle Heroes","useCaseImage":{"asset":{"_ref":"image-lifestyleheroes-1024x1024-webp"},"src":"/images/use-cases/lifestyle-heroes.webp"},"models":[{"vendor":"GOOGLE","items":["Nano Banana"]}]},{"useCaseTitle":"PDP Variants","useCaseImage":{"asset":{"_ref":"image-pdpvariants-1024x1024-webp"},"src":"/images/use-cases/pdp-variants.webp"},"models":[{"vendor":"TOPAZ LABS","items":["Gigapixel"]}]}]},{"_key":"gtm-growth","name":"GTM / Growth","slug":"gtm-growth","title":"GTM / Growth","description":"Skip the design ticket. Event graphics, blog heroes, conference posters, decks that don't look like they were made in five minutes â€” all on the fly, without learning a single tool or writing a single prompt.","image":{"asset":{"_ref":"image-gtmgrowth-1024x1024-webp"},"src":"/images/personas/gtm-growth.webp"},"useCases":[{"useCaseTitle":"Event Graphics","useCaseImage":{"asset":{"_ref":"image-eventgraphics-1024x1024-webp"},"src":"/images/use-cases/event-graphics.webp"},"models":[{"vendor":"GOOGLE","items":["Nano Banana"]}]},{"useCaseTitle":"Conference Posters","useCaseImage":{"asset":{"_ref":"image-conferenceposters-1024x1024-webp"},"src":"/images/use-cases/conference-posters.webp"},"models":[{"vendor":"BLACK FOREST LABS","items":["FLUX 1.1"]}]},{"useCaseTitle":"Sales Decks","useCaseImage":{"asset"