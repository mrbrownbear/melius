edits/mo","tokenDescription":"â‰ˆ 1,775 images or 70 videos"}],"features":["Everything in Growth","Up to 8 seats","Up to 10 agent skills","Slack agent access","Search with AI","AI prompt enhancement","Better fonts","And more..."],"cta":{"ctaLabel":"Start with Professional","ctaColor":"gradient"},"decoration":"indentCoin","size":"default"},{"_key":"enterprise","name":"Enterprise","description":"For higher limits","options":[{"id":"enterprise_custom","listPrice":null,"monthlyPrice":null,"annualPrice":null,"monthlyCredits":"Custom","tokenTitle":"Custom credits"}],"features":["Everything in Professional","Unlimited seats","Priority queue access","Real-time support","Unlimited agent skills","Dedicated Slack channel","Volume discounts","And more..."],"cta":{"ctaLabel":"Contact Sales","ctaLink":"/book-intro","ctaColor":"black"},"decoration":"indentCoin","size":"wide"}]},"canvasShowcase":{"anchorId":"canvas","link":{"label":"Start for Free","url":"https://app.melius.com/signup","isNewTab":true},"categories":[{"_key":"canvas-showcase-advertising","label":"Advertising","prompt":"Create a Mel energy drink campaign from product packaging and a studio-shot reference","background":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/advertising/background.webp","width":2752,"height":1536,"alt":"Advertising background"}},"scene":{"width":1100,"media":[{"_key":"advertising-node-1","id":"node-1","x":64,"y":150,"maxWidth":300,"tag":"Image","title":"Product Mockup","model":"GPT Image 2","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/advertising/node-1.webp","width":750,"height":750,"alt":"Advertising: Product Mockup"}}},{"_key":"advertising-node-2-image","id":"node-2-image","x":460,"y":266,"maxWidth":220,"tag":"Image","title":"Studio Shot","model":"Nano Banana Pro","media":{"type":"image","image":{"_type":"localImage","src":"/media/pages/home/canvas-showcase/advertising/node-2.webp","width":750,"height":