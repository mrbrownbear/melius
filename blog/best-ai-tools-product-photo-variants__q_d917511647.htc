assName":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2118",{"children":["Pack shot, product page specs, logo node"]}]]}],["$","td","b21093",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2121",{"children":["Canvas duplication and upload swap"]}]]}],["$","td","b21094",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2124",{"children":["Magic Resize, re-composes per ratio"]}]]}]]}],["$","tr","b2125",{"className":"border-t border-black/10","children":[["$","td","b21250",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2128",{"children":["Flair"]}]]}],["$","td","b21251",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2131",{"children":["Drag-and-drop staging canvas"]}]]}],["$","td","b21252",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2134",{"children":["Pack shot, props, on-model"]}]]}],["$","td","b21253",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2137",{"children":["Yes"]}]]}],["$","td","b21254",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2140",{"children":["Not a headline feature"]}]]}]]}],["$","tr","b2141",{"className":"border-t border-black/10","children":[["$","td","b21410",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2144",{"children":["Cuttable"]}]]}],["$","td","b21411",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2147",{"children":["Ad production system"]}]]}],["$","td","b21412",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2150",{"children":["Brand-trained on your assets"]}]]}],["$","td","b21413",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":"$L60"}],"$L61"]}],"$L62","$L63"]}]}]}]
22:["$","h2","b2190",{"id":"1-melius","className":"scroll-mt-28","children":["1. Melius"]}]
23:["$","p","b2192",{"children":["Melius is an agentic platform for creative work: a node-based creative canvas that AI agents drive. Each prompt, uploaded image and result is a node, and edges pass one node's output into the next, so a variant pipeline sits in front of you as a graph you can rewire."]}]
24:["$","p","b2194",{"children":["For product work, the fidelity story is the reason to use it. You drop your pack shot on as a file node, and if you've got several angles you group them so the agent references all of them."]}]
25:["$","p","b2196",{"children":["Paste the product page URL into the chat and Mel, the Melius agent, scrapes it into a text node holding your real dimensions, materials and color codes. Your logo goes on as its own node with an instruction not to redraw it."]}]
26:["$","p","b2198",{"children":["Those three inputs do the work. The failure mode that comes without them: given only a single photo, the model has to guess at the proportions."]}]
27:["$","h3","b2200",{"children":["What it does well"]}]
28:["$","ul","b2202-parent",{"children":[["$","li","b2202",{"children":["Splits models by job. Nano Banana Pro carries material, fabric, food and editorial lighting; GPT Image 2 renders type that stays legible on packaging."]}],["$","li","b2204",{"children":["Ships a Product Swapper template that pre-wires the whole place-my-product-in-this-scene flow, plus Product In Hand Ad and Product 360 Video Generator for adjacent jobs"]}],["$","li","b2206",{"children":["Magic Resize regenerates a finished image into every ratio you pick, re-composing the frame instead of trimming it"]}],["$","li","b2208",{"children":["Turns one dialed-in SKU into a repeatable process: swap the file on an upload node and everything downstream re-runs on the new product"]}],["$","li","b2213",{"children":["Runs every model from ",["$","$L64","b2211",{"link":{"_type":"link","_key":"b2210","href":"/blog/one-subscription-every-model","isNewTab":false},"children":["one subscription"]}]," and one credit pool"]}]]}]
29:["$","h3","b2215",{"children":["Which model for which job"]}]
2a:["$","div","b2216",{"role":"region","aria-label":"Comparison table, scroll horizontally to see all columns","tabIndex":0,"data-lenis-prevent":true,"className":"my-10 max-w-full overflow-x-auto rounded-2xl border border-black/10 bg-white shadow-[0_1px_2px_rgba(0,0,0,0.04)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange","children":["$","table",null,{"className":"w-full min-w-[640px] border-collapse text-left","children":["$","tbody",null,{"children":[["$","tr","b2217",{"className":"bg-black/[0.04]","children":[["$","td","b22170",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-gray-dark-1 px-4 py-3 font-medium","children":[["$","p","b2220",{"children":[["$","strong","b2219",{"children":["Model"]}]]}]]}],["$","td","b22171",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-gray-dark-1 px-4 py-3 font-medium","children":[["$","p","b2223",{"children":[["$","strong","b2222",{"children":["Best for"]}]]}]]}]]}],["$","tr","b2224",{"className":"border-t border-black/10","children":[["$","td","b22240",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2227",{"children":["Nano Banana Pro, by Google"]}]]}],["$","td","b22241",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2230",{"children":["Material, fabric, food, skin tone, editorial lighting"]}]]}]]}],["$","tr","b2231",{"className":"border-t border-black/10","children":[["$","td","b22310",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2234",{"children":["GPT Image 2, by OpenAI"]}]]}],["$","td","b22311",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2237",{"children":["Legible type on packaging, labels and on-image copy"]}]]}]]}],["$","tr","b2238",{"className":"border-t border-black/10","children":[["$","td","b22380",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2241",{"children":["Nano Banana 2, by Google"]}]]}],["$","td","b22381",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2244",{"children":["Fast exploration before committing to a direction"]}]]}]]}]]}]}]}]
2b:["$","p","b2249",{"children":["The ",["$","$L64","b2247",{"link":{"_type":"link","_key":"b2246","href":"/blog/nano-banana-image-models","isNewTab":false},"children":["differences between the Nano Banana models"]}]," matter more here than they do on a one-off image, because a variant set lives or dies on consistency across the whole batch."]}]
2c:["$","p","b2251",{"children":["The qualifier is real setup cost. You're building a graph, and on the first product that's slower than uploading a pack shot to a tool with a single button."]}]
2d:["$","p","b2253",{"children":["It pays back on the second SKU. Melius also doesn't publish directly to Meta or TikTok, so if you want creative that goes straight from generation to a live ad set, that handoff stays manual."]}]
2e:["$","p","b2259",{"children":[["$","strong","b2254",{"children":["Best for: "]}],"teams producing variants across many SKUs who need the product itself to stay accurate, and who want generating, editing and resizing on one surface. ",["$","$L64","b2257",{"link":{"_type":"link","_key":"b2256","href":"/pricing","isNewTab":false},"children":["See pricing"]}]," for plans and credits."]}]
2f:["$","h2","b2261",{"id":"2-flair","className":"scroll-mt-28","children":["2. Flair"]}]
30:["$","p","b2263",{"children":["Flair is the closest thing here to a purpose-built e-commerce studio. You stage a scene on a drag-and-drop canvas, position props and your product, then run an AI pass to finish the image, which is a more direct mental model than a node graph if product photography is the only job you have."]}]
31:["$","h3","b2265",{"children":["What it does well"]}]
32:["$","ul","b2267-parent",{"children":[["$","li","b2267",{"children":["Digital scene staging with drag-and-drop props, which makes composition tangible"]}],["$","li","b2269",{"children":["On-model fashion photography that preserves garment patterns"]}],["$","li","b2271",{"children":["A custom AI human model builder for brands that need consistent models"]}],["$","li","b2273",{"children":["Background regeneration and editing tools, plus an API for teams wiring it into a pipeline"]}]]}]
33:["$","p","b2275",{"children":["Flair is narrower by design. It's built around product and on-model imagery, so there's no video, audio or wider content pipeline in the same place, and no agent building the work for you. On staging a product scene it's a fair fight."]}]
34:["$","p","b2278",{"children":[["$","strong","b2276",{"children":["Best for: "]}],"e-commerce and fashion teams who want a tool shaped entirely around product and on-model imagery."]}]
35:["$","h2","b2280",{"id":"3-cuttable","className":"scroll-mt-28","children":["3. Cuttable"]}]
36:["$","p","b2282",{"children":["Cuttable isn't an image tool so much as an ad production system, and that reframing is the point. It learns your brand from your assets and customer research, generates ad variations, then publishes to Meta and TikTok and tracks which ones worked."]}]
37:["$","h3","b2284",{"children":["What it does well"]}]
38:["$","ul","b2286-parent",{"children":[["$","li","b2286",{"children":["Batch ad generation from product imagery and video you already have"]}],["$","li","b2288",{"children":["Brand-trained asset creation that holds visual consistency across a set"]}],["$","li","b2290",{"children":["Direct publishing to Meta and TikTok with automatic resizing"]}],["$","li","b2292",{"children":["Performance data fed back in, so the next batch is informed by the last one"]}]]}]
39:["$","p","b2294",{"children":["Its own framing is that campaign success runs on volume and variation, and it pitches moving a team from five tested ads a week to twenty. That's the right tool if paid social is where your creative lives. It's the wrong one if you need catalog imagery, packaging renders or anything that isn't an ad, and it's aimed at mid-to-large brands with real ad spend rather than a solo operator."]}]
3a:["$","p","b2297",{"children":[["$","strong","b2295",{"children":["Best for: "]}],"performance marketing teams whose output is paid social creative and who want the publish-and-measure loop closed."]}]
3b:["$","h2","b2299",{"id":"4-pencil","className":"scroll-mt-28","children":["4. Pencil"]}]
3c:["$","p","b2301",{"children":["Pencil is built for enterprise teams, and it's honest about that. It describes itself as an AI operating system for marketing teams, pulling models from OpenAI, Google, Adobe, Runway and Bria into one interface with governance wrapped around them."]}]
3d:["$","h3","b2303",{"children":["What it does well"]}]
3e:["$","ul","b2305-parent",{"children":[["$","li","b2305",{"children":["One editor where you generate, edit and finish an ad without leaving"]}],["$","li","b2307",{"children":["Brand-safe agents coordinating work across 24 markets at once, with role-based access and regional compliance options for the EU, US and APAC"]}],["$","li","b2309",{"children":["Procurement-grade credentials: SOC 2 Type II, IP indemnification, a no-train data policy and granular permissions"]}],["$","li","b2311",{"children":["Named clients including Experian, Diageo, L'Oreal, Japan Airlines and Barilla"]}]]}]
3f:["$","p","b2313",{"children":["All of that governance is weight. If you're a five-person brand team, the compliance apparatus is cost without benefit, and enterprise procurement is a months-long motion rather than a signup. Pencil publishes return-on-ad-spend and cost-reduction figures from its own case studies, which are worth reading as vendor claims rather than benchmarks."]}]
40:["$","p","b2316",{"children":[["$","strong","b2314",{"children":["Best for: "]}],"large marketing organizations and agencies running multi-market creative where governance and indemnification are purchase requirements."]}]
41:["$","h2","b2318",{"id":"5-creatify","className":"scroll-mt-28","children":["5. Creatify"]}]
42:["$","p","b2320",{"children":["Creatify is video-first, which makes it the odd one out here in a useful way. Its pitch is AI video ads at the scale your business needs, from ten a month to ten thousand, and it reaches static product imagery through a Product Ads feature that produces studio-quality shots and animations."]}]
43:["$","h3","b2322",{"children":["What it does well"]}]
44:["$","ul","b2324-parent",{"children":[["$","li","b2324",{"children":["URL-to-video, turning a product page straight into a finished ad"]}],["$","li","b2326",{"children":["Batch generation of up to 50 video variants in one run"]}],["$","li","b2328",{"children":["Several entry points into the same job: an agent, an ad flow, a URL, or a blank start"]}],["$","li","b2330",{"children":["Integrations with Meta, TikTok, YouTube, Snap and Amazon"]}]]}]
45:["$","p","b2332",{"children":["If your variant problem is mostly motion, this is the most direct route on the list. If it's mostly stills, you're buying a video platform to do a photo job, and the product-imagery half is a feature rather than the core. User-generated-content-style output is a house strength, which suits some brands and reads wrong for others."]}]
46:["$","p","b2335",{"children":[["$","strong","b2333",{"children":["Best for: "]}],"direct-to-consumer teams whose testing budget goes into short-form video and who want static product shots from the same tool."]}]
47:["$","h2","b2337",{"id":"what-a-variant-set-actually-costs-you","className":"scroll-mt-28","children":["What a variant set actually costs you"]}]
48:["$","p","b2339",{"children":["The per-image price is the least interesting number in this comparison. What actually costs money is the second pass."]}]
49:["$","p","b2341",{"children":["Work it through on one SKU. You need a hero shot, three lifestyle scenes, and each of those at three aspect ratios, which is twelve assets."]}]
4a:["$","p","b2343",{"children":["Generating them is minutes. What eats the afternoon is the near-misses: the shot where the product sits at the wrong scale, the resize that pushed your logo off-canvas, the label that came back unreadable."]}]
4b:["$","p","b2345",{"children":["So the question to ask a tool in a trial isn't how good is the first image. It's how cheap is the correction. On a canvas you edit the node's prompt and re-run that step."]}]
4c:["$","p","b2347",{"children":["In a one-shot generator you start the brief again. Across twelve assets and a few dozen SKUs, that difference dwarfs any per-image rate, which is also why a cheaper generator and a pricier one often land in the same place once the corrections are counted."]}]
4d:["$","h2","b2349",{"id":"producing-variants-on-melius","className":"scroll-mt-28","children":["Producing variants on Melius"]}]
4e:["$","p","b2351",{"children":["Start with the three inputs, not the prompt. A clean pack shot on a file node, the product page URL pasted into the chat so Mel scrapes the real dimensions and materials into a text node, and your logo as its own node with an instruction not to redraw it. Then generate three or four variations at a time and correct the near-misses by editing that step's prompt."]}]
4f:["$","p","b2359",{"children":["Once one image is right, Magic Resize produces each channel ratio by re-composing the frame rather than trimming it, and ",["$","$L64","b2354",{"link":{"_type":"link","_key":"b2353","href":"/blog/best-ai-photo-background-editing-tools","isNewTab":false},"children":["background work stays on the same canvas"]}]," if a scene needs replacing. To run the whole sequence without clicking through it, ",["$","$L64","b2357",{"link":{"_type":"link","_key":"b2356","href":"/blog/connect-ai-agents-canvas-mcp","isNewTab":false},"children":["an agent can drive the canvas over MCP"]}],"."]}]
50:["$","p","b2364",{"children":["If the brief is a branded scene rather than a product shot, the same compositing approach carries over, covered in ",["$","$L64","b2362",{"link":{"_type":"link","_key":"b2361","href":"/blog/ai-brand-mockup-tools-ranked","isNewTab":false},"children":["AI brand mockup tools, ranked"]}],"."]}]
51:["$","p","b2369",{"children":["Try it on one real SKU: drop in a pack shot, paste the product page URL, and see how far the fidelity holds. ",["$","$L64","b2367",{"link":{"_type":"link","_key":"b2366","href":"https://app.melius.com","isNewTab":true},"children":["Open Melius"]}],"."]}]
52:["$","h2","b2371",{"id":"frequently-asked-questions","className":"scroll-mt-28","children":["Frequently asked questions"]}]
53:["$","div","b2372",{"className":"faq-list my-10 flex flex-col divide-y divide-black/10 border-y border-black/10","children":[["$","details","0",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["What is the best AI tool for product photo variants?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"For teams producing variants across many SKUs, Melius, because it anchors every generation on your pack shot, your real product page specs and your logo as separate inputs, then resizes on the same canvas. If your variants are paid social ads, Cuttable closes the publish-and-measure loop and Creatify does the same for video. Flair is the pick if product and on-model imagery is the whole job, and Pencil if procurement requirements decide your tooling."}]]}],["$","details","1",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["How do I stop AI from changing my product?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"Give it three inputs, not one. Upload a clean pack shot rather than a lifestyle photo, so the model can see the product itself. Supply your product page specs so it has real dimensions and materials. Add your logo as its own reference with an instruction not to redraw it. Proportion drift is usually caused by missing inputs, not by weak prompting."}]]}],["$","details","2",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["Can AI keep packaging text legible?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"Yes, but the model decides it. Typography and material fidelity are won by different image models, so pick per job: a style-adherent model for lifestyle and material shots, a typography-strong one when the label has to read. Running both from one subscription is what makes comparing them cheap."}]]}],["$","details","3",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["How many variants should I generate per run?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":"$L65"}]]}],"$L66"]}],"$L67","$L68"]}]
54:["$","section","related",{"className":"relative w-full pb-section bg-gray-background","children":[["$","$L11",null,{"color":"gray"}],["$","div",null,{"className":"relative z-10 mx-auto w-full max-w-300 px-5 lg:px-8","children":[["$","h2",null,{"className":"t-h-2 mb-12 text-center text-balance text-gray-dark-1","children":"Related Articles"}],["$","div",null,{"className":"mx-auto grid w-full max-w-max grid-cols-1 gap-11 md:grid-cols-2 lg:grid-cols-3","children":[["$","$L69","post-best-ai-photo-background-editing-tools",{"post":{"_key":"post-best-ai-photo-background-editing-tools","slug":"best-ai-photo-background-editing-tools","category":"comparisons","title":"Best AI photo background editing tools","isoDate":"2026-08-31","date":"August 31, 2026","readTime":"9 Min Read","excerpt":"Which AI tool should you use to edit photo backgrounds? Five compared on cutout quality, replacing a background convincingly, and finishing the job.","image":{"url":"/images/blog/best-ai-photo-background-editing-tools/cover.webp"},"authors":[{"name":"Alex Chen, Member of Technical Staff"}],"faq":[{"question":"What is the best AI photo background editing tool?","answer":"It depends which of the two jobs you have. For background work that continues into a scene, brand assets and channel variants, Melius keeps those steps on one canvas. For a large catalog, Photoroom is built for that volume. For a single image or a lighting mismatch, Clipdrop. For staging a product scene by hand, Flair. And for a requirement no product covers, ComfyUI."},{"question":"How do I replace a background so it looks real?","answer":"Match the light before the scene. The usual tell is a subject lit from one side dropped into a background lit from the other. Either generate the replacement from a description that specifies the existing light direction, or relight the subject to match. Perspective and horizon height give it away for the same reason."},{"question":"Should I inpaint or regenerate the whole image?","answer":"Inpaint when most of the frame must stay exactly as it is and one region changes. Regenerate when the thing you want gone is spread across the frame, like text, because a full pass with an instruction to recreate the image without it leaves a cleaner result than a mask."},{"question":"Can AI remove a background from hair or glass?","answer":"Partly, and this is still the honest weak point of the whole category. Automated removal is good enough for most product and portrait work and struggles with fine hair against busy backgrounds, glass, water and motion blur. Those cases still want a hand-refined mask."},{"question":"Is free background removal good enough?","answer":"For clean-edged subjects, yes. Free tiers return usable transparent PNGs and several need no account. The limits appear as daily caps, lower output resolution and weaker results on hard edges, so free is a reasonable default you outgrow."},{"question":"Does background editing reduce image quality?","answer":"The edit should not, but the pipeline around it often does. Previews are downscaled, so verify output resolution before exporting, and upscale after the edit rather than before. Repeated re-compression across several tools is where quality actually goes."}],"tableOfContents":[{"_key":"which-ai-tool-should-you-use-to-edit-photo-backgrounds","title":"Which tool"},{"_key":"what-to-know-before-you-pick","title":"Before you pick"},{"_key":"what-separates-a-good-background-tool","title":"What separates them"},{"_key":"the-five-compared","title":"The five compared"},{"_key":"1-melius","title":"1. Melius"},{"_key":"2-photoroom","title":"2. Photoroom"},{"_key":"3-clipdrop","title":"3. Clipdrop"},{"_key":"4-flair","title":"4. Flair"},{"_key":"5-comfyui","title":"5. ComfyUI"},{"_key":"editing-a-background-on-melius","title":"Editing on Melius"},{"_key":"frequently-asked-questions","title":"FAQ"}],"content":[{"_type":"block","_key":"b1779","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1778","text":"Which AI tool should you use to edit photo backgrounds?","marks":[]}],"anchorId":"which-ai-tool-should-you-use-to-edit-photo-backgrounds"},{"_type":"block","_key":"b1781","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1780","text":"Start by deciding which of two jobs you actually have, because they're different problems and the tools that win them are different. Removing a background is a cutout problem, judged on edges: hair, glass, thin straps, anything semi-transparent. Replacing one is a generation problem, judged on whether the light and perspective of the new scene match the subject you dropped in.","marks":[]}]},{"_type":"block","_key":"b1783","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1782","text":"Most people ask for one and need the other. The second most common mistake is buying a per-image utility for a job that repeats a thousand times, or a batch pipeline for a single editorial image.","marks":[]}]},{"_type":"block","_key":"b1785","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1784","text":"What to know before you pick","marks":[]}],"anchorId":"what-to-know-before-you-pick"},{"_type":"block","_key":"b1787","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1786","text":"Removal and replacement are separate problems: judge cutouts on hair and transparency, replacements on whether the light direction matches","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1789","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1788","text":"Masking isn't always right. To clear text or a small object, regenerating the frame with an instruction often beats drawing a mask.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1791","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1790","text":"Previews are downscaled almost everywhere, so check output resolution before you export","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1793","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1792","text":"If the cutout then needs four channel ratios, the tool that does both beats the marginally better cutout","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1795","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1794","text":"What separates a good background tool?","marks":[]}],"anchorId":"what-separates-a-good-background-tool"},{"_type":"block","_key":"b1797","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1796","text":"Four criteria, and the first one eliminates most tools for most professional work.","marks":[]}]},{"_type":"block","_key":"b1799","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b1798","text":"Edge quality on hard subjects","marks":[]}]},{"_type":"block","_key":"b1801","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1800","text":"Every tool handles a clear-edged product. Hair against a busy background, a wine glass, a chain-link fence, motion blur: those separate them. Test your worst image, never your easiest.","marks":[]}]},{"_type":"block","_key":"b1803","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b1802","text":"Light that matches","marks":[]}]},{"_type":"block","_key":"b1805","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1804","text":"The usual giveaway in a replaced background isn't a ragged cutout, it's a subject lit from the left dropped into a scene lit from the right. Either the tool relights the subject or it generates the scene from a description of the existing light.","marks":[]}]},{"_type":"block","_key":"b1807","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b1806","text":"Volume that matches your volume","marks":[]}]},{"_type":"block","_key":"b1809","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1808","text":"A thousand pack shots and one hero image are opposite requirements. Per-image tools and batch pipelines are priced and shaped for one each, and using the wrong one is expensive in either direction.","marks":[]}]},{"_type":"block","_key":"b1811","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b1810","text":"What happens next","marks":[]}]},{"_type":"block","_key":"b1813","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1812","text":"A cutout is rarely the deliverable. It gets composited, resized, branded and shipped. Count those steps when you compare, because a tool that hands back a transparent PNG has finished a third of the work.","marks":[]}]},{"_type":"block","_key":"b1815","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1814","text":"The five compared","marks":[]}],"anchorId":"the-five-compared"},{"_type":"portableTable","_key":"b1816","rows":[{"_key":"b1817","cells":[{"_key":"b1818","text":[{"_type":"block","_key":"b1820","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1819","text":"","marks":["strong"]}]}]},{"_key":"b1821","text":[{"_type":"block","_key":"b1823","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1822","text":"Remove background","marks":["strong"]}]}]},{"_key":"b1824","text":[{"_type":"block","_key":"b1826","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1825","text":"Replace background","marks":["strong"]}]}]},{"_key":"b1827","text":[{"_type":"block","_key":"b1829","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1828","text":"Ease of starting","marks":["strong"]}]}]},{"_key":"b1830","text":[{"_type":"block","_key":"b1832","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1831","text":"Next steps in the same tool","marks":["strong"]}]}]}]},{"_key":"b1833","cells":[{"_key":"b1834","text":[{"_type":"block","_key":"b1836","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1835","text":"Melius","marks":[]}]}]},{"_key":"b1837","text":[{"_type":"block","_key":"b1839","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1838","text":"5/5","marks":[]}]}]},{"_key":"b1840","text":[{"_type":"block","_key":"b1842","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1841","text":"5/5","marks":[]}]}]},{"_key":"b1843","text":[{"_type":"block","_key":"b1845","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1844","text":"Describe it, no setup","marks":[]}]}]},{"_key":"b1846","text":[{"_type":"block","_key":"b1848","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1847","text":"5/5","marks":[]}]}]}]},{"_key":"b1849","cells":[{"_key":"b1850","text":[{"_type":"block","_key":"b1852","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1851","text":"Photoroom","marks":[]}]}]},{"_key":"b1853","text":[{"_type":"block","_key":"b1855","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1854","text":"5/5","marks":[]}]}]},{"_key":"b1856","text":[{"_type":"block","_key":"b1858","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1857","text":"4/5","marks":[]}]}]},{"_key":"b1859","text":[{"_type":"block","_key":"b1861","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1860","text":"One upload","marks":[]}]}]},{"_key":"b1862","text":[{"_type":"block","_key":"b1864","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1863","text":"3/5","marks":[]}]}]}]},{"_key":"b1865","cells":[{"_key":"b1866","text":[{"_type":"block","_key":"b1868","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1867","text":"Clipdrop","marks":[]}]}]},{"_key":"b1869","text":[{"_type":"block","_key":"b1871","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1870","text":"5/5","marks":[]}]}]},{"_key":"b1872","text":[{"_type":"block","_key":"b1874","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1873","text":"4/5","marks":[]}]}]},{"_key":"b1875","text":[{"_type":"block","_key":"b1877","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1876","text":"One upload","marks":[]}]}]},{"_key":"b1878","text":[{"_type":"block","_key":"b1880","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1879","text":"3/5","marks":[]}]}]}]},{"_key":"b1881","cells":[{"_key":"b1882","text":[{"_type":"block","_key":"b1884","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1883","text":"Flair","marks":[]}]}]},{"_key":"b1885","text":[{"_type":"block","_key":"b1887","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1886","text":"2/5","marks":[]}]}]},{"_key":"b1888","text":[{"_type":"block","_key":"b1890","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1889","text":"5/5","marks":[]}]}]},{"_key":"b1891","text":[{"_type":"block","_key":"b1893","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1892","text":"Arrange it yourself","marks":[]}]}]},{"_key":"b1894","text":[{"_type":"block","_key":"b1896","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1895","text":"3/5","marks":[]}]}]}]},{"_key":"b1897","cells":[{"_key":"b1898","text":[{"_type":"block","_key":"b1900","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1899","text":"ComfyUI","marks":[]}]}]},{"_key":"b1901","text":[{"_type":"block","_key":"b1903","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1902","text":"3/5","marks":[]}]}]},{"_key":"b1904","text":[{"_type":"block","_key":"b1906","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1905","text":"3/5","marks":[]}]}]},{"_key":"b1907","text":[{"_type":"block","_key":"b1909","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1908","text":"Highest entry barrier","marks":[]}]}]},{"_key":"b1910","text":[{"_type":"block","_key":"b1912","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1911","text":"5/5 if you can build them","marks":[]}]}]}]}]},{"_type":"block","_key":"b1914","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1913","text":"1. Melius","marks":[]}],"anchorId":"1-melius"},{"_type":"block","_key":"b1916","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1915","text":"Melius, the Agentic OS for creative work, is a node-based creative canvas that AI agents operate alongside you. Background editing isn't a separate mode: every image node carries its own editing tools, so the edit happens where the image already lives.","marks":[]}]},{"_type":"block","_key":"b1918","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1917","text":"Melius has three built-in tools that cover most of the work. Remove Background outputs a transparent PNG. Inpaint lets you mask a region and describe what fills it, which is right when most of the frame must stay untouched. Upscale raises resolution afterward if you drafted low.","marks":[]}]},{"_type":"block","_key":"b1920","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b1919","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b1922","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1921","text":"Ships a Background Generator template for producing different backgrounds for a product, and Portrait Mode for a blurred-background look","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1924","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1923","text":"Handles the counter-intuitive case properly: to clear text from an image, regenerating the frame with an instruction to recreate it without the text usually beats masking, because a mask leaves you fighting the seam","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1926","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1925","text":"A cutout stays a node, so it feeds straight into a generated scene, picks up your logo as a separate reference, and runs through Magic Resize for every ratio you ship","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1931","style":"normal","markDefs":[{"_type":"link","_key":"b1928","href":"/blog/one-subscription-every-model","isNewTab":false}],"children":[{"_type":"span","_key":"b1927","text":"Model choice per step comes from ","marks":[]},{"_type":"span","_key":"b1929","text":"one subscription","marks":["b1928"]},{"_type":"span","_key":"b1930","text":" across the library of leading models, so the model that renders a convincing scene isn't a separate purchase from the one handling fine edges","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1933","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1932","text":"Two qualifiers. There's no dedicated relight control, so matching light means specifying it in the prompt or picking the model that handles it best, which is less direct than a slider. And a canvas is more tool than a single cutout needs: if you want one transparent PNG in ten seconds, opening a canvas is the slow route.","marks":[]}]},{"_type":"block","_key":"b1936","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1934","text":"Best for: ","marks":["strong"]},{"_type":"span","_key":"b1935","text":"background work that's one step inside a larger piece of creative, and teams who want the cutout, the new scene and the channel variants in one place.","marks":[]}]},{"_type":"block","_key":"b1938","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1937","text":"2. Photoroom","marks":[]}],"anchorId":"2-photoroom"},{"_type":"block","_key":"b1940","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1939","text":"Photoroom is the volume answer, and background removal is one of its better use cases. Bulk background removal and batch editing are core, so a catalog goes through it as a queue.","marks":[]}]},{"_type":"block","_key":"b1942","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1941","text":"Plans are metered in AI credits and monthly exports, which lets you size a plan against how many product images you actually process, and there's an API for teams putting it inside their own pipeline.","marks":[]}]},{"_type":"block","_key":"b1944","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b1943","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b1946","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1945","text":"Bulk background removal, so a thousand pack shots is a job rather than a thousand jobs","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1948","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1947","text":"Batch editing across a set, holding the same treatment on every image","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1950","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1949","text":"Credit and export tiers you can match to real catalog volume","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1952","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1951","text":"An API for wiring it into an existing product pipeline","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1954","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1953","text":"It aims squarely at product and listing imagery, and reviewers report its effectiveness is limited beyond that scope. If the job is one editorial image where the background has to be invented and art-directed, this is the wrong shape, and there is no canvas here for composing a scene from references.","marks":[]}]},{"_type":"block","_key":"b1957","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1955","text":"Best for: ","marks":["strong"]},{"_type":"span","_key":"b1956","text":"catalogs, marketplace listings, and any case where the same background treatment is being run without a need for flexibility.","marks":[]}]},{"_type":"block","_key":"b1959","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1958","text":"3. Clipdrop","marks":[]}],"anchorId":"3-clipdrop"},{"_type":"block","_key":"b1961","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1960","text":"Clipdrop is an effective utility here, and its structure is why. It's eight separate tools, not a workflow: background removal, replace background, cleanup, uncrop, relight, text remover, upscale and text to image. You open the one you need and you're done.","marks":[]}]},{"_type":"block","_key":"b1963","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1962","text":"Relight deserves singling out, because mismatched lighting is the usual reason a replaced background looks wrong and few tools address it directly.","marks":[]}]},{"_type":"block","_key":"b1965","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b1964","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b1967","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1966","text":"Background removal and replace background as two distinct tools, so you pick the job","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1969","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1968","text":"Relight, which fixes the tell that gives most composites away","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1971","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1970","text":"Cleanup, uncrop and text remover for the small repairs a cutout usually needs","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1973","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1972","text":"A real free tier with a daily cap per tool, and a paid tier that raises both the cap and the upscale ceiling","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1975","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1974","text":"There's no brand memory and no batch, so it stays a per-image tool. That's fine for a handful of images and wrong for a catalog, and it means nothing you do in one session informs the next.","marks":[]}]},{"_type":"block","_key":"b1978","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1976","text":"Best for: ","marks":["strong"]},{"_type":"span","_key":"b1977","text":"single images and quick repairs.","marks":[]}]},{"_type":"block","_key":"b1980","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1979","text":"4. Flair","marks":[]}],"anchorId":"4-flair"},{"_type":"block","_key":"b1982","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1981","text":"Flair is the tactile option here. You stage a scene on a drag-and-drop canvas, arranging props around your product, then run an AI pass to finish it, which makes background composition something you position rather than something you describe.","marks":[]}]},{"_type":"block","_key":"b1984","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b1983","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b1986","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1985","text":"Digital scene staging with drag-and-drop props, so you control where things sit","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1988","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1987","text":"Background regeneration alongside general image editing","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1990","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1989","text":"On-model fashion photography with pattern preservation","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1992","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1991","text":"A custom AI human model builder, plus an API and team collaboration","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b1994","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1993","text":"Flair is built for e-commerce and it stays there. There's no video, audio or wider content pipeline in the same place, and no agent assembling the work, so you're doing the staging. For product backgrounds specifically that hands-on quality is a strength, and for a portrait or an editorial image it's the wrong shape.","marks":[]}]},{"_type":"block","_key":"b1997","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1995","text":"Best for: ","marks":["strong"]},{"_type":"span","_key":"b1996","text":"e-commerce and fashion teams who want to do hands-on work arranging a product scene.","marks":[]}]},{"_type":"block","_key":"b1999","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1998","text":"5. ComfyUI","marks":[]}],"anchorId":"5-comfyui"},{"_type":"block","_key":"b2001","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b2000","text":"ComfyUI is the choice when nothing off the shelf does what you need. It's an open-source node-based interface where you build the pipeline yourself, so any masking, matting or compositing approach that exists can be assembled at the precision you want.","marks":[]}]},{"_type":"block","_key":"b2003","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b2002","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b2005","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b2004","text":"Control over matting, masking and compositing","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b2007","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b2006","text":"Free and open source, with a desktop build for self-hosting and a managed cloud that has a free tier to start on","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b2009","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b2008","text":"Scriptable, so genuine batch processing is achievable","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b2011","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b2010","text":"A large community-built ecosystem of custom nodes and shareable workflows","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b2013","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b2012","text":"You pay in time and expertise. Setup, model management and debugging are yours, with no support line when a workflow breaks.","marks":[]}]},{"_type":"block","_key":"b2016","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b2014","text":"Best for: ","marks":["strong"]},{"_type":"span","_key":"b2015","text":"technical users with a specific pipeline requirement no product covers.","marks":[]}]},{"_type":"block","_key":"b2018","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b2017","text":"Editing a background on Melius","marks":[]}],"anchorId":"editing-a-background-on-melius"},{"_type":"block","_key":"b2020","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b2019","text":"Decide first whether you're removing or replacing, because they're different nodes. Remove Background returns a transparent PNG for a clean cutout. The Background Generator template builds a new scene around the subject, and the thing to watch there is light direction: a subject lit from one side dropped into a scene lit from the other is the tell.","marks":[]}]},{"_type":"block","_key":"b2025","style":"normal","markDefs":[{"_type":"link","_key":"b2022","href":"/blog/connect-ai-agents-canvas-mcp","isNewTab":false}],"children":[{"_type":"span","_key":"b2021","text":"For a small object or stray text in the frame, the docs point the other way from instinct: regenerating the region with an instruction usually beats drawing a mask. Inpaint is for when most of the frame has to stay exactly as it is. Once the image is right, Magic Resize produces each channel ratio by re-composing rather than trimming, and the Studio node handles layered text on top. If you'd rather hand the whole sequence over, ","marks":[]},{"_type":"span","_key":"b2023","text":"an agent can drive the canvas over MCP","marks":["b2022"]},{"_type":"span","_key":"b2024","text":" and run the steps for you.","marks":[]}]},{"_type":"block","_key":"b2027","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b2026","text":"Hair, glass and other semi-transparent edges remain the category's weak point. Test your hardest image before you commit to a pipeline.","marks":[]}]},{"_type":"block","_key":"b2032","style":"normal","markDefs":[{"_type":"link","_key":"b2029","href":"/blog/turn-picture-into-professional-headshot-tools-ranked","isNewTab":false}],"children":[{"_type":"span","_key":"b2028","text":"If the subject is a person rather than a product, the next decision is whether the portrait can stay recognizable and consistent across a team: see ","marks":[]},{"_type":"span","_key":"b2030","text":"tools to turn a picture into a professional headshot","marks":["b2029"]},{"_type":"span","_key":"b2031","text":".","marks":[]}]},{"_type":"block","_key":"b2037","style":"normal","markDefs":[{"_type":"link","_key":"b2034","href":"/blog/best-ai-tools-turn-images-into-painting","isNewTab":false}],"children":[{"_type":"span","_key":"b2033","text":"If the new background is meant to be painted rather than photographic, the tools that handle a painterly pass are a different set: see ","marks":[]},{"_type":"span","_key":"b2035","text":"the best AI tools to turn images into a painting","marks":["b2034"]},{"_type":"span","_key":"b2036","text":".","marks":[]}]},{"_type":"block","_key":"b2042","style":"normal","markDefs":[{"_type":"link","_key":"b2039","href":"/blog/best-ai-tools-product-photo-variants","isNewTab":false}],"children":[{"_type":"span","_key":"b2038","text":"If the background is one step inside a larger product job, the wider question is which tool holds the product itself steady across a set: see ","marks":[]},{"_type":"span","_key":"b2040","text":"the best AI tools for producing product photo variants","marks":["b2039"]},{"_type":"span","_key":"b2041","text":".","marks":[]}]},{"_type":"block","_key":"b2050","style":"normal","markDefs":[{"_type":"link","_key":"b2044","href":"/pricing","isNewTab":false},{"_type":"link","_key":"b2047","href":"https://app.melius.com","isNewTab":true}],"children":[{"_type":"span","_key":"b2043","text":"Credits are shared across every model and every step, so a cutout, a generated scene and five channel ratios draw from the same balance. ","marks":[]},{"_type":"span","_key":"b2045","text":"See pricing","marks":["b2044"]},{"_type":"span","_key":"b2046","text":", or ","marks":[]},{"_type":"span","_key":"b2048","text":"open Melius","marks":["b2047"]},{"_type":"span","_key":"b2049","text":" and try it on one image.","marks":[]}]},{"_type":"block","_key":"b2052","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b2051","text":"Frequently asked questions","marks":[]}],"anchorId":"frequently-asked-questions"},{"_type":"faqList","_key":"b2053","items":"$54:props:children:1:props:children:1:props:children:0:props:post:faq"}]}}],"$L6a","$L6b"]}]]}]]}]
