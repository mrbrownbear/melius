61:["$","td","b21414",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2156",{"children":["Automatic on publish"]}]]}]
62:["$","tr","b2157",{"className":"border-t border-black/10","children":[["$","td","b21570",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2160",{"children":["Pencil"]}]]}],["$","td","b21571",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2163",{"children":["Enterprise creative platform"]}]]}],["$","td","b21572",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2166",{"children":["Brand assets under governance"]}]]}],["$","td","b21573",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2169",{"children":["Yes, across 24 markets"]}]]}],["$","td","b21574",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2172",{"children":["Not stated"]}]]}]]}]
63:["$","tr","b2173",{"className":"border-t border-black/10","children":[["$","td","b21730",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2176",{"children":["Creatify"]}]]}],["$","td","b21731",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2179",{"children":["Video-first ad platform"]}]]}],["$","td","b21732",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2182",{"children":["Product Ads, URL-to-video"]}]]}],["$","td","b21733",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2185",{"children":["Up to 50 video variants"]}]]}],["$","td","b21734",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b2188",{"children":["Per-network formats"]}]]}]]}]
65:["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]
66:["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"Three or four. Image models are probabilistic, so running several in parallel beats running one, disliking it and starting over. Correct the near-misses by editing that step's prompt rather than rewriting the whole brief."}]
67:["$","details","4",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["Do I still need a photographer for product photos?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"For most catalog and lifestyle variants, no, but you do need one clean, well-lit pack shot per product, and everything else is generated from it, so that shot is worth paying for. Reflective and transparent products and print-resolution hero images still favor a real shoot and manual retouching."}]]}]
68:["$","details","5",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["Is an ad platform or a canvas the right choice for product variants?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"Ask where the output goes. If it goes straight into Meta or TikTok as a tested ad, an ad production system saves you the handoff. If it goes into a catalog, a marketplace listing, a deck or a packaging render, a canvas is the better shape, because those destinations need control more than they need automatic publishing."}]]}]
6a:["$","$L69","post-melius-summer-internship",{"post":{"_key":"post-melius-summer-internship","slug":"melius-summer-internship","category":"modus-news","title":"My Summer Internship with Melius","isoDate":"2026-08-19","date":"August 19, 2026","readTime":"7 Min Read","excerpt":"Wrapping up my summer engineering internship at Melius. Here is what I got to own, from building agent skills and context to the Playground, plus the team culture, the pre-launch off-site, and what I learned about product engineering and UX.","image":{"url":"/images/blog/melius-summer-internship/cover.webp"},"authors":[{"name":"Nicholas Chen, Member of Technical Staff Intern"}],"faq":[{"question":"What is Melius?","answer":"Melius is an agents lab for creatives, marketing teams, and filmmakers. It gives you access to every major image and video model through a single interface, and Mel, its AI agent, handles the tedious work so you can generate whatever you imagine without leaving the app."},{"question":"What is the Playground in Melius?","answer":"The Playground is the fastest way to create in Melius: you describe what you want, pick a model and format, choose how many variations, and hit generate. Under the hood every Playground session is still a real canvas, so nothing you make is throwaway and you can open it in the full canvas whenever you want more control."},{"question":"What are agent skills and context in Melius?","answer":"Skills and context are two ways to give Mel instructions. Context is applied automatically on every turn, so it is where team conventions, brand guidelines, and preferences live. Skills are applied selectively when they are relevant to a task, and they can carry reference images alongside written instructions, which makes them useful for things like a product-photography look or keeping a character consistent."},{"question":"What was it like to intern at Melius?","answer":"Interning at Melius meant owning larger projects end to end and shipping directly to customers on a small team. Alongside the engineering there were team dinners and a lot of Super Smash Bros."}],"tableOfContents":[{"_key":"starting-my-engineering-internship","title":"Starting My Engineering Internship"},{"_key":"agent-context-and-skills","title":"Agent Context and Skills"},{"_key":"the-playground","title":"The Playground"},{"_key":"work-hard-play-hard","title":"Work Hard, Play Hard"},{"_key":"key-takeaways","title":"Key Takeaways"},{"_key":"wrapping-up","title":"Wrapping Up"},{"_key":"faq","title":"FAQ"}],"content":[{"_type":"block","_key":"b1705","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1704","text":"Starting My Engineering Internship","marks":[]}],"anchorId":"starting-my-engineering-internship"},{"_type":"block","_key":"b1707","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1706","text":"My internship at Melius has been an awesome learning experience for me as an engineer and a creative. Over the past few months, I had the opportunity to work on small and large projects that directly impacted our customers and also got to see the product scale and the team grow alongside it. I'm now wrapping up my last week and wanted to summarize everything I worked on, learned and enjoyed about Melius.","marks":[]}]},{"_type":"block","_key":"b1709","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1708","text":"For context, Melius is an agents lab for creatives, marketing teams, and filmmakers to generate beautiful scenes and videos with access to image and video models through a single interface. Mel, our AI agent, does all the tedious work, so users are able to generate anything from their imagination without ever leaving the app.","marks":[]}]},{"_type":"block","_key":"b1711","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1710","text":"In the past, I've worked at other startups and larger companies, but at Melius, what I loved most was being able to take on larger projects, have more ownership over the product, and wear many hats throughout the term.","marks":[]}]},{"_type":"block","_key":"b1713","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1712","text":"Agent Context and Skills","marks":[]}],"anchorId":"agent-context-and-skills"},{"_type":"block","_key":"b1715","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1714","text":"One of the larger projects I got to own was building out skills and context for our agent. The idea originally came up when we wanted Mel to follow certain instructions, but only during specific sessions. When we first started brainstorming solutions, we looked at how skills and context are typically used with AI agents. Both can essentially be represented as Markdown files containing instructions for the model, but the key difference is when they're applied. Context is applied automatically on every agent turn, while skills are selectively applied when they're relevant to a specific task.","marks":[]}]},{"_type":"block","_key":"b1717","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1716","text":"Since Melius offers a creative canvas, we also wanted our skills to go beyond the typical Markdown file. A lot of creative direction is easier to show than describe, so we designed our skills to include reference images alongside written instructions. This opens up a bunch of useful workflows: a product photography skill could include instructions and references for a specific composition, while a character skill could help maintain consistency across generations. Context, on the other hand, could capture things that should always apply, like team conventions, brand guidelines, or other preferences Mel should know on every turn.","marks":[]}]},{"_type":"imageCompare","_key":"b1718","caption":"How agent skills and context work together","images":[{"label":"","src":"/images/blog/melius-summer-internship/agent-architecture.webp","alt":"How agent skills and context work together","aspectRatio":"2536 / 1504"}]},{"_type":"block","_key":"b1720","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1719","text":"The goal of both features is ultimately to make prompting less repetitive. You tell Mel what you want to create, context gives it what it should already know, and your selected skills provide the task-specific instructions and references it needs. A big part of building this was also figuring out the product UX and making sure these features felt intuitive within the existing creative workflow.","marks":[]}]},{"_type":"block","_key":"b1722","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1721","text":"Working on this ended up being one of my favorite projects because it sat at the intersection of engineering, product, and creative tooling. I got to think through the agent architecture, build the underlying system, and figure out how to make it feel intuitive inside a creative workflow.","marks":[]}]},{"_type":"block","_key":"b1725","style":"normal","markDefs":[{"_type":"link","_key":"b1723","href":"https://x.com/trymelius/status/2066941446247108899?s=20","isNewTab":true}],"children":[{"_type":"span","_key":"b1724","text":"Here's a demo of the feature","marks":["b1723"]}]},{"_type":"imageCompare","_key":"b1726","caption":"Agent skills and context in the Melius app settings","images":[{"label":"","src":"/images/blog/melius-summer-internship/agent-skills-settings.webp","alt":"Agent skills and context in the Melius app settings","aspectRatio":"1974 / 906"}]},{"_type":"block","_key":"b1728","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1727","text":"The Playground","marks":[]}],"anchorId":"the-playground"},{"_type":"block","_key":"b1730","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1729","text":"Another fun project I got to work on was the Playground. Before this, Melius started off as a creative canvas where users could create generation workflows together, make edits, and build out entire scenes in an infinite space. But not every creative task needs a full canvas, so we wanted to give users a faster way to simply type a prompt and start creating.","marks":[]}]},{"_type":"block","_key":"b1732","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1731","text":"The Playground is a simpler, more intuitive way to create: you describe what you want, pick a model and format, choose how many variations, and hit generate. The Playground mirrored the canvas experience, making it easy for existing Melius users to bring over their work while still being approachable for new users. All the generations in the Playground are saved to each user's personal history within their team, making it easy to revisit their work later.","marks":[]}]},{"_type":"block","_key":"b1734","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1733","text":"What I like most about how we built it is that under the hood, every Playground session is still a real canvas. Nothing you make is throwaway so the moment you want more control, you can open it in the full canvas and keep working with all of Mel's tools. That let the Playground lower the barrier to entry without cutting anyone off from the depth underneath.","marks":[]}]},{"_type":"imageCompare","_key":"b1735","caption":"The playground architecture under the hood","images":[{"label":"","src":"/images/blog/melius-summer-internship/playground-architecture.webp","alt":"The playground architecture under the hood","aspectRatio":"2000 / 412"}]},{"_type":"block","_key":"b1737","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1736","text":"This was another project that made me think hard about UX. The whole point was to remove friction for people who might be intimidated by a blank canvas, so a lot of the work came down to small product decisions: what information to show upfront, what to hide until it was needed, how users selected models and formats, and how we could make the path from an idea to a generation as simple as possible. At the same time, we wanted the Playground to fit naturally into the rest of Melius, so users could start with something simple and move into the canvas when they needed more control or more advanced workflows. (Shoutout to Winson for the designs!)","marks":[]}]},{"_type":"block","_key":"b1739","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1738","text":"This was probably the most fun project I got to work on during my internship, and I was really happy with how it turned out. Seeing so many users using the Playground after we shipped it was especially rewarding and made all the small product and UX decisions feel worth it. Lots of learning came out of this and I couldn't have done it without Ray, who helped get it to the finish line.","marks":[]}]},{"_type":"block","_key":"b1742","style":"normal","markDefs":[{"_type":"link","_key":"b1740","href":"https://x.com/trymelius/status/2080757663139520622?s=20","isNewTab":true}],"children":[{"_type":"span","_key":"b1741","text":"Showcase of the Playground in Melius","marks":["b1740"]}]},{"_type":"imageCompare","_key":"b1743","caption":"An example image generated in the Playground","images":[{"label":"","src":"/images/blog/melius-summer-internship/playground-showcase.webp","alt":"Showcase of the Playground in Melius","aspectRatio":"2000 / 1339"}]},{"_type":"block","_key":"b1745","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1744","text":"Work Hard, Play Hard","marks":[]}],"anchorId":"work-hard-play-hard"},{"_type":"block","_key":"b1747","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1746","text":"Of course, the internship wasn't all work. Some of my favorite memories at Melius came from the things we did together outside of our usual day-to-day. We had team dinners, did yoga together, and generally spent a lot of time getting to know each other beyond work. Most of our days ended with playing a few games of Super Smash Bros.","marks":[]}]},{"_type":"imageCompare","_key":"b1748","caption":"The Melius team doing yoga at 8am in the morning","images":[{"label":"","src":"/images/blog/melius-summer-internship/team-yoga.webp","alt":"The Melius team doing yoga at 8am in the morning","aspectRatio":"16 / 9"}]},{"_type":"block","_key":"b1750","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1749","text":"One of the highlights was our team off-site in upstate New York leading up to launch. We spent three or four days together in a huge house, basically living and working under the same roof. We were revamping major parts of the app, fixing things that hadn't mattered as much at a smaller scale, and making sure the product and infrastructure was ready for a much larger wave of users. Everyone was jumping between whatever needed to get done, and it was really cool getting to experience that side of building and launching a product firsthand. The off-site brought us closer as a team and made the internship that much more memorable.","marks":[]}]},{"_type":"block","_key":"b1755","style":"normal","markDefs":[{"_type":"link","_key":"b1752","href":"https://x.com/n0w00j/status/2075594907285139867?s=20","isNewTab":true}],"children":[{"_type":"span","_key":"b1751","text":"After all the prep, seeing Melius finally launch was really cool! Check out the launch ","marks":[]},{"_type":"span","_key":"b1753","text":"here","marks":["b1752"]},{"_type":"span","_key":"b1754","text":".","marks":[]}]},{"_type":"imageCompare","_key":"b1756","caption":"The team working on the app pre-launch during dinner at the offsite","images":[{"label":"","src":"/images/blog/melius-summer-internship/offsite-dinner.webp","alt":"The team working on the app pre-launch during dinner at the offsite","aspectRatio":"16 / 9"}]},{"_type":"block","_key":"b1758","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1757","text":"Key Takeaways","marks":[]}],"anchorId":"key-takeaways"},{"_type":"block","_key":"b1760","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1759","text":"My two biggest takeaways from being on the engineering team here at Melius were developing a stronger product engineering mindset and improving my communication skills.","marks":[]}]},{"_type":"block","_key":"b1763","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1761","text":"Think Like a Product Engineer","marks":["strong"]},{"_type":"span","_key":"b1762","text":" â€“ On the product side, I learned to think beyond whether something simply works and focus more on how it actually feels to use. At Melius, this was especially important since we're building for prosumers, many of whom aren't technical, so features like agents and generative models need to feel intuitive and approachable. This taught me to hold a much higher bar for UX when shipping customer-facing features and to care about the small details that shape the overall experience.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b1766","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1764","text":"Communicate Clearly","marks":["strong"]},{"_type":"span","_key":"b1765","text":" â€“ I also learned that communication is a huge part of being an effective engineer. Whether it's discussing technical decisions with other engineers or explaining ideas to non-engineers, being able to communicate clearly and efficiently keeps everyone aligned and allows the team to move faster.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b1768","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1767","text":"Wrapping Up","marks":[]}],"anchorId":"wrapping-up"},{"_type":"block","_key":"b1770","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1769","text":"Overall, I'm incredibly grateful for everything I got to experience. I came into the internship hoping to grow as an engineer, but I'm leaving with a much better understanding of what it means to build a product end-to-end. From owning larger projects, to thinking deeply about UX, and working across different parts of the stack, I was constantly learning something new.","marks":[]}]},{"_type":"block","_key":"b1772","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1771","text":"What made the experience especially memorable was the amount of ownership and trust I was given. Being on a small team meant I got to work on things that shipped directly to customers and see the impact of what I was building. More than anything, I'm grateful for the people I got to work with while building something I genuinely enjoyed working on.","marks":[]}]},{"_type":"block","_key":"b1774","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b1773","text":"I'm excited to take everything I learned at Melius with me into whatever I build next! A huge thank you to Young, Joowon, Arnav, Ray, Jahow, Alex, Winson, Samantha and Max for making these past few months such a memorable experience.","marks":[]}]},{"_type":"block","_key":"b1776","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b1775","text":"FAQ","marks":[]}],"anchorId":"faq"},{"_type":"faqList","_key":"b1777","items":"$6a:props:post:faq"}]}}]
6b:["$","$L69","post-seedance-2-5",{"post":{"_key":"post-seedance-2-5","slug":"seedance-2-5","category":"modus-news","title":"Seedance 2.5 is live on Melius: 30-second video with audio","isoDate":"2026-08-07","date":"August 7, 2026","readTime":"5 Min Read","excerpt":"Seedance 2.5 is live on Melius. ByteDance's new video model generates up to 30 seconds in a single take with audio in the same pass, and takes up to 50 reference files. Here is what shipped, what you can run today, and what is still coming.","image":{"url":"/images/blog/seedance-2-5-launch/cover.webp"},"authors":[{"name":"Alex Chen, Member of Technical Staff"}],"faq":[{"question":"Is Seedance 2.5 out?","answer":"Yes. ByteDance released Seedance 2.5 and it is live in the Melius video model picker. You can run it in text-to-video, image-to-video, reference-to-video, and video-to-video, with generated audio in the same pass."},{"question":"How long can a Seedance 2.5 video be?","answer":"Up to 30 seconds in a single generation. Melius exposes every whole-second length from 4 to 30 seconds, so you set the shot length rather than stitching a 5-second loop into something longer."},{"question":"What resolution does Seedance 2.5 support on Melius?","answer":"480p, 720p and 1080p, with 720p as the default. You can generate a 1080p take directly on Melius and keep it with its references and previous versions on the canvas."},{"question":"Does Seedance 2.5 generate audio?","answer":"Yes. Audio is produced together with the video rather than dubbed on afterwards, so footsteps, speech, and ambience line up with what is on screen. There is a sound toggle on the node if you want a silent clip."},{"question":"How many reference inputs does Seedance 2.5 take?","answer":"Up to 30 reference images, 10 reference videos, and 10 audio clips, capped at 50 files in total across all three. That is what lets you hold a character, a product, or a house style steady across a 30-second shot."},{"question":"What is the difference between Seedance 2.5 and Seedance 2.0?","answer":"Seedance 2.5 doubles the maximum clip length from 15 to 30 seconds, raises the reference ceiling to 50 files across images, video, and audio, and adds video-to-video with reference conditioning. Seedance 2.0 stays in the picker and is still the cheaper, faster option for short shots."},{"question":"How much does Seedance 2.5 cost?","answer":"It runs on the same shared Melius credit pool as every other image, video, and audio model, priced per second of output, with 480p costing roughly half of 720p. There is no separate Seedance subscription to buy, so you can compare it against Kling, Veo, and Sora on the same budget."},{"question":"What aspect ratios does Seedance 2.5 support?","answer":"21:9, 16:9, 4:3, 1:1, 3:4, and 9:16. The vertical ratios matter most in practice, since a large share of the video work on Melius is cut for social."}],"tableOfContents":[{"_key":"seedance-is-now-more-than-half-of-every-video-on-melius","title":"The Numbers"},{"_key":"what-is-new-in-seedance-2-5","title":"What Is New"},{"_key":"what-you-can-run-today-on-melius","title":"On Melius"},{"_key":"getting-a-good-take-out-of-it","title":"How To Use It"},{"_key":"frequently-asked-questions","title":"FAQ"}],"content":[{"_type":"block","_key":"b290","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b288","text":"Seedance 2.5","marks":["strong"]},{"_type":"span","_key":"b289","text":" is live on Melius. ByteDance's new video model generates up to 30 seconds in a single take, with audio produced alongside the picture instead of layered on after, and it accepts up to 50 reference files across images, video, and sound. It is in the video model picker now, on the same credit pool as everything else.","marks":[]}]},{"_type":"block","_key":"b295","style":"normal","markDefs":[{"_type":"link","_key":"b292","href":"/blog/seedance-2-5-anticipation","isNewTab":false}],"children":[{"_type":"span","_key":"b291","text":"We wrote about ","marks":[]},{"_type":"span","_key":"b293","text":"what Seedance 2.5 was promising back in July","marks":["b292"]},{"_type":"span","_key":"b294","text":". This is the shorter, more useful version: what actually shipped, what you can run today, and what is still to come.","marks":[]}]},{"_type":"block","_key":"b297","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b296","text":"Seedance is now more than half of every video on Melius","marks":[]}],"anchorId":"seedance-is-now-more-than-half-of-every-video-on-melius"},{"_type":"block","_key":"b301","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b298","text":"Context for why a Seedance release matters here more than most. Over the last 30 days, the Seedance family accounted for ","marks":[]},{"_type":"span","_key":"b299","text":"54.6% of every video generation on Melius","marks":["strong"]},{"_type":"span","_key":"b300","text":". When we last published this number it was 26.7%. Nobody is routed to it by default. People run it next to Kling, Veo, Sora, and Wan on the same canvas and keep picking it.","marks":[]}]},{"_type":"lineChart","_key":"b302","title":"Seedance's share of video generations on Melius","caption":"Share of finished video jobs on Melius run on a Seedance model. The climb through July ran entirely on Seedance 2.0.","unit":"%","yMax":60,"points":[{"label":"March","value":1},{"label":"April","value":10},{"label":"May","value":22},{"label":"June","value":30},{"label":"August","value":55}]},{"_type":"block","_key":"b304","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b303","text":"What is new in Seedance 2.5","marks":[]}],"anchorId":"what-is-new-in-seedance-2-5"},{"_type":"block","_key":"b307","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b305","text":"30 seconds in one take. ","marks":["strong"]},{"_type":"span","_key":"b306","text":"Double Seedance 2.0's ceiling, and long enough to be a finished shot rather than a loop you have to extend. Melius exposes every length from 4 to 30 seconds.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b310","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b308","text":"Up to 50 reference files. ","marks":["strong"]},{"_type":"span","_key":"b309","text":"Thirty images, ten videos, and ten audio clips, capped at 50 in total. This is the feature that holds a character or a product on-model across a long shot.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b313","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b311","text":"Video-to-video with references. ","marks":["strong"]},{"_type":"span","_key":"b312","text":"Feed in existing footage plus reference images and a prompt, and restyle or re-shoot it rather than starting from a blank frame.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b315","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b314","text":"What you can run today on Melius","marks":[]}],"anchorId":"what-you-can-run-today-on-melius"},{"_type":"portableTable","_key":"b316","rows":[{"_key":"b317","cells":[{"_key":"b318","text":[{"_type":"block","_key":"b320","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b319","text":"Setting","marks":["strong"]}]}]},{"_key":"b321","text":[{"_type":"block","_key":"b323","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b322","text":"What Melius supports","marks":["strong"]}]}]}]},{"_key":"b324","cells":[{"_key":"b325","text":[{"_type":"block","_key":"b327","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b326","text":"Inputs","marks":[]}]}]},{"_key":"b328","text":[{"_type":"block","_key":"b330","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b329","text":"Text, image, video, and audio","marks":[]}]}]}]},{"_key":"b331","cells":[{"_key":"b332","text":[{"_type":"block","_key":"b334","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b333","text":"Clip length","marks":[]}]}]},{"_key":"b335","text":[{"_type":"block","_key":"b337","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b336","text":"4 to 30 seconds, any whole second","marks":[]}]}]}]},{"_key":"b338","cells":[{"_key":"b339","text":[{"_type":"block","_key":"b341","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b340","text":"Resolution","marks":[]}]}]},{"_key":"b342","text":[{"_type":"block","_key":"b344","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b343","text":"480p, 720p and 1080p, 720p by default","marks":[]}]}]}]},{"_key":"b345","cells":[{"_key":"b346","text":[{"_type":"block","_key":"b348","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b347","text":"Aspect ratios","marks":[]}]}]},{"_key":"b349","text":[{"_type":"block","_key":"b351","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b350","text":"21:9, 16:9, 4:3, 1:1, 3:4, 9:16","marks":[]}]}]}]},{"_key":"b352","cells":[{"_key":"b353","text":[{"_type":"block","_key":"b355","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b354","text":"Audio","marks":[]}]}]},{"_key":"b356","text":[{"_type":"block","_key":"b358","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b357","text":"Generated in the same pass, toggleable per node","marks":[]}]}]}]},{"_key":"b359","cells":[{"_key":"b360","text":[{"_type":"block","_key":"b362","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b361","text":"Reference inputs","marks":[]}]}]},{"_key":"b363","text":[{"_type":"block","_key":"b365","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b364","text":"Up to 30 images, 10 videos, 10 audio clips, 50 files total","marks":[]}]}]}]},{"_key":"b366","cells":[{"_key":"b367","text":[{"_type":"block","_key":"b369","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b368","text":"Seed","marks":[]}]}]},{"_key":"b370","text":[{"_type":"block","_key":"b372","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b371","text":"Supported, so a take you like is reproducible","marks":[]}]}]}]}]},{"_type":"block","_key":"b374","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b373","text":"Seedance 2.5 runs at 480p, 720p and 1080p on Melius. Choose the resolution for your deliverable and compare the take against other video models on the same canvas.","marks":[]}]},{"_type":"block","_key":"b376","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b375","text":"Getting a good take out of it","marks":[]}],"anchorId":"getting-a-good-take-out-of-it"},{"_type":"block","_key":"b382","style":"normal","markDefs":[{"_type":"link","_key":"b379","href":"/blog/nano-banana-image-models","isNewTab":false}],"children":[{"_type":"span","_key":"b377","text":"Start from a frame you already like. ","marks":["strong"]},{"_type":"span","_key":"b378","text":"Image-to-video outruns text-to-video by better than two to one in our data, because a validated still removes half the uncertainty. Which means the ","marks":[]},{"_type":"span","_key":"b380","text":"image model you generate that still with","marks":["b379"]},{"_type":"span","_key":"b381","text":" decides a lot about the clip.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b385","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b383","text":"Use the reference budget. ","marks":["strong"]},{"_type":"span","_key":"b384","text":"If you rationed reference frames to fit older limits, stop. Fifty files is room for a character sheet, a product from several angles, a style board, and a voice sample all at once.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b391","style":"normal","markDefs":[{"_type":"link","_key":"b388","href":"/blog/one-subscription-every-model","isNewTab":false}],"children":[{"_type":"span","_key":"b386","text":"Compare it against the field. ","marks":["strong"]},{"_type":"span","_key":"b387","text":"Because Melius puts ","marks":[]},{"_type":"span","_key":"b389","text":"every model under one subscription","marks":["b388"]},{"_type":"span","_key":"b390","text":" and one credit pool, running the same shot through Seedance 2.5, Kling, and Veo side by side costs you nothing extra in setup.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b395","style":"normal","markDefs":[{"_type":"link","_key":"b392","href":"https://app.melius.com","isNewTab":true}],"children":[{"_type":"span","_key":"b393","text":"Open Melius","marks":["b392"]},{"_type":"span","_key":"b394","text":" and pick Seedance 2.5 on any video node.","marks":[]}]},{"_type":"block","_key":"b400","style":"normal","markDefs":[{"_type":"link","_key":"b397","href":"/blog/where-to-run-seedance-2-5","isNewTab":false}],"children":[{"_type":"span","_key":"b396","text":"For a platform-by-platform breakdown of resolution, cost, and reference support, read ","marks":[]},{"_type":"span","_key":"b398","text":"where to run Seedance 2.5","marks":["b397"]},{"_type":"span","_key":"b399","text":".","marks":[]}]},{"_type":"block","_key":"b402","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b401","text":"Frequently asked questions","marks":[]}],"anchorId":"frequently-asked-questions"},{"_type":"faqList","_key":"b403","items":"$6b:props:post:faq"}]}}]
