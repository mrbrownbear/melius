4:["$","div",null,{"className":"relative z-10 w-full","children":["$","div",null,{"className":"grid items-center gap-10 md:grid-cols-2 md:gap-16","children":[["$","div",null,{"className":"flex h-full flex-col justify-center gap-6 max-md:items-center md:py-15","children":[["$","div",null,{"className":"flex items-center gap-4","children":[["$","p",null,{"className":"t-b-3 whitespace-pre-wrap text-black-3","children":"August 19, 2026   â€¢   7 Min Read"}],["$","$L14",null,{}]]}],["$","h1",null,{"className":"t-h-1 text-gray-dark-1 text-pretty max-md:text-center","children":"My Summer Internship with Melius"}],["$","div",null,{"className":"mt-2 flex flex-col gap-5 max-md:hidden","children":[["$","div","Nicholas Chen, Member of Technical Staff Intern",{"className":"flex items-center gap-4","children":["$undefined",["$","div",null,{"className":"flex flex-col gap-1.5","children":[["$","span",null,{"className":"t-b-2 text-black font-medium","children":"Nicholas Chen, Member of Technical Staff Intern"}],"$undefined"]}]]}]]}]]}],["$","div",null,{"className":"relative aspect-[3/2] w-full overflow-hidden rounded-3xl","children":["$","img",null,{"src":"/images/blog/melius-summer-internship/cover.webp","alt":"My Summer Internship with Melius","className":"absolute inset-0 h-full w-full object-cover"}]}],["$","div",null,{"className":"mt-2 flex flex-col gap-5 md:hidden","children":[["$","div","Nicholas Chen, Member of Technical Staff Intern",{"className":"flex items-center gap-4","children":["$undefined",["$","div",null,{"className":"flex flex-col gap-1.5","children":[["$","span",null,{"className":"t-b-2 text-black font-medium","children":"Nicholas Chen, Member of Technical Staff Intern"}],"$undefined"]}]]}]]}]]}]}]
5:["$","div",null,{"className":"relative z-10 mx-auto mt-16 grid w-full max-w-[1360px] grid-cols-1 gap-8 md:mt-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,860px)_minmax(0,1fr)] lg:gap-0","children":[["$","aside",null,{"className":"hidden lg:col-start-1 lg:block lg:justify-self-end lg:pr-4","children":["$","div",null,{"className":"bg-white sticky top-28 w-52 rounded-2xl p-6","children":["$","$L15",null,{"sections":[{"_key":"starting-my-engineering-internship","title":"Starting My Engineering Internship"},{"_key":"agent-context-and-skills","title":"Agent Context and Skills"},{"_key":"the-playground","title":"The Playground"},{"_key":"work-hard-play-hard","title":"Work Hard, Play Hard"},{"_key":"key-takeaways","title":"Key Takeaways"},{"_key":"wrapping-up","title":"Wrapping Up"},{"_key":"faq","title":"FAQ"}],"className":"w-full flex-col gap-4 overflow-visible md:static","linkClassName":"t-b-3 !font-semibold text-foreground-muted leading-snug transition-colors hover:text-gray-dark-1","activeLinkClassName":"text-orange"}]}]}],["$","div",null,{"className":"wysiwyg bg-white w-full min-w-0 rounded-3xl p-6 md:p-10 lg:col-start-2 lg:p-12","children":[["$","h2","b1705",{"id":"starting-my-engineering-internship","className":"scroll-mt-28","children":["Starting My Engineering Internship"]}],["$","p","b1707",{"children":["My internship at Melius has been an awesome learning experience for me as an engineer and a creative. Over the past few months, I had the opportunity to work on small and large projects that directly impacted our customers and also got to see the product scale and the team grow alongside it. I'm now wrapping up my last week and wanted to summarize everything I worked on, learned and enjoyed about Melius."]}],["$","p","b1709",{"children":["For context, Melius is an agents lab for creatives, marketing teams, and filmmakers to generate beautiful scenes and videos with access to image and video models through a single interface. Mel, our AI agent, does all the tedious work, so users are able to generate anything from their imagination without ever leaving the app."]}],["$","p","b1711",{"children":["In the past, I've worked at other startups and larger companies, but at Melius, what I loved most was being able to take on larger projects, have more ownership over the product, and wear many hats throughout the term."]}],["$","h2","b1713",{"id":"agent-context-and-skills","className":"scroll-mt-28","children":["Agent Context and Skills"]}],["$","p","b1715",{"children":["One of the larger projects I got to own was building out skills and context for our agent. The idea originally came up when we wanted Mel to follow certain instructions, but only during specific sessions. When we first started brainstorming solutions, we looked at how skills and context are typically used with AI agents. Both can essentially be represented as Markdown files containing instructions for the model, but the key difference is when they're applied. Context is applied automatically on every agent turn, while skills are selectively applied when they're relevant to a specific task."]}],["$","p","b1717",{"children":["Since Melius offers a creative canvas, we also wanted our skills to go beyond the typical Markdown file. A lot of creative direction is easier to show than describe, so we designed our skills to include reference images alongside written instructions. This opens up a bunch of useful workflows: a product photography skill could include instructions and references for a specific composition, while a character skill could help maintain consistency across generations. Context, on the other hand, could capture things that should always apply, like team conventions, brand guidelines, or other preferences Mel should know on every turn."]}],"$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32"]}]]}]
6:["$","section","related",{"className":"relative w-full pb-section bg-gray-background","children":[["$","$L3",null,{"color":"gray"}],["$","div",null,{"className":"relative z-10 mx-auto w-full max-w-300 px-5 lg:px-8","children":[["$","h2",null,{"className":"t-h-2 mb-12 text-center text-balance text-gray-dark-1","children":"Related Articles"}],["$","div",null,{"className":"mx-auto grid w-full max-w-max grid-cols-1 gap-11 md:grid-cols-2 lg:grid-cols-3","children":[["$","$L33","post-seedance-2-5",{"post":{"_key":"post-seedance-2-5","slug":"seedance-2-5","category":"modus-news","title":"Seedance 2.5 is live on Melius: 30-second video with audio","isoDate":"2026-08-07","date":"August 7, 2026","readTime":"5 Min Read","excerpt":"Seedance 2.5 is live on Melius. ByteDance's new video model generates up to 30 seconds in a single take with audio in the same pass, and takes up to 50 reference files. Here is what shipped, what you can run today, and what is still coming.","image":{"url":"/images/blog/seedance-2-5-launch/cover.webp"},"authors":[{"name":"Alex Chen, Member of Technical Staff"}],"faq":[{"question":"Is Seedance 2.5 out?","answer":"Yes. ByteDance released Seedance 2.5 and it is live in the Melius video model picker. You can run it in text-to-video, image-to-video, reference-to-video, and video-to-video, with generated audio in the same pass."},{"question":"How long can a Seedance 2.5 video be?","answer":"Up to 30 seconds in a single generation. Melius exposes every whole-second length from 4 to 30 seconds, so you set the shot length rather than stitching a 5-second loop into something longer."},{"question":"What resolution does Seedance 2.5 support on Melius?","answer":"480p, 720p and 1080p, with 720p as the default. You can generate a 1080p take directly on Melius and keep it with its references and previous versions on the canvas."},{"question":"Does Seedance 2.5 generate audio?","answer":"Yes. Audio is produced together with the video rather than dubbed on afterwards, so footsteps, speech, and ambience line up with what is on screen. There is a sound toggle on the node if you want a silent clip."},{"question":"How many reference inputs does Seedance 2.5 take?","answer":"Up to 30 reference images, 10 reference videos, and 10 audio clips, capped at 50 files in total across all three. That is what lets you hold a character, a product, or a house style steady across a 30-second shot."},{"question":"What is the difference between Seedance 2.5 and Seedance 2.0?","answer":"Seedance 2.5 doubles the maximum clip length from 15 to 30 seconds, raises the reference ceiling to 50 files across images, video, and audio, and adds video-to-video with reference conditioning. Seedance 2.0 stays in the picker and is still the cheaper, faster option for short shots."},{"question":"How much does Seedance 2.5 cost?","answer":"It runs on the same shared Melius credit pool as every other image, video, and audio model, priced per second of output, with 480p costing roughly half of 720p. There is no separate Seedance subscription to buy, so you can compare it against Kling, Veo, and Sora on the same budget."},{"question":"What aspect ratios does Seedance 2.5 support?","answer":"21:9, 16:9, 4:3, 1:1, 3:4, and 9:16. The vertical ratios matter most in practice, since a large share of the video work on Melius is cut for social."}],"tableOfContents":[{"_key":"seedance-is-now-more-than-half-of-every-video-on-melius","title":"The Numbers"},{"_key":"what-is-new-in-seedance-2-5","title":"What Is New"},{"_key":"what-you-can-run-today-on-melius","title":"On Melius"},{"_key":"getting-a-good-take-out-of-it","title":"How To Use It"},{"_key":"frequently-asked-questions","title":"FAQ"}],"content":[{"_type":"block","_key":"b290","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b288","text":"Seedance 2.5","marks":["strong"]},{"_type":"span","_key":"b289","text":" is live on Melius. ByteDance's new video model generates up to 30 seconds in a single take, with audio produced alongside the picture instead of layered on after, and it accepts up to 50 reference files across images, video, and sound. It is in the video model picker now, on the same credit pool as everything else.","marks":[]}]},{"_type":"block","_key":"b295","style":"normal","markDefs":[{"_type":"link","_key":"b292","href":"/blog/seedance-2-5-anticipation","isNewTab":false}],"children":[{"_type":"span","_key":"b291","text":"We wrote about ","marks":[]},{"_type":"span","_key":"b293","text":"what Seedance 2.5 was promising back in July","marks":["b292"]},{"_type":"span","_key":"b294","text":". This is the shorter, more useful version: what actually shipped, what you can run today, and what is still to come.","marks":[]}]},{"_type":"block","_key":"b297","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b296","text":"Seedance is now more than half of every video on Melius","marks":[]}],"anchorId":"seedance-is-now-more-than-half-of-every-video-on-melius"},{"_type":"block","_key":"b301","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b298","text":"Context for why a Seedance release matters here more than most. Over the last 30 days, the Seedance family accounted for ","marks":[]},{"_type":"span","_key":"b299","text":"54.6% of every video generation on Melius","marks":["strong"]},{"_type":"span","_key":"b300","text":". When we last published this number it was 26.7%. Nobody is routed to it by default. People run it next to Kling, Veo, Sora, and Wan on the same canvas and keep picking it.","marks":[]}]},{"_type":"lineChart","_key":"b302","title":"Seedance's share of video generations on Melius","caption":"Share of finished video jobs on Melius run on a Seedance model. The climb through July ran entirely on Seedance 2.0.","unit":"%","yMax":60,"points":[{"label":"March","value":1},{"label":"April","value":10},{"label":"May","value":22},{"label":"June","value":30},{"label":"August","value":55}]},{"_type":"block","_key":"b304","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b303","text":"What is new in Seedance 2.5","marks":[]}],"anchorId":"what-is-new-in-seedance-2-5"},{"_type":"block","_key":"b307","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b305","text":"30 seconds in one take. ","marks":["strong"]},{"_type":"span","_key":"b306","text":"Double Seedance 2.0's ceiling, and long enough to be a finished shot rather than a loop you have to extend. Melius exposes every length from 4 to 30 seconds.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b310","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b308","text":"Up to 50 reference files. ","marks":["strong"]},{"_type":"span","_key":"b309","text":"Thirty images, ten videos, and ten audio clips, capped at 50 in total. This is the feature that holds a character or a product on-model across a long shot.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b313","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b311","text":"Video-to-video with references. ","marks":["strong"]},{"_type":"span","_key":"b312","text":"Feed in existing footage plus reference images and a prompt, and restyle or re-shoot it rather than starting from a blank frame.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b315","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b314","text":"What you can run today on Melius","marks":[]}],"anchorId":"what-you-can-run-today-on-melius"},{"_type":"portableTable","_key":"b316","rows":[{"_key":"b317","cells":[{"_key":"b318","text":[{"_type":"block","_key":"b320","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b319","text":"Setting","marks":["strong"]}]}]},{"_key":"b321","text":[{"_type":"block","_key":"b323","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b322","text":"What Melius supports","marks":["strong"]}]}]}]},{"_key":"b324","cells":[{"_key":"b325","text":[{"_type":"block","_key":"b327","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b326","text":"Inputs","marks":[]}]}]},{"_key":"b328","text":[{"_type":"block","_key":"b330","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b329","text":"Text, image, video, and audio","marks":[]}]}]}]},{"_key":"b331","cells":[{"_key":"b332","text":[{"_type":"block","_key":"b334","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b333","text":"Clip length","marks":[]}]}]},{"_key":"b335","text":[{"_type":"block","_key":"b337","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b336","text":"4 to 30 seconds, any whole second","marks":[]}]}]}]},{"_key":"b338","cells":[{"_key":"b339","text":[{"_type":"block","_key":"b341","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b340","text":"Resolution","marks":[]}]}]},{"_key":"b342","text":[{"_type":"block","_key":"b344","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b343","text":"480p, 720p and 1080p, 720p by default","marks":[]}]}]}]},{"_key":"b345","cells":[{"_key":"b346","text":[{"_type":"block","_key":"b348","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b347","text":"Aspect ratios","marks":[]}]}]},{"_key":"b349","text":[{"_type":"block","_key":"b351","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b350","text":"21:9, 16:9, 4:3, 1:1, 3:4, 9:16","marks":[]}]}]}]},{"_key":"b352","cells":[{"_key":"b353","text":[{"_type":"block","_key":"b355","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b354","text":"Audio","marks":[]}]}]},{"_key":"b356","text":[{"_type":"block","_key":"b358","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b357","text":"Generated in the same pass, toggleable per node","marks":[]}]}]}]},{"_key":"b359","cells":[{"_key":"b360","text":[{"_type":"block","_key":"b362","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b361","text":"Reference inputs","marks":[]}]}]},{"_key":"b363","text":[{"_type":"block","_key":"b365","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b364","text":"Up to 30 images, 10 videos, 10 audio clips, 50 files total","marks":[]}]}]}]},{"_key":"b366","cells":[{"_key":"b367","text":[{"_type":"block","_key":"b369","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b368","text":"Seed","marks":[]}]}]},{"_key":"b370","text":[{"_type":"block","_key":"b372","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b371","text":"Supported, so a take you like is reproducible","marks":[]}]}]}]}]},{"_type":"block","_key":"b374","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b373","text":"Seedance 2.5 runs at 480p, 720p and 1080p on Melius. Choose the resolution for your deliverable and compare the take against other video models on the same canvas.","marks":[]}]},{"_type":"block","_key":"b376","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b375","text":"Getting a good take out of it","marks":[]}],"anchorId":"getting-a-good-take-out-of-it"},{"_type":"block","_key":"b382","style":"normal","markDefs":[{"_type":"link","_key":"b379","href":"/blog/nano-banana-image-models","isNewTab":false}],"children":[{"_type":"span","_key":"b377","text":"Start from a frame you already like. ","marks":["strong"]},{"_type":"span","_key":"b378","text":"Image-to-video outruns text-to-video by better than two to one in our data, because a validated still removes half the uncertainty. Which means the ","marks":[]},{"_type":"span","_key":"b380","text":"image model you generate that still with","marks":["b379"]},{"_type":"span","_key":"b381","text":" decides a lot about the clip.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b385","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b383","text":"Use the reference budget. ","marks":["strong"]},{"_type":"span","_key":"b384","text":"If you rationed reference frames to fit older limits, stop. Fifty files is room for a character sheet, a product from several angles, a style board, and a voice sample all at once.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b391","style":"normal","markDefs":[{"_type":"link","_key":"b388","href":"/blog/one-subscription-every-model","isNewTab":false}],"children":[{"_type":"span","_key":"b386","text":"Compare it against the field. ","marks":["strong"]},{"_type":"span","_key":"b387","text":"Because Melius puts ","marks":[]},{"_type":"span","_key":"b389","text":"every model under one subscription","marks":["b388"]},{"_type":"span","_key":"b390","text":" and one credit pool, running the same shot through Seedance 2.5, Kling, and Veo side by side costs you nothing extra in setup.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b395","style":"normal","markDefs":[{"_type":"link","_key":"b392","href":"https://app.melius.com","isNewTab":true}],"children":[{"_type":"span","_key":"b393","text":"Open Melius","marks":["b392"]},{"_type":"span","_key":"b394","text":" and pick Seedance 2.5 on any video node.","marks":[]}]},{"_type":"block","_key":"b400","style":"normal","markDefs":[{"_type":"link","_key":"b397","href":"/blog/where-to-run-seedance-2-5","isNewTab":false}],"children":[{"_type":"span","_key":"b396","text":"For a platform-by-platform breakdown of resolution, cost, and reference support, read ","marks":[]},{"_type":"span","_key":"b398","text":"where to run Seedance 2.5","marks":["b397"]},{"_type":"span","_key":"b399","text":".","marks":[]}]},{"_type":"block","_key":"b402","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b401","text":"Frequently asked questions","marks":[]}],"anchorId":"frequently-asked-questions"},{"_type":"faqList","_key":"b403","items":"$6:props:children:1:props:children:1:props:children:0:props:post:faq"}]}}],"$L34","$L35"]}]]}]]}]
