84:["$","tr","b6547",{"className":"border-t border-black/10","children":[["$","td","b65470",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b6550",{"children":["Krea"]}]]}],["$","td","b65471",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b6553",{"children":["Veo 3, 3 Fast, 3.1, 3.1 Fast and 3.1 Lite"]}]]}],["$","td","b65472",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b6556",{"children":["Generation library, collaborative on Business"]}]]}],["$","td","b65473",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b6559",{"children":["$$9 a month, Veo from $35"]}]]}],["$","td","b65474",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b6562",{"children":["The widest Veo variant coverage"]}]]}]]}]
