c:["$","$1","h",{"children":[null,["$","$L77",null,{"children":[["$","meta","0",{"charSet":"utf-8"}],["$","meta","1",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]}],["$","div",null,{"hidden":true,"children":["$","$L78",null,{"children":["$","$75",null,{"name":"Next.Metadata","children":[["$","title","0",{"children":"Google Vertex AI alternatives for creative teams"}],["$","meta","1",{"name":"description","content":"Seven ways to reach Veo without a cloud project, compared on setup, where the work lives, throughput, and what you give up in governance."}],["$","link","2",{"rel":"canonical","href":"https://www.melius.com/blog/google-vertex-ai-alternatives-creative-teams"}],["$","meta","3",{"property":"og:title","content":"Google Vertex AI alternatives for creative teams"}],["$","meta","4",{"property":"og:description","content":"Seven ways to reach Veo without a cloud project, compared on setup, where the work lives, throughput, and what you give up in governance."}],["$","meta","5",{"property":"og:url","content":"https://www.melius.com/blog/google-vertex-ai-alternatives-creative-teams"}],["$","meta","6",{"property":"og:site_name","content":"Melius"}],["$","meta","7",{"property":"og:image","content":"https://www.melius.com/blog/google-vertex-ai-alternatives-creative-teams/opengraph-image?961bf8f0fa5edf72"}],["$","meta","8",{"property":"og:image:type","content":"image/png"}],["$","meta","9",{"property":"og:image:width","content":"1200"}],["$","meta","10",{"property":"og:image:height","content":"630"}],["$","meta","11",{"property":"og:image:alt","content":"Melius blog post"}],["$","meta","12",{"property":"og:type","content":"article"}],["$","meta","13",{"property":"article:published_time","content":"2026-09-16"}],["$","meta","14",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","15",{"name":"twitter:title","content":"Google Vertex AI alternatives for creative teams"}],["$","meta","16",{"name":"twitter:description","content":"Seven ways to reach Veo without a cloud project, compared on setup, where the work lives, throughput, and what you give up in governance."}],["$","meta","17",{"name":"twitter:image","content":"https://www.melius.com/blog/google-vertex-ai-alternatives-creative-teams/opengraph-image?961bf8f0fa5edf72"}],["$","meta","18",{"name":"twitter:image:alt","content":"Melius blog post"}],["$","meta","19",{"name":"twitter:image:type","content":"image/png"}],["$","meta","20",{"name":"twitter:image:width","content":"1200"}],["$","meta","21",{"name":"twitter:image:height","content":"630"}],["$","link","22",{"rel":"icon","href":"/icon.png?icon.1w6r-fknzpnk2.png","sizes":"256x256","type":"image/png"}],["$","$L79","23",{}]]}]}]}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}]
