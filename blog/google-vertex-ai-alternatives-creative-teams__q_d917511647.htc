5:["$","aside",null,{"className":"hidden lg:col-start-1 lg:block lg:justify-self-end lg:pr-4","children":["$","div",null,{"className":"bg-white sticky top-28 w-52 rounded-2xl p-6","children":["$","$L15",null,{"sections":[{"_key":"what-should-a-creative-team-use-instead-of-google-vertex-ai","title":"What should a creative team use instead of Google Vertex AI?"},{"_key":"what-to-know-before-you-pick","title":"What to know before you pick"},{"_key":"what-separates-a-creative-surface-from-an-inference-endpoint","title":"What separates a creative surface from an inference endpoint?"},{"_key":"the-seven-compared","title":"The seven compared"},{"_key":"1-melius","title":"1. Melius"},{"_key":"2-google-flow","title":"2. Google Flow"},{"_key":"3-flora","title":"3. Flora"},{"_key":"4-runway","title":"4. Runway"},{"_key":"5-adobe-firefly","title":"5. Adobe Firefly"},{"_key":"6-krea","title":"6. Krea"},{"_key":"7-fal-ai","title":"7. fal.ai"},{"_key":"when-the-platform-is-still-the-right-answer","title":"When the platform is still the right answer"},{"_key":"frequently-asked-questions","title":"FAQ"}],"className":"w-full flex-col gap-4 overflow-visible md:static","linkClassName":"t-b-3 !font-semibold text-foreground-muted leading-snug transition-colors hover:text-gray-dark-1","activeLinkClassName":"text-orange"}]}]}]
6:["$","div",null,{"className":"wysiwyg bg-white w-full min-w-0 rounded-3xl p-6 md:p-10 lg:col-start-2 lg:p-12","children":[["$","h2","b6399",{"id":"what-should-a-creative-team-use-instead-of-google-vertex-ai","className":"scroll-mt-28","children":["What should a creative team use instead of Google Vertex AI?"]}],["$","p","b6401",{"children":["Use a creative platform that resells the same Veo models, because almost all of them do and none of them charge more for it. Vertex is Google Cloud's model-serving infrastructure, so the video model you reach through it is the identical model you reach through Melius, Runway, Adobe Firefly, Krea or Google's own Flow, at the same published per-second rate. What changes is everything around the model: whether you need a cloud project to start, where the output lands, and how fast you can iterate."]}],["$","p","b6403",{"children":["One thing to know before you start comparing: Vertex AI isn't called that any more. At Cloud Next 2026 Google renamed the platform to Gemini Enterprise Agent Platform and Vertex AI Studio became Agent Studio. The marketing URL cloud.google.com/vertex-ai now lands on the Agent Platform product page, the model reference and Provisioned Throughput trees have moved, and the older doc paths still resolve while serving renamed content. Veo on Vertex AI is Veo on Gemini Enterprise Agent Platform. If you're evaluating it on a page that still uses the old name, check the date on the page."]}],["$","h2","b6405",{"id":"what-to-know-before-you-pick","className":"scroll-mt-28","children":["What to know before you pick"]}],["$","ul","b6407-parent",{"children":[["$","li","b6407",{"children":["The model is the same and so is the price. fal.ai charges Google's exact list rate for Veo 3.1, $0.20 a second silent and $0.40 with audio at 1080p, with no cloud project and no bucket. So Vertex is not the cheap route, it's the same route with more setup."]}],["$","li","b6409",{"children":["Audio doubles the cost on the flagship, and you pay for every clip the model successfully returns, usable or not. An 8-second Veo 3.1 clip at 1080p with audio is $3.20, so ten takes to land one shot is $32. Failed requests aren't charged, which is the one piece of good news in the billing model."]}],["$","li","b6411",{"children":["Veo on Vertex runs in a single region, us-central1, and takes English prompts only. Clips are 4, 6 or 8 seconds, in 16:9 or 9:16."]}],["$","li","b6413",{"children":["Google built Flow for exactly this reason. It's Google's own creative surface for Veo, it has a canvas, and it costs $19.99 a month, which tells you what Google thinks Vertex is for."]}]]}],["$","h2","b6415",{"id":"what-separates-a-creative-surface-from-an-inference-endpoint","className":"scroll-mt-28","children":["What separates a creative surface from an inference endpoint?"]}],["$","p","b6417",{"children":["Four questions, and the first one ends the evaluation for most creative teams before quality ever comes up."]}],["$","h3","b6419",{"children":["Can a creative start without a cloud project?"]}],["$","p","b6421",{"children":["Read Google's own prerequisites for generating a video on the platform. You sign in to or create a Google Cloud account. You select or create a project, which needs the Project Creator role. You enable the platform API, which needs either Owner or Service Usage Admin. Then, in the console, you set an output directory by browsing to a Cloud Storage bucket you have created."]}],"$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f","$L50","$L51","$L52","$L53","$L54","$L55","$L56","$L57","$L58","$L59","$L5a","$L5b","$L5c","$L5d","$L5e","$L5f","$L60","$L61","$L62","$L63","$L64","$L65","$L66","$L67","$L68","$L69","$L6a","$L6b","$L6c","$L6d","$L6e","$L6f","$L70"]}]
7:["$","section","related",{"className":"relative w-full pb-section bg-gray-background","children":[["$","$L3",null,{"color":"gray"}],["$","div",null,{"className":"relative z-10 mx-auto w-full max-w-300 px-5 lg:px-8","children":[["$","h2",null,{"className":"t-h-2 mb-12 text-center text-balance text-gray-dark-1","children":"Related Articles"}],["$","div",null,{"className":"mx-auto grid w-full max-w-max grid-cols-1 gap-11 md:grid-cols-2 lg:grid-cols-3","children":[["$","$L71","post-product-hero-shot",{"post":{"_key":"post-product-hero-shot","slug":"product-hero-shot","category":"guides","title":"How to generate a product hero shot on Melius","metaTitle":"How to make product photos with AI: the hero shot","isoDate":"2026-09-14","date":"September 14, 2026","readTime":"7 Min Read","excerpt":"Generate a product hero shot from a pack shot on Melius, and keep the product dimensionally and visually accurate instead of nearly right.","image":{"url":"/images/blog/product-hero-shot/cover.webp"},"authors":[{"name":"Melius Team"}],"faq":[{"question":"Can I use AI for product photography?","answer":"Yes, for hero shots, lifestyle scenes, background variants and channel-specific crops, generated from a pack shot you already have. What it does not do on its own is guarantee the product is accurate, which is why the workflow feeds in the product's real specifications and branding as separate inputs and ends with a check against the actual item."},{"question":"What is a product hero shot?","answer":"The main image a shopper sees first, on a listing, an ad or a landing page. It has to read at a glance and it has to look like the thing that arrives, which is why it's the shot where product fidelity matters most."},{"question":"Why does my logo come out wrong in AI product photos?","answer":"Because the model draws your logo from scratch on every generation. It rebuilds an approximation of everything in frame, and a logo is exactly the kind of arbitrary artwork that can't be inferred from context. Adding the logo file as its own reference node, and instructing the prompt not to redraw it, is the fix."},{"question":"Do I still need a photographer?","answer":"For the input, often yes. This workflow starts from a clean pack shot, and the quality of that photograph sets the ceiling on everything generated from it. What changes is the volume: one good pack shot can carry a season of scenes, ratios and variants that would each have been a separate setup."},{"question":"How do I keep a product consistent across many shots?","answer":"Build the canvas once on a single SKU until the output is right, then duplicate it and swap the inputs. Reusing the graph is what keeps the lighting and the framing from drifting between shots, and it's how high-volume teams produce variants at catalogue scale."},{"question":"What resolution should I generate product shots at?","answer":"2K or higher. Generating at 2K isn't the same as upscaling a 1K image afterwards: the model has more room to resolve fabric weave, embossed marks and label typography while it works, and upscaling later operates on an image whose fine detail is already gone. Note that the canvas preview is downscaled at any resolution, so judge sharpness from the full-screen view or the download."},{"question":"How much does generating product photos cost?","answer":"Generation runs on credits from one shared pool, whichever model a step uses, so trying the same shot on two models costs nothing extra in setup. Current plans and credit allowances are on the pricing page."}],"tableOfContents":[{"_key":"key-takeaways","title":"Key takeaways"},{"_key":"product-hero-shots-from-a-pack-shot","title":"Product hero shots from a pack shot"},{"_key":"why-generated-products-come-back-nearly-right","title":"Why generated products come back nearly right"},{"_key":"building-the-shot-step-by-step","title":"Building the shot, step by step"},{"_key":"where-product-shots-go-wrong","title":"Where product shots go wrong"},{"_key":"scaling-one-shot-across-a-catalogue","title":"Scaling one shot across a catalogue"},{"_key":"why-this-runs-the-way-it-does-on-melius","title":"Why this runs the way it does on Melius"},{"_key":"frequently-asked-questions","title":"FAQ"}],"content":[{"_type":"block","_key":"b6032","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6031","text":"Key takeaways","marks":[]}],"anchorId":"key-takeaways"},{"_type":"block","_key":"b6034","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6033","text":"A hero shot needs three separate inputs, not one prompt. A clean product shot, your product's real specifications, and a style reference each go in as their own node, and the prompt's job is mostly to say what must not change.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6036","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6035","text":"Branding is the part the model invents. An image model regenerates a logo rather than placing your logo file, so the mark comes back nearly right and specifically wrong. Give it the artwork as its own input and tell it not to redraw it.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6038","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6037","text":"A lifestyle photo is not a product reference. The model needs a clean, evenly lit view of the product itself. Mood references and product references do different jobs and go in separately.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6040","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6039","text":"Generate at 2K or higher, not 1K. Fine detail is where fidelity is won or lost: fabric weave, embossing, label type. More resolution gives the model more to work with on exactly those features.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6042","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6041","text":"Correct on the node, don't start over. When scale or placement is off, edit that node's prompt with the specific fix and re-run it. Re-prompting the whole canvas throws away the parts that worked.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6044","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6043","text":"Product hero shots from a pack shot","marks":[]}],"anchorId":"product-hero-shots-from-a-pack-shot"},{"_type":"block","_key":"b6046","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6045","text":"To generate a product hero shot on Melius, put a clean pack shot of the product on the canvas, add its real specifications and a style reference as separate inputs, connect all three into an image-to-image node at 2K, and write a prompt that names the scene while stating plainly that the product itself must not change. Then run three or four variations and inspect them full screen.","marks":[]}]},{"_type":"block","_key":"b6048","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6047","text":"The workflow is easy. Getting the product to look like your product is the part that takes practice, and it's the complaint marketers raise most often on onboarding calls. The shot is beautiful and the proportions are subtly off, or the logo resembles your logo, or the fabric drapes like a stock photo rather than like the thing you sell. Nearly all of that traces to one cause, and it's fixable.","marks":[]}]},{"_type":"block","_key":"b6050","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6049","text":"Why generated products come back nearly right","marks":[]}],"anchorId":"why-generated-products-come-back-nearly-right"},{"_type":"block","_key":"b6052","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6051","text":"An image model doesn't paste your product into a scene. Whatever falls inside the region it generates gets rebuilt as an approximation from what it can infer, so anything it can't infer gets invented. Your logo isn't a shape it can reason its way to, real proportions aren't recoverable from one photograph, and the weight and fall of your material isn't something a prompt adjective conveys.","marks":[]}]},{"_type":"block","_key":"b6054","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6053","text":"What fixes it is giving the model your actual assets as distinct inputs, then being explicit about which of them are fixed. Prompt wording alone won't get you there. Every step below removes one more thing from the set the model is guessing at.","marks":[]}]},{"_type":"block","_key":"b6056","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6055","text":"Building the shot, step by step","marks":[]}],"anchorId":"building-the-shot-step-by-step"},{"_type":"block","_key":"b6061","style":"normal","markDefs":[{"_type":"link","_key":"b6058","href":"https://docs.melius.com/help-center/marketers/recipes/product-swap","isNewTab":false}],"children":[{"_type":"span","_key":"b6057","text":"The click path is in the ","marks":[]},{"_type":"span","_key":"b6059","text":"help centre recipe for product photos and swaps","marks":["b6058"]},{"_type":"span","_key":"b6060","text":". The shape of the work is this:","marks":[]}]},{"_type":"block","_key":"b6063","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6062","text":"Drop your pack shot on the canvas. A clean product photo on a neutral background. If you have several angles, bring them all in and unified-group them, so the agent works from every angle rather than one.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6065","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6064","text":"Give the agent the real specifications. Ask it in chat to pull dimensions, materials and colour from your product page URL and save them as a text node. It now has your stated specs to work from rather than inferring everything from a photograph.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6067","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6066","text":"Add the logo as its own node. If the product carries visible branding, put the logo file on the canvas separately and connect it in. In the prompt, tell the model to use that reference exactly and not to redraw it.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6069","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6068","text":"Add a style reference for the look. A moodboard or a past campaign, turned into a style description. It governs light, composition and mood, and stays separate from everything describing the product.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6071","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6070","text":"Create an image-to-image node at 2K. Melius recommends Nano Banana Pro for material and lighting fidelity, and GPT Image 2 (High) where packaging text has to be legible (guidance current as of September 2026). Set the ratio you're shipping, and go 2K or 4K rather than 1K: the small features are the ones that give a shot away.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6073","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6072","text":"Wire the inputs to their jobs. Pack shot into the image input. Specifications, style description and logo into context. Then reference them by name in the prompt with @ mentions so the model knows which input governs what.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6075","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6074","text":"Write the prompt around what stays fixed. Name the scene in one line, then spend the rest on constraints: use the exact product from the reference, don't restyle it, don't change its colour, don't modify its shape or proportions.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6077","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6076","text":"Run three or four variations and inspect them full screen. The canvas preview is downscaled, and downscaling hides precisely the defects you're checking for. Open each candidate properly before you pick one.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6079","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6078","text":"Check the output against the actual item. Shape, colour, logo, any packaging text, proportions. A clean pack shot and real specs improve your odds; they do not remove the review step.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6081","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6080","text":"Where product shots go wrong","marks":[]}],"anchorId":"where-product-shots-go-wrong"},{"_type":"block","_key":"b6083","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6082","text":"A lifestyle photo was used as the product reference. The product is small, partly hidden and lit for mood, so the model never gets a clean look at it. Add a studio shot or a transparent PNG as a separate product input.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6085","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6084","text":"No specifications went in. Dimensions and materials get inferred from a single image, and the model has no way to know how big the thing is or what it's made of.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6087","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6086","text":"The logo was left to the model. Branding is the one element where close enough is still wrong, because anyone who knows the brand knows what the mark should look like. It needs to be an input, not an output.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6089","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6088","text":"The whole thing got re-prompted over one flaw. When the product is 20% too small or facing the wrong way, that's a one-clause correction on the existing node, not a fresh start.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6094","style":"normal","markDefs":[{"_type":"link","_key":"b6091","href":"https://docs.melius.com/help-center/marketers/picking-models","isNewTab":false}],"children":[{"_type":"span","_key":"b6090","text":"Typography and material were asked of one model. Rendering legible packaging copy and rendering convincing material are different problems, and a canvas can use a different model at each step. ","marks":[]},{"_type":"span","_key":"b6092","text":"Our per-job model guidance","marks":["b6091"]},{"_type":"span","_key":"b6093","text":" is in the help centre, and it changes as models ship.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6096","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6095","text":"Scaling one shot across a catalogue","marks":[]}],"anchorId":"scaling-one-shot-across-a-catalogue"},{"_type":"block","_key":"b6098","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6097","text":"Once a canvas produces a shot you'd ship, the graph is the asset. Duplicate it, swap the pack shot and the specifications for the next SKU, and the light, composition and constraints carry over. That's how a team working through a catalogue gets consistency instead of forty shots that each look slightly different.","marks":[]}]},{"_type":"block","_key":"b6100","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6099","text":"The neighbouring jobs start from the same graph: background variants for seasonal scenes, a swap to drop your product into a scene you already have, re-composition for each channel's ratio. Melius ships a Product Swapper preset for the swap once it becomes routine.","marks":[]}]},{"_type":"block","_key":"b6102","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6101","text":"Why this runs the way it does on Melius","marks":[]}],"anchorId":"why-this-runs-the-way-it-does-on-melius"},{"_type":"block","_key":"b6104","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6103","text":"Melius is the Agentic OS for creative work, built on a node-based canvas where each input and output is a node and edges pass one node's result into the next. That structure is what makes product fidelity tractable: the pack shot, the specifications, the logo and the style are four things the graph holds separately, so you change one without disturbing the other three and re-run everything downstream.","marks":[]}]},{"_type":"block","_key":"b6106","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6105","text":"You brief an agent in plain language and it wires the graph and runs the models. Every step stays open, so the prompt behind a nearly-right shot is right there to correct. You direct; the agent produces.","marks":[]}]},{"_type":"block","_key":"b6108","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6107","text":"The models are on one subscription. Melius spans a library of leading models for image, video and audio, and agents route each step to the strongest one for that step unless you choose per node.","marks":[]}]},{"_type":"block","_key":"b6110","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6109","text":"You own the content you create on Melius and can use, publish, and distribute it commercially, subject to the underlying model providers' terms. Melius doesn't claim ownership of your work and doesn't use it to train AI models.","marks":[]}]},{"_type":"block","_key":"b6118","style":"normal","markDefs":[{"_type":"link","_key":"b6112","href":"/blog/static-ad-from-style-reference","isNewTab":false},{"_type":"link","_key":"b6115","href":"/blog/nano-banana-image-models","isNewTab":false}],"children":[{"_type":"span","_key":"b6111","text":"For related workflows, see ","marks":[]},{"_type":"span","_key":"b6113","text":"building a static ad from a style reference","marks":["b6112"]},{"_type":"span","_key":"b6114","text":" and ","marks":[]},{"_type":"span","_key":"b6116","text":"choosing a Nano Banana model","marks":["b6115"]},{"_type":"span","_key":"b6117","text":".","marks":[]}]},{"_type":"block","_key":"b6120","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6119","text":"Frequently asked questions","marks":[]}],"anchorId":"frequently-asked-questions"},{"_type":"faqList","_key":"b6121","items":"$7:props:children:1:props:children:1:props:children:0:props:post:faq"},{"_type":"block","_key":"b6126","style":"normal","markDefs":[{"_type":"link","_key":"b6123","href":"https://app.melius.com","isNewTab":false}],"children":[{"_type":"span","_key":"b6122","text":"Have a pack shot and a product page? ","marks":[]},{"_type":"span","_key":"b6124","text":"Open Melius","marks":["b6123"]},{"_type":"span","_key":"b6125","text":" and build the canvas on one SKU first.","marks":[]}]}]}}],"$L72","$L73"]}]]}]]}]
