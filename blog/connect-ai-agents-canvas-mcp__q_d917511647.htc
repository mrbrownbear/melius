8:["$","$1","h",{"children":[null,["$","$L28",null,{"children":[["$","meta","0",{"charSet":"utf-8"}],["$","meta","1",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]}],["$","div",null,{"hidden":true,"children":["$","$L29",null,{"children":["$","$26",null,{"name":"Next.Metadata","children":[["$","title","0",{"children":"Connect Claude to a creative canvas with MCP"}],["$","meta","1",{"name":"description","content":"Connect Claude to a creative canvas over MCP and skip the context drift you get from copy-pasting into a chatbot. The Model Context Protocol exposes the Melius canvas as live, structured data an agent can read and act on. Here is how to connect Claude to Melius, what the tools actually are, and why the loop self-corrects."}],["$","link","2",{"rel":"canonical","href":"https://www.melius.com/blog/connect-ai-agents-canvas-mcp"}],["$","meta","3",{"property":"og:title","content":"Connect Claude to a creative canvas with MCP"}],["$","meta","4",{"property":"og:description","content":"Connect Claude to a creative canvas over MCP and skip the context drift you get from copy-pasting into a chatbot. The Model Context Protocol exposes the Melius canvas as live, structured data an agent can read and act on. Here is how to connect Claude to Melius, what the tools actually are, and why the loop self-corrects."}],["$","meta","5",{"property":"og:url","content":"https://www.melius.com/blog/connect-ai-agents-canvas-mcp"}],["$","meta","6",{"property":"og:site_name","content":"Melius"}],["$","meta","7",{"property":"og:image","content":"https://www.melius.com/blog/connect-ai-agents-canvas-mcp/opengraph-image?961bf8f0fa5edf72"}],["$","meta","8",{"property":"og:image:type","content":"image/png"}],["$","meta","9",{"property":"og:image:width","content":"1200"}],["$","meta","10",{"property":"og:image:height","content":"630"}],["$","meta","11",{"property":"og:image:alt","content":"Melius blog post"}],["$","meta","12",{"property":"og:type","content":"article"}],["