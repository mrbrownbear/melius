8:["$","$1","h",{"children":[null,["$","$L33",null,{"children":[["$","meta","0",{"charSet":"utf-8"}],["$","meta","1",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]}],["$","div",null,{"hidden":true,"children":["$","$L34",null,{"children":["$","$31",null,{"name":"Next.Metadata","children":[["$","title","0",{"children":"The Brief-to-Execution workflow for creative teams"}],["$","meta","1",{"name":"description","content":"One-shot prompting has a ceiling. The agencies that win aren't the ones with the best prompt. They're the ones that turn a single master brief into a full, on-brand campaign. Here is the Brief-to-Execution workflow, and how an orchestration layer like Melius splits the Labor of Execution from the Labor of Taste."}],["$","link","2",{"rel":"canonical","href":"https://www.melius.com/blog/brief-to-execution-workflow"}],["$","meta","3",{"property":"og:title","content":"The Brief-to-Execution workflow for creative teams"}],["$","meta","4",{"property":"og:description","content":"One-shot prompting has a ceiling. The agencies that win aren't the ones with the best prompt. They're the ones that turn a single master brief into a full, on-brand campaign. Here is the Brief-to-Execution workflow, and how an orchestration layer like Melius splits the Labor of Execution from the Labor of Taste."}],["$","meta","5",{"property":"og:url","content":"https://www.melius.com/blog/brief-to-execution-workflow"}],["$","meta","6",{"property":"og:site_name","content":"Melius"}],["$","meta","7",{"property":"og:image","content":"https://www.melius.com/blog/brief-to-execution-workflow/opengraph-image?961bf8f0fa5edf72"}],["$","meta","8",{"property":"og:image:type","content":"image/png"}],["$","meta","9",{"property":"og:image:width","content":"1200"}],["$","meta","10",{"property":"og:image:height","content":"630"}],["$","meta","11",{"property":"og:image:alt","content":"Melius blog post"}],["$","meta","12",{"property":"og:type","content":"article"}],["$","meta","