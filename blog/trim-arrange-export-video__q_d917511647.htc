13:["$","$1","c",{"children":[[["$","script","script-0",{"src":"/_next/static/immutable/chunks/29d69g982pymu.js","async":true}],["$","script","script-1",{"src":"/_next/static/immutable/chunks/0sog918pi80uv.js","async":true}],["$","script","script-2",{"src":"/_next/static/immutable/chunks/0zke7d8fy0v9q.js","async":true}],["$","script","script-3",{"src":"/_next/static/immutable/chunks/1xm1-c_qty48z.js","async":true}],["$","script","script-4",{"src":"/_next/static/immutable/chunks/08pto-z6i41o-.js","async":true}]],["$","$L38",null,{"Component":"$39","slots":{"children":["$","$L36",null,{"parallelRouterKey":"children","template":["$","$L37",null,{}]}]},"serverProvidedParams":{"params":{},"promises":["$@3a"]}}]]}]
