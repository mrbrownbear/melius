2:T98a,{"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","@id":"https://www.melius.com/blog/trim-arrange-export-video#article","headline":"How to trim, arrange and export video on Melius","description":"Video editing on Melius: trim and arrange clips, layer picture and audio, adjust speed and effects, and render the finished sequence as an MP4 without leaving the workspace.","url":"https://www.melius.com/blog/trim-arrange-export-video","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.melius.com/blog/trim-arrange-export-video"},"datePublished":"2026-09-16","dateModified":"2026-09-16","author":{"@type":"Organization","name":"Melius Team","url":"https://www.melius.com"},"publisher":{"@id":"https://www.melius.com/#organization"},"isPartOf":{"@id":"https://www.melius.com/#website"},"inLanguage":"en-US","image":"https://www.melius.com/images/blog/trim-arrange-export-video/cover.webp","timeRequired":"PT6M","wordCount":959,"articleSection":"Guides","keywords":"Guides"},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Blog","item":"https://www.melius.com/blog"},{"@type":"ListItem","position":2,"name":"How to trim, arrange and export video on Melius","item":"https://www.melius.com/blog/trim-arrange-export-video"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I trim and split videos on Melius?","acceptedAnswer":{"@type":"Answer","text":"Yes. The multi-track editor supports trimming clip boundaries and splitting clips, so you can keep the useful section of a take and arrange it within a larger sequence."}},{"@type":"Question","name":"Can I combine video, text and audio?","acceptedAnswer":{"@type":"Answer","text":"Yes. The timeline supports multiple tracks for assembling footage with still images, text and audio. Clip controls let you adjust the components of the cut separately."}},{"@type":"Question","name":"Can I change a clip's speed?","acceptedAnswer":{"@type":"Answer","text":"Yes. The editor has playback-speed controls, with pitch-preserving audio handling. Changing speed affects the clip's timing, so review the surrounding sequence afterwards."}},{"@type":"Question","name":"Which video file types can I export?","acceptedAnswer":{"@type":"Answer","text":"The verified Stitch output is MP4. Multiple video export types are not established by this workflow; a different delivery format requires a separate supported conversion step."}}]}]}d:X
