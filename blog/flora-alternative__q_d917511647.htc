reground px-4 py-3.5","children":[["$","p","b1005",{"children":["Stress-tested past 200 nodes"]}]]}],["$","td","b9992",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b1008",{"children":["Strains as the graph grows"]}]]}]]}],["$","tr","b1009",{"className":"border-t border-black/10","children":[["$","td","b10090",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b1012",{"children":["Find your own assets"]}]]}],["$","td","b10091",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b1015",{"children":["Semantic asset search"]}]]}],["$","td","b10092",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b1018",{"children":["File library, no semantic search"]}]]}]]}],["$","tr","b1019",{"className":"border-t border-black/10","children":[["$","td","b10190",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b1022",{"children":["Agent in Slack"]}]]}],["$","td","b10191",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b1025",{"children":["Full workflow in a thread"]}]]}],["$","td","b10192",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b1028",{"children":["Browser tab only"]}]]}]]}],["$","tr","b1029",{"className":"border-t border-black/10","children":[["$","td","b10290",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b1032",{"children":["Multiple agents at once"]}]]}],["$","td","b10291",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b1035",{"children":["Yes, with visible presence"]}]]}],["$","td","b10292",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b1038",{"children":["One at a time"]}]]}]]}],["$","tr","b1039",{"className":"border-t border-black/10","children":[["$","td","b10390",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":"$L2d"}],"$L2e","$L2f"]}]]}]}]}]
