31:["$","tr","b910",{"className":"border-t border-black/10","children":[["$","td","b9100",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b913",{"children":["Camera / motion control"]}]]}],["$","td","b9101",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b916",{"children":["Prompt-driven"]}]]}],["$","td","b9102",{"className":"t-b-3 min-w-48 align-top [&_p]:m-0 text-foreground px-4 py-3.5","children":[["$","p","b919",{"children":["Dedicated controls (a real strength)"]}]]}]]}]
