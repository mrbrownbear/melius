2:T9b6,{"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","@id":"https://www.melius.com/blog/text-to-speech-voiceover#article","headline":"How to turn a script into a natural voiceover on Melius","description":"Text to speech on Melius: turn a written script into a voiceover, direct the delivery, compare takes and balance the audio in your video. Here is what each control does.","url":"https://www.melius.com/blog/text-to-speech-voiceover","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.melius.com/blog/text-to-speech-voiceover"},"datePublished":"2026-09-16","dateModified":"2026-09-16","author":{"@type":"Organization","name":"Melius Team","url":"https://www.melius.com"},"publisher":{"@id":"https://www.melius.com/#organization"},"isPartOf":{"@id":"https://www.melius.com/#website"},"inLanguage":"en-US","image":"https://www.melius.com/images/blog/text-to-speech-voiceover/cover.webp","timeRequired":"PT6M","wordCount":962,"articleSection":"Guides","keywords":"Guides"},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Blog","item":"https://www.melius.com/blog"},{"@type":"ListItem","position":2,"name":"How to turn a script into a natural voiceover on Melius","item":"https://www.melius.com/blog/text-to-speech-voiceover"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can Melius turn written text into speech?","acceptedAnswer":{"@type":"Answer","text":"Yes. Audio nodes support text-to-speech models, so you can generate a spoken recording from a script and use it alongside your other creative assets."}},{"@type":"Question","name":"Can I control the emotion in a voiceover?","acceptedAnswer":{"@type":"Answer","text":"You can steer expressive delivery using the settings and instructions supported by the selected model. The controls differ between models, and the result still needs a listen before it goes into the final cut."}},{"@type":"Question","name":"Can I change the voiceover volume?","acceptedAnswer":{"@type":"Answer","text":"Yes. The multi-track editor has clip volume controls for balancing the generated voice against music and other audio. That changes its level in the mix, not the original performance."}},{"@type":"Question","name":"Is voice selection the same as pitch control?","acceptedAnswer":{"@type":"Answer","text":"No. Selecting a voice changes the starting voice; pitch shifting changes the pitch of a recording. Don't treat one as evidence that the other is available."}}]}]}d:X
