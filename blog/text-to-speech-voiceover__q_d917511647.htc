8:["$","div",null,{"className":"relative z-10 mx-auto mt-16 grid w-full max-w-[1360px] grid-cols-1 gap-8 md:mt-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,860px)_minmax(0,1fr)] lg:gap-0","children":[["$","aside",null,{"className":"hidden lg:col-start-1 lg:block lg:justify-self-end lg:pr-4","children":["$","div",null,{"className":"bg-white sticky top-28 w-52 rounded-2xl p-6","children":["$","$L17",null,{"sections":[{"_key":"a-natural-voiceover-starts-with-the-read","title":"A natural voiceover starts with the read"},{"_key":"what-to-know-before-you-generate","title":"What to know before you generate"},{"_key":"what-actually-changes-the-sound","title":"What actually changes the sound"},{"_key":"building-the-voiceover-step-by-step","title":"Building the voiceover, step by step"},{"_key":"why-this-belongs-on-the-canvas","title":"Why this belongs on the canvas"},{"_key":"frequently-asked-questions","title":"FAQ"}],"className":"w-full flex-col gap-4 overflow-visible md:static","linkClassName":"t-b-3 !font-semibold text-foreground-muted leading-snug transition-colors hover:text-gray-dark-1","activeLinkClassName":"text-orange"}]}]}],["$","div",null,{"className":"wysiwyg bg-white w-full min-w-0 rounded-3xl p-6 md:p-10 lg:col-start-2 lg:p-12","children":[["$","h2","b6128",{"id":"a-natural-voiceover-starts-with-the-read","className":"scroll-mt-28","children":["A natural voiceover starts with the read"]}],["$","p","b6130",{"children":["Start with how the line should land, because a voice that sounds human can still sound completely wrong for the work. A product explanation needs someone who sounds like they understand the product. A campaign film needs a performance. A tutorial needs a voice that doesn't turn every instruction into a sales pitch. Those are different reads, even when the words are identical."]}],["$","p","b6132",{"children":["On Melius, you turn a written script into speech on an audio node, choose the model and voice, and adjust the delivery before putting the result beside the picture. The script, the generated takes and the rest of the campaign can live on the same canvas. You're not downloading a voiceover from one tool to find out in another that the last sentence doesn't fit."]}],["$","p","b6134",{"children":["The useful distinction is between generating the performance and mixing the recording. Emotion belongs to the first. Volume in the finished video belongs to the second. Treating them as the same control is how a quiet read becomes a loud quiet read instead of a more confident one."]}],["$","h2","b6136",{"id":"what-to-know-before-you-generate","className":"scroll-mt-28","children":["What to know before you generate"]}],["$","ol","b6139-parent",{"children":[["$","li","b6139",{"children":[["$","strong","b6137",{"children":["Write for someone speaking."]}]," A sentence that reads well on a landing page can be hard to follow aloud. Shorten the clauses before trying to fix the voice."]}],["$","li","b6142",{"children":[["$","strong","b6140",{"children":["Choose the voice before refining the delivery."]}]," A naturally restrained voice and an energetic one won't respond to the same direction in the same way."]}],["$","li","b6145",{"children":[["$","strong","b6143",{"children":["Controls depend on the model."]}]," Melius carries several speech models, not one universal set of voice settings."]}],["$","li","b6148",{"children":[["$","strong","b6146",{"children":["Judge the voice against the picture."]}]," A take that sounds right alone may rush the reveal or leave the closing frame waiting."]}]]}],["$","h2","b6150",{"id":"what-actually-changes-the-sound","className":"scroll-mt-28","children":["What actually changes the sound"]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c"]}]]}]
9:["$","section","related",{"className":"relative w-full pb-section bg-gray-background","children":[["$","$L3",null,{"color":"gray"}],["$","div",null,{"className":"relative z-10 mx-auto w-full max-w-300 px-5 lg:px-8","children":[["$","h2",null,{"className":"t-h-2 mb-12 text-center text-balance text-gray-dark-1","children":"Related Articles"}],["$","div",null,{"className":"mx-auto grid w-full max-w-max grid-cols-1 gap-11 md:grid-cols-2 lg:grid-cols-3","children":[["$","$L2d","post-video-asset-management",{"post":{"_key":"post-video-asset-management","slug":"video-asset-management","category":"guides","title":"How to organize and share video assets on Melius","isoDate":"2026-09-16","date":"September 16, 2026","readTime":"6 Min Read","excerpt":"Video asset management on Melius: store footage, organize it with folders and tags, inspect metadata and share the right version without losing the context behind it.","image":{"url":"/images/blog/video-asset-management/cover.webp"},"authors":[{"name":"Melius Team"}],"faq":[{"question":"Can I store and organize video files on Melius?","answer":"Yes. The asset library supports video alongside other media, with folders, names, tags, search and filtering to help organize the collection."},{"question":"Can I filter videos by more than one tag?","answer":"Yes. An asset must carry every selected tag to match. Use that to narrow a collection by several properties, such as a product and a shot type."},{"question":"What metadata can I inspect?","answer":"Available details include dimensions, duration, file size and creation time. Generated assets can also carry recorded prompt and model or tool information. The fields shown depend on the asset and the information available for it."},{"question":"Can I share assets with someone outside my team?","answer":"Yes. You can share assets with anyone on the internet using a public link. They don't need a Melius account to view them."},{"question":"Can I search for an asset without knowing its filename?","answer":"Yes. Semantic search on Professional and Enterprise lets you describe what you're looking for instead of remembering a filename. Search by the content of the asset, then inspect the matching results."}],"tableOfContents":[{"_key":"a-video-library-should-tell-you-which-clip-to-use","title":"A video library should tell you which clip to use"},{"_key":"what-to-know-before-you-organize-it","title":"What to know before you organize it"},{"_key":"give-the-footage-a-home-then-make-it-findable","title":"Give the footage a home, then make it findable"},{"_key":"find-the-shot-by-describing-it","title":"Find the shot by describing it"},{"_key":"metadata-is-how-you-check-the-candidate","title":"Metadata is how you check the candidate"},{"_key":"share-assets-with-anyone-on-the-internet","title":"Share assets with anyone on the internet"},{"_key":"setting-up-a-campaign-library","title":"Setting up a campaign library"},{"_key":"why-the-library-belongs-beside-the-work","title":"Why the library belongs beside the work"},{"_key":"frequently-asked-questions","title":"FAQ"}],"content":[{"_type":"block","_key":"b6222","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6221","text":"A video library should tell you which clip to use","marks":[]}],"anchorId":"a-video-library-should-tell-you-which-clip-to-use"},{"_type":"block","_key":"b6224","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6223","text":"The useful test of a video library isn't whether it can hold the footage. It's whether someone who didn't make the footage can find the right clip, tell what it is, and send the right version to somebody else. Storage solves the first afternoon. Organization solves the next six months.","marks":[]}]},{"_type":"block","_key":"b6226","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6225","text":"On Melius, video sits alongside images and audio in the asset library. You can organize media in folders, apply tags, search and filter the collection, inspect file details, and share assets. The library is part of the creative workspace, so the footage you keep is also footage you can bring back into the canvas.","marks":[]}]},{"_type":"block","_key":"b6228","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6227","text":"That matters once a campaign stops being one video. There are source clips, generated takes, alternate openings, channel variants and finished cuts. If all of them are named after the order they were downloaded, the team hasn't built a library. It's built a sorting task for the next person.","marks":[]}]},{"_type":"block","_key":"b6230","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6229","text":"What to know before you organize it","marks":[]}],"anchorId":"what-to-know-before-you-organize-it"},{"_type":"block","_key":"b6233","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6231","text":"Folders and tags answer different questions.","marks":["strong"]},{"_type":"span","_key":"b6232","text":" A folder gives a file a home. Tags let you find it by the other things it belongs to.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6236","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6234","text":"A thumbnail isn't enough information.","marks":["strong"]},{"_type":"span","_key":"b6235","text":" Duration, dimensions and source matter when two clips look almost identical.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6239","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6237","text":"Share beyond your team.","marks":["strong"]},{"_type":"span","_key":"b6238","text":" Public links let anyone on the internet view an asset without a Melius account.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6242","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6240","text":"You don't have to remember the filename.","marks":["strong"]},{"_type":"span","_key":"b6241","text":" Semantic search on Professional and Enterprise finds assets from a description of their content.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6244","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6243","text":"Give the footage a home, then make it findable","marks":[]}],"anchorId":"give-the-footage-a-home-then-make-it-findable"},{"_type":"block","_key":"b6246","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6245","text":"Folders work well for the structure everyone already knows: a campaign, a product line, a client. Tags work well for the properties that cut across that structure: product close-up, interview, summer launch, vertical.","marks":[]}]},{"_type":"block","_key":"b6248","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6247","text":"For example, a close-up of a bottle might live in a launch folder while carrying tags for the product and the shot type. When the next campaign needs that bottle, the team shouldn't have to remember which launch it first appeared in. The tags are how the asset escapes the limits of its folder without being duplicated into five more folders.","marks":[]}]},{"_type":"block","_key":"b6253","style":"normal","markDefs":[{"_type":"link","_key":"b6250","href":"https://docs.melius.com/help-center/marketers/assets","isNewTab":false}],"children":[{"_type":"span","_key":"b6249","text":"Melius supports file-type and tag filtering for media assets. Selecting several tags narrows the results to assets carrying all of them, which makes the combination useful for finding a specific set. Choose video, then the product tag and the shot tag, and you're looking at the intersection rather than everything loosely related to either word. The ","marks":[]},{"_type":"span","_key":"b6251","text":"asset library guide","marks":["b6250"]},{"_type":"span","_key":"b6252","text":" covers the filtering and sorting controls.","marks":[]}]},{"_type":"block","_key":"b6255","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6254","text":"Keep the vocabulary small enough that people use it consistently. Product-closeup and product-detail may mean the same thing to the person uploading and different things to the person searching. A tagging system only helps if the team agrees what the tags mean.","marks":[]}]},{"_type":"block","_key":"b6257","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6256","text":"Find the shot by describing it","marks":[]}],"anchorId":"find-the-shot-by-describing-it"},{"_type":"block","_key":"b6259","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6258","text":"Semantic search is available on Professional and Enterprise. Describe what you're looking for in the asset search bar instead of trying to remember what somebody named the file.","marks":[]}]},{"_type":"block","_key":"b6261","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6260","text":"The difference is what the search understands. A filename search needs words from the name. Semantic search uses the content of the asset, so you can try \"a close-up of a bottle on a dark background\" when all you remember is the shot. You don't need to have put that description in the filename or added it as a tag first.","marks":[]}]},{"_type":"block","_key":"b6263","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6262","text":"That becomes useful when the library belongs to a team. The person looking for footage often isn't the person who uploaded it, and nobody remembers the names of every take. Describing the scene gives them a way into the collection without asking whoever made it to find the file.","marks":[]}]},{"_type":"block","_key":"b6265","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6264","text":"Tags still do a different job. Use them for the labels your team has agreed on, such as a campaign or a product line. Use semantic search when you know what the asset contains but not what it's called. Open the matches and check the footage before you choose one.","marks":[]}]},{"_type":"block","_key":"b6267","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6266","text":"Metadata is how you check the candidate","marks":[]}],"anchorId":"metadata-is-how-you-check-the-candidate"},{"_type":"block","_key":"b6269","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6268","text":"Tags describe the job a file does. Metadata describes the file itself. You want both, because finding a clip called homepage hero doesn't tell you whether it's the right dimensions or the right length.","marks":[]}]},{"_type":"block","_key":"b6271","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6270","text":"The asset details view can show dimensions, duration, file size and creation time when those details are available. For generated assets, recorded generation information can also identify the model or tool and the prompt behind the result. Uploaded footage has a different history, and shouldn't be presented as though it came from a generation.","marks":[]}]},{"_type":"block","_key":"b6273","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6272","text":"This is the step that saves the wrong clip from making it into the edit. Open the candidate, inspect the details and play it. Two takes can share an opening frame while differing in the one second that matters.","marks":[]}]},{"_type":"block","_key":"b6275","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6274","text":"Metadata here means information you can inspect about an asset. It doesn't mean that every field is an editable custom field, or that the library automatically understands your campaign taxonomy. Tags are where your team's own labels belong.","marks":[]}]},{"_type":"block","_key":"b6277","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6276","text":"Share assets with anyone on the internet","marks":[]}],"anchorId":"share-assets-with-anyone-on-the-internet"},{"_type":"block","_key":"b6279","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6278","text":"You can share assets with anyone on the internet. Open the asset, click Share and send the public link. The recipient doesn't need a Melius account to view it.","marks":[]}]},{"_type":"block","_key":"b6281","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6280","text":"That makes a clip easy to send to a client, a collaborator or someone who just needs to see the work. The asset stays in your library; the link is what you pass along.","marks":[]}]},{"_type":"block","_key":"b6283","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6282","text":"Setting up a campaign library","marks":[]}],"anchorId":"setting-up-a-campaign-library"},{"_type":"block","_key":"b6286","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6284","text":"Bring the footage into Assets.","marks":["strong"]},{"_type":"span","_key":"b6285","text":" Keep useful source material alongside the generated clips the campaign produces, rather than treating the library as a folder for finished exports only.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6289","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6287","text":"Name and file the assets.","marks":["strong"]},{"_type":"span","_key":"b6288","text":" Use names someone else could search for, and folders that reflect the way the team already groups its work.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6292","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6290","text":"Apply a small set of tags.","marks":["strong"]},{"_type":"span","_key":"b6291","text":" Start with the product, campaign or shot type. Add labels because they answer a retrieval question, not because every file needs more labels.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6295","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6293","text":"Check the details before reuse.","marks":["strong"]},{"_type":"span","_key":"b6294","text":" Filter to video, narrow by the relevant tags, and inspect the candidate's length and dimensions before placing it on the canvas.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6298","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6296","text":"Share with anyone.","marks":["strong"]},{"_type":"span","_key":"b6297","text":" Send a public asset link to anyone on the internet. They don't need a Melius account to view it.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6300","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6299","text":"Why the library belongs beside the work","marks":[]}],"anchorId":"why-the-library-belongs-beside-the-work"},{"_type":"block","_key":"b6302","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6301","text":"A stored clip becomes more valuable when it can be used again without rebuilding the context around it. Melius connects asset management to a node-based creative canvas, so a reference or a finished shot can become an input to the next piece of work.","marks":[]}]},{"_type":"block","_key":"b6310","style":"normal","markDefs":[{"_type":"link","_key":"b6304","href":"/blog/modern-creative-workflow-tools","isNewTab":false},{"_type":"link","_key":"b6307","href":"/blog/ai-video-generators-filmmakers-compared","isNewTab":false}],"children":[{"_type":"span","_key":"b6303","text":"That's the same argument behind the ","marks":[]},{"_type":"span","_key":"b6305","text":"modern creative workflow","marks":["b6304"]},{"_type":"span","_key":"b6306","text":": the time goes into moving and reconciling material as much as making it. For video specifically, the ","marks":[]},{"_type":"span","_key":"b6308","text":"filmmaker's comparison","marks":["b6307"]},{"_type":"span","_key":"b6309","text":" looks at what happens between generating a shot and finishing a sequence.","marks":[]}]},{"_type":"block","_key":"b6312","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6311","text":"Frequently asked questions","marks":[]}],"anchorId":"frequently-asked-questions"},{"_type":"faqList","_key":"b6313","items":"$9:props:children:1:props:children:1:props:children:0:props:post:faq"},{"_type":"block","_key":"b6318","style":"normal","markDefs":[{"_type":"link","_key":"b6315","href":"https://app.melius.com","isNewTab":false}],"children":[{"_type":"span","_key":"b6314","text":"Open ","marks":[]},{"_type":"span","_key":"b6316","text":"Melius","marks":["b6315"]},{"_type":"span","_key":"b6317","text":" with one campaign's footage. Give it names and tags that someone else could find without asking you.","marks":[]}]}]}}],"$L2e","$L2f"]}]]}]]}]
