10:["$","$1","h",{"children":[null,["$","$L3b",null,{"children":[["$","meta","0",{"charSet":"utf-8"}],["$","meta","1",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]}],["$","div",null,{"hidden":true,"children":["$","$L3c",null,{"children":["$","$39",null,{"name":"Next.Metadata","children":[["$","title","0",{"children":"How to organize and share video assets on Melius"}],["$","meta","1",{"name":"description","content":"Video asset management on Melius: store footage, organize it with folders and tags, inspect metadata and share the right version without losing the context behind it."}],["$","link","2",{"rel":"canonical","href":"https://www.melius.com/blog/video-asset-management"}],["$","meta","3",{"property":"og:title","content":"How to organize and share video assets on Melius"}],["$","meta","4",{"property":"og:description","content":"Video asset management on Melius: store footage, organize it with folders and tags, inspect metadata and share the right version without losing the context behind it."}],["$","meta","5",{"property":"og:url","content":"https://www.melius.com/blog/video-asset-management"}],["$","meta","6",{"property":"og:site_name","content":"Melius"}],["$","meta","7",{"property":"og:image","content":"https://www.melius.com/blog/video-asset-management/opengraph-image?961bf8f0fa5edf72"}],["$","meta","8",{"property":"og:image:type","content":"image/png"}],["$","meta","9",{"property":"og:image:width","content":"1200"}],["$","meta","10",{"property":"og:image:height","content":"630"}],["$","meta","11",{"property":"og:image:alt","content":"Melius blog post"}],["$","meta","12",{"property":"og:type","content":"article"}],["$","meta","13",{"property":"article:published_time","content":"2026-09-16"}],["$","meta","14",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","15",{"name":"twitter:title","content":"How to organize and share video assets on Melius"}],["$","meta","16",{"name":"twitter:description","content":"Video asset management on Melius: store footage, organize it with folders and tags, inspect metadata and share the right version without losing the context behind it."}],["$","meta","17",{"name":"twitter:image","content":"https://www.melius.com/blog/video-asset-management/opengraph-image?961bf8f0fa5edf72"}],["$","meta","18",{"name":"twitter:image:alt","content":"Melius blog post"}],["$","meta","19",{"name":"twitter:image:type","content":"image/png"}],["$","meta","20",{"name":"twitter:image:width","content":"1200"}],["$","meta","21",{"name":"twitter:image:height","content":"630"}],["$","link","22",{"rel":"icon","href":"/icon.png?icon.1w6r-fknzpnk2.png","sizes":"256x256","type":"image/png"}],["$","$L3d","23",{}]]}]}]}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}]
