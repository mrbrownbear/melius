3:I[40891,["/_next/static/immutable/chunks/176631nmv93q8.js","/_next/static/immutable/chunks/20pevlmjlhelo.js","/_next/static/immutable/chunks/1chr4r7q0x6jr.js","/_next/static/immutable/chunks/3c0zy4y93486l.js","/_next/static/immutable/chunks/06w2rvx3-kxxg.js","/_next/static/immutable/chunks/2qicka26b4zda.js","/_next/static/immutable/chunks/2_1it5ua3j5ir.js","/_next/static/immutable/chunks/29d69g982pymu.js","/_next/static/immutable/chunks/0sog918pi80uv.js","/_next/static/immutable/chunks/0zke7d8fy0v9q.js","/_next/static/immutable/chunks/1xm1-c_qty48z.js","/_next/static/immutable/chunks/08pto-z6i41o-.js","/_next/static/immutable/chunks/200nhymd1sxma.js"],"default"]
2:Taae,{"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","@id":"https://www.melius.com/blog/video-asset-management#article","headline":"How to organize and share video assets on Melius","description":"Video asset management on Melius: store footage, organize it with folders and tags, inspect metadata and share the right version without losing the context behind it.","url":"https://www.melius.com/blog/video-asset-management","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.melius.com/blog/video-asset-management"},"datePublished":"2026-09-16","dateModified":"2026-09-16","author":{"@type":"Organization","name":"Melius Team","url":"https://www.melius.com"},"publisher":{"@id":"https://www.melius.com/#organization"},"isPartOf":{"@id":"https://www.melius.com/#website"},"inLanguage":"en-US","image":"https://www.melius.com/images/blog/video-asset-management/cover.webp","timeRequired":"PT6M","wordCount":1144,"articleSection":"Guides","keywords":"Guides"},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Blog","item":"https://www.melius.com/blog"},{"@type":"ListItem","position":2,"name":"How to organize and share video assets on Melius","item":"https://www.melius.com/blog/video-asset-management"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I store and organize video files on Melius?","acceptedAnswer":{"@type":"Answer","text":"Yes. The asset library supports video alongside other media, with folders, names, tags, search and filtering to help organize the collection."}},{"@type":"Question","name":"Can I filter videos by more than one tag?","acceptedAnswer":{"@type":"Answer","text":"Yes. An asset must carry every selected tag to match. Use that to narrow a collection by several properties, such as a product and a shot type."}},{"@type":"Question","name":"What metadata can I inspect?","acceptedAnswer":{"@type":"Answer","text":"Available details include dimensions, duration, file size and creation time. Generated assets can also carry recorded prompt and model or tool information. The fields shown depend on the asset and the information available for it."}},{"@type":"Question","name":"Can I share assets with someone outside my team?","acceptedAnswer":{"@type":"Answer","text":"Yes. You can share assets with anyone on the internet using a public link. They don't need a Melius account to view them."}},{"@type":"Question","name":"Can I search for an asset without knowing its filename?","acceptedAnswer":{"@type":"Answer","text":"Yes. Semantic search on Professional and Enterprise lets you describe what you're looking for instead of remembering a filename. Search by the content of the asset, then inspect the matching results."}}]}]}f:X
