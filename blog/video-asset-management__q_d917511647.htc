a:["$","div",null,{"className":"relative z-10 mx-auto mt-16 grid w-full max-w-[1360px] grid-cols-1 gap-8 md:mt-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,860px)_minmax(0,1fr)] lg:gap-0","children":[["$","aside",null,{"className":"hidden lg:col-start-1 lg:block lg:justify-self-end lg:pr-4","children":["$","div",null,{"className":"bg-white sticky top-28 w-52 rounded-2xl p-6","children":["$","$L1a",null,{"sections":[{"_key":"a-video-library-should-tell-you-which-clip-to-use","title":"A video library should tell you which clip to use"},{"_key":"what-to-know-before-you-organize-it","title":"What to know before you organize it"},{"_key":"give-the-footage-a-home-then-make-it-findable","title":"Give the footage a home, then make it findable"},{"_key":"find-the-shot-by-describing-it","title":"Find the shot by describing it"},{"_key":"metadata-is-how-you-check-the-candidate","title":"Metadata is how you check the candidate"},{"_key":"share-assets-with-anyone-on-the-internet","title":"Share assets with anyone on the internet"},{"_key":"setting-up-a-campaign-library","title":"Setting up a campaign library"},{"_key":"why-the-library-belongs-beside-the-work","title":"Why the library belongs beside the work"},{"_key":"frequently-asked-questions","title":"FAQ"}],"className":"w-full flex-col gap-4 overflow-visible md:static","linkClassName":"t-b-3 !font-semibold text-foreground-muted leading-snug transition-colors hover:text-gray-dark-1","activeLinkClassName":"text-orange"}]}]}],["$","div",null,{"className":"wysiwyg bg-white w-full min-w-0 rounded-3xl p-6 md:p-10 lg:col-start-2 lg:p-12","children":[["$","h2","b6222",{"id":"a-video-library-should-tell-you-which-clip-to-use","className":"scroll-mt-28","children":["A video library should tell you which clip to use"]}],["$","p","b6224",{"children":["The useful test of a video library isn't whether it can hold the footage. It's whether someone who didn't make the footage can find the right clip, tell what it is, and send the right version to somebody else. Storage solves the first afternoon. Organization solves the next six months."]}],["$","p","b6226",{"children":["On Melius, video sits alongside images and audio in the asset library. You can organize media in folders, apply tags, search and filter the collection, inspect file details, and share assets. The library is part of the creative workspace, so the footage you keep is also footage you can bring back into the canvas."]}],["$","p","b6228",{"children":["That matters once a campaign stops being one video. There are source clips, generated takes, alternate openings, channel variants and finished cuts. If all of them are named after the order they were downloaded, the team hasn't built a library. It's built a sorting task for the next person."]}],["$","h2","b6230",{"id":"what-to-know-before-you-organize-it","className":"scroll-mt-28","children":["What to know before you organize it"]}],["$","ol","b6233-parent",{"children":[["$","li","b6233",{"children":[["$","strong","b6231",{"children":["Folders and tags answer different questions."]}]," A folder gives a file a home. Tags let you find it by the other things it belongs to."]}],["$","li","b6236",{"children":[["$","strong","b6234",{"children":["A thumbnail isn't enough information."]}]," Duration, dimensions and source matter when two clips look almost identical."]}],["$","li","b6239",{"children":[["$","strong","b6237",{"children":["Share beyond your team."]}]," Public links let anyone on the internet view an asset without a Melius account."]}],["$","li","b6242",{"children":[["$","strong","b6240",{"children":["You don't have to remember the filename."]}]," Semantic search on Professional and Enterprise finds assets from a description of their content."]}]]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34"]}]]}]
b:["$","section","related",{"className":"relative w-full pb-section bg-gray-background","children":[["$","$L3",null,{"color":"gray"}],["$","div",null,{"className":"relative z-10 mx-auto w-full max-w-300 px-5 lg:px-8","children":[["$","h2",null,{"className":"t-h-2 mb-12 text-center text-balance text-gray-dark-1","children":"Related Articles"}],["$","div",null,{"className":"mx-auto grid w-full max-w-max grid-cols-1 gap-11 md:grid-cols-2 lg:grid-cols-3","children":[["$","$L35","post-trim-arrange-export-video",{"post":{"_key":"post-trim-arrange-export-video","slug":"trim-arrange-export-video","category":"guides","title":"How to trim, arrange and export video on Melius","isoDate":"2026-09-16","date":"September 16, 2026","readTime":"6 Min Read","excerpt":"Video editing on Melius: trim and arrange clips, layer picture and audio, adjust speed and effects, and render the finished sequence as an MP4 without leaving the workspace.","image":{"url":"/images/blog/trim-arrange-export-video/cover.webp"},"authors":[{"name":"Melius Team"}],"faq":[{"question":"Can I trim and split videos on Melius?","answer":"Yes. The multi-track editor supports trimming clip boundaries and splitting clips, so you can keep the useful section of a take and arrange it within a larger sequence."},{"question":"Can I combine video, text and audio?","answer":"Yes. The timeline supports multiple tracks for assembling footage with still images, text and audio. Clip controls let you adjust the components of the cut separately."},{"question":"Can I change a clip's speed?","answer":"Yes. The editor has playback-speed controls, with pitch-preserving audio handling. Changing speed affects the clip's timing, so review the surrounding sequence afterwards."},{"question":"Which video file types can I export?","answer":"The verified Stitch output is MP4. Multiple video export types are not established by this workflow; a different delivery format requires a separate supported conversion step."}],"tableOfContents":[{"_key":"a-good-clip-isn-t-a-finished-video","title":"A good clip isn't a finished video"},{"_key":"keep-the-useful-part-of-each-take","title":"Keep the useful part of each take"},{"_key":"arrange-the-shots-around-the-idea","title":"Arrange the shots around the idea"},{"_key":"manipulate-the-clip-without-losing-the-cut","title":"Manipulate the clip without losing the cut"},{"_key":"save-the-edit-render-the-deliverable","title":"Save the edit, render the deliverable"},{"_key":"building-the-cut-step-by-step","title":"Building the cut, step by step"},{"_key":"why-generation-and-editing-belong-together","title":"Why generation and editing belong together"},{"_key":"frequently-asked-questions","title":"FAQ"}],"content":[{"_type":"block","_key":"b6320","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6319","text":"A good clip isn't a finished video","marks":[]}],"anchorId":"a-good-clip-isn-t-a-finished-video"},{"_type":"block","_key":"b6322","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6321","text":"Start with the sequence, because the shot that looks best on its own isn't always the shot the edit needs. An opening has to earn the next few seconds. A product detail has to arrive when the voice mentions it. A closing frame needs enough time to read. None of those decisions gets made by generating another attractive clip.","marks":[]}]},{"_type":"block","_key":"b6324","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6323","text":"Melius includes an in-app multi-track editor for turning individual assets into a cut. You can trim and split clips, arrange them on a timeline, layer picture and audio, change playback speed and apply effects or transitions. The finished sequence renders through Stitch and can be downloaded as an MP4.","marks":[]}]},{"_type":"block","_key":"b6326","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6325","text":"The reason to do that beside the canvas is practical. If one shot misses, the source is still part of the same workspace. You can work on that shot without making the entire project a round trip between a generator, a downloads folder and an editor.","marks":[]}]},{"_type":"block","_key":"b6328","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6327","text":"Keep the useful part of each take","marks":[]}],"anchorId":"keep-the-useful-part-of-each-take"},{"_type":"block","_key":"b6330","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6329","text":"Most clips have a usable section and some time around it that the edit doesn't need. A camera move settles late, a hand leaves frame awkwardly, or the final second repeats information the viewer already has. Trimming is how you keep the section that does the job.","marks":[]}]},{"_type":"block","_key":"b6332","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6331","text":"The Melius timeline supports trimming clip boundaries and splitting a clip at a point in time. Use a trim when you only need a shorter section. Use a split when the two parts need different treatment or another shot belongs between them.","marks":[]}]},{"_type":"block","_key":"b6334","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6333","text":"Those are editorial decisions, not requests for a model to recreate the footage. If the image is right and the timing is wrong, change the timing. Generating again gives you another performance to review when the existing one may already contain everything you need.","marks":[]}]},{"_type":"block","_key":"b6336","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6335","text":"Arrange the shots around the idea","marks":[]}],"anchorId":"arrange-the-shots-around-the-idea"},{"_type":"block","_key":"b6338","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6337","text":"A useful first pass is deliberately plain: put the shots in order, get the lengths right, and watch the whole thing without dressing up the joins. If the story only works with a transition hiding every cut, the order may be the problem.","marks":[]}]},{"_type":"block","_key":"b6340","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6339","text":"Melius lets you move clips along the timeline and work across tracks. Video, still images, text and audio can contribute different parts of the sequence. A product still can hold while a voice finishes a sentence. A text layer can carry the offer without asking the generated footage to render the words correctly.","marks":[]}]},{"_type":"block","_key":"b6342","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6341","text":"For a short product video, start with the opening, the demonstration and the closing frame. Move them until the viewer receives each piece of information in the right order. Add another shot because something is missing, not because another generation is available.","marks":[]}]},{"_type":"block","_key":"b6344","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6343","text":"Manipulate the clip without losing the cut","marks":[]}],"anchorId":"manipulate-the-clip-without-losing-the-cut"},{"_type":"block","_key":"b6346","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6345","text":"Once the sequence works, the editor has controls for playback speed, clip transforms, effects and transitions. Use them to solve a specific problem: shorten a slow movement, change a clip's placement in the frame, or soften a join that shouldn't read as a hard cut.","marks":[]}]},{"_type":"block","_key":"b6348","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6347","text":"Speed deserves a separate check. Changing it changes how long the clip occupies the timeline, which changes when everything around it is seen. The editor's speed handling preserves audio pitch; making a clip faster isn't a way to make a speaker's voice higher.","marks":[]}]},{"_type":"block","_key":"b6350","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6349","text":"Sound needs its own pass. Melius supports clip volume adjustments and working with detached clip audio, so a noisy source recording doesn't have to compete with the voiceover. Balance the voice, music and original sound against one another while watching the picture. Listening to each track alone won't tell you whether the mix works.","marks":[]}]},{"_type":"block","_key":"b6352","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6351","text":"Save the edit, render the deliverable","marks":[]}],"anchorId":"save-the-edit-render-the-deliverable"},{"_type":"block","_key":"b6354","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6353","text":"The timeline is retained on the canvas node, so the working sequence isn't just the last file you downloaded. Rendering through Stitch produces the assembled video, and the download control becomes available for the rendered result.","marks":[]}]},{"_type":"block","_key":"b6356","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6355","text":"The verified video output here is MP4. Choosing a different aspect ratio or resolution changes the picture, not the file type. This workflow shouldn't be described as a choice of MOV, WebM or other video exports unless those options are actually available in the product.","marks":[]}]},{"_type":"block","_key":"b6358","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6357","text":"If a handoff requires another file type or a particular codec, plan for that requirement separately. Renaming an extension doesn't convert a file, and delivering a different format is not the same thing as delivering a differently sized video.","marks":[]}]},{"_type":"block","_key":"b6360","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6359","text":"Building the cut, step by step","marks":[]}],"anchorId":"building-the-cut-step-by-step"},{"_type":"block","_key":"b6363","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6361","text":"Bring your selected assets into the editor.","marks":["strong"]},{"_type":"span","_key":"b6362","text":" Start with the takes you intend to use, plus the voiceover, music or stills the sequence needs.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6366","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6364","text":"Make the rough cut.","marks":["strong"]},{"_type":"span","_key":"b6365","text":" Arrange the shots, trim the unused material and split clips where the structure calls for it.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6369","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6367","text":"Finish the picture.","marks":["strong"]},{"_type":"span","_key":"b6368","text":" Adjust framing, text, speed and transitions once the order and timing work.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6372","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6370","text":"Mix and review.","marks":["strong"]},{"_type":"span","_key":"b6371","text":" Balance the audio, check the output ratio and resolution, and watch from the first frame to the last.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6375","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6373","text":"Render with Stitch and download.","marks":["strong"]},{"_type":"span","_key":"b6374","text":" Review the exported MP4 as the deliverable, while keeping the canvas timeline for later revisions.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6377","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6376","text":"Why generation and editing belong together","marks":[]}],"anchorId":"why-generation-and-editing-belong-together"},{"_type":"block","_key":"b6379","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6378","text":"Melius is the Agentic OS for creative work, with a node-based canvas that keeps the steps behind an asset open. The editor gives that workflow somewhere to finish: generated material becomes a sequence instead of a set of unrelated outputs.","marks":[]}]},{"_type":"block","_key":"b6381","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6380","text":"That doesn't make every editing task disappear. You still decide which take works, where the cut belongs and when a shot has said enough. The advantage is that making those decisions doesn't require moving the whole project somewhere else.","marks":[]}]},{"_type":"block","_key":"b6389","style":"normal","markDefs":[{"_type":"link","_key":"b6383","href":"/blog/ai-video-generators-filmmakers-compared","isNewTab":false},{"_type":"link","_key":"b6386","href":"/blog/best-ai-tools-fashion-campaign-videos","isNewTab":false}],"children":[{"_type":"span","_key":"b6382","text":"For the generation side, see ","marks":[]},{"_type":"span","_key":"b6384","text":"AI video generators for filmmakers","marks":["b6383"]},{"_type":"span","_key":"b6385","text":". For maintaining a look across the shots before they reach the edit, see ","marks":[]},{"_type":"span","_key":"b6387","text":"building a fashion campaign video","marks":["b6386"]},{"_type":"span","_key":"b6388","text":".","marks":[]}]},{"_type":"block","_key":"b6391","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6390","text":"Frequently asked questions","marks":[]}],"anchorId":"frequently-asked-questions"},{"_type":"faqList","_key":"b6392","items":"$b:props:children:1:props:children:1:props:children:0:props:post:faq"},{"_type":"block","_key":"b6397","style":"normal","markDefs":[{"_type":"link","_key":"b6394","href":"https://app.melius.com","isNewTab":false}],"children":[{"_type":"span","_key":"b6393","text":"Take three clips into ","marks":[]},{"_type":"span","_key":"b6395","text":"Melius","marks":["b6394"]},{"_type":"span","_key":"b6396","text":". Cut them into one sequence before generating a fourth.","marks":[]}]}]}}],"$L36","$L37"]}]]}]]}]
