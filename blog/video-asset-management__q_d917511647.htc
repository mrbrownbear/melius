43:I[35599,["/_next/static/immutable/chunks/176631nmv93q8.js","/_next/static/immutable/chunks/20pevlmjlhelo.js","/_next/static/immutable/chunks/1chr4r7q0x6jr.js","/_next/static/immutable/chunks/3c0zy4y93486l.js","/_next/static/immutable/chunks/06w2rvx3-kxxg.js","/_next/static/immutable/chunks/2qicka26b4zda.js","/_next/static/immutable/chunks/2_1it5ua3j5ir.js","/_next/static/immutable/chunks/29d69g982pymu.js","/_next/static/immutable/chunks/0sog918pi80uv.js","/_next/static/immutable/chunks/0zke7d8fy0v9q.js","/_next/static/immutable/chunks/1xm1-c_qty48z.js","/_next/static/immutable/chunks/08pto-z6i41o-.js","/_next/static/immutable/chunks/200nhymd1sxma.js"],"default"]
1b:["$","h2","b6244",{"id":"give-the-footage-a-home-then-make-it-findable","className":"scroll-mt-28","children":["Give the footage a home, then make it findable"]}]
1c:["$","p","b6246",{"children":["Folders work well for the structure everyone already knows: a campaign, a product line, a client. Tags work well for the properties that cut across that structure: product close-up, interview, summer launch, vertical."]}]
1d:["$","p","b6248",{"children":["For example, a close-up of a bottle might live in a launch folder while carrying tags for the product and the shot type. When the next campaign needs that bottle, the team shouldn't have to remember which launch it first appeared in. The tags are how the asset escapes the limits of its folder without being duplicated into five more folders."]}]
1e:["$","p","b6253",{"children":["Melius supports file-type and tag filtering for media assets. Selecting several tags narrows the results to assets carrying all of them, which makes the combination useful for finding a specific set. Choose video, then the product tag and the shot tag, and you're looking at the intersection rather than everything loosely related to either word. The ",["$","$L43","b6251",{"link":{"_type":"link","_key":"b6250","href":"https://docs.melius.com/help-center/marketers/assets","isNewTab":false},"children":["asset library guide"]}]," covers the filtering and sorting controls."]}]
1f:["$","p","b6255",{"children":["Keep the vocabulary small enough that people use it consistently. Product-closeup and product-detail may mean the same thing to the person uploading and different things to the person searching. A tagging system only helps if the team agrees what the tags mean."]}]
20:["$","h2","b6257",{"id":"find-the-shot-by-describing-it","className":"scroll-mt-28","children":["Find the shot by describing it"]}]
21:["$","p","b6259",{"children":["Semantic search is available on Professional and Enterprise. Describe what you're looking for in the asset search bar instead of trying to remember what somebody named the file."]}]
22:["$","p","b6261",{"children":["The difference is what the search understands. A filename search needs words from the name. Semantic search uses the content of the asset, so you can try \"a close-up of a bottle on a dark background\" when all you remember is the shot. You don't need to have put that description in the filename or added it as a tag first."]}]
23:["$","p","b6263",{"children":["That becomes useful when the library belongs to a team. The person looking for footage often isn't the person who uploaded it, and nobody remembers the names of every take. Describing the scene gives them a way into the collection without asking whoever made it to find the file."]}]
24:["$","p","b6265",{"children":["Tags still do a different job. Use them for the labels your team has agreed on, such as a campaign or a product line. Use semantic search when you know what the asset contains but not what it's called. Open the matches and check the footage before you choose one."]}]
25:["$","h2","b6267",{"id":"metadata-is-how-you-check-the-candidate","className":"scroll-mt-28","children":["Metadata is how you check the candidate"]}]
26:["$","p","b6269",{"children":["Tags describe the job a file does. Metadata describes the file itself. You want both, because finding a clip called homepage hero doesn't tell you whether it's the right dimensions or the right length."]}]
27:["$","p","b6271",{"children":["The asset details view can show dimensions, duration, file size and creation time when those details are available. For generated assets, recorded generation information can also identify the model or tool and the prompt behind the result. Uploaded footage has a different history, and shouldn't be presented as though it came from a generation."]}]
28:["$","p","b6273",{"children":["This is the step that saves the wrong clip from making it into the edit. Open the candidate, inspect the details and play it. Two takes can share an opening frame while differing in the one second that matters."]}]
29:["$","p","b6275",{"children":["Metadata here means information you can inspect about an asset. It doesn't mean that every field is an editable custom field, or that the library automatically understands your campaign taxonomy. Tags are where your team's own labels belong."]}]
2a:["$","h2","b6277",{"id":"share-assets-with-anyone-on-the-internet","className":"scroll-mt-28","children":["Share assets with anyone on the internet"]}]
2b:["$","p","b6279",{"children":["You can share assets with anyone on the internet. Open the asset, click Share and send the public link. The recipient doesn't need a Melius account to view it."]}]
2c:["$","p","b6281",{"children":["That makes a clip easy to send to a client, a collaborator or someone who just needs to see the work. The asset stays in your library; the link is what you pass along."]}]
2d:["$","h2","b6283",{"id":"setting-up-a-campaign-library","className":"scroll-mt-28","children":["Setting up a campaign library"]}]
2e:["$","ol","b6286-parent",{"children":[["$","li","b6286",{"children":[["$","strong","b6284",{"children":["Bring the footage into Assets."]}]," Keep useful source material alongside the generated clips the campaign produces, rather than treating the library as a folder for finished exports only."]}],["$","li","b6289",{"children":[["$","strong","b6287",{"children":["Name and file the assets."]}]," Use names someone else could search for, and folders that reflect the way the team already groups its work."]}],["$","li","b6292",{"children":[["$","strong","b6290",{"children":["Apply a small set of tags."]}]," Start with the product, campaign or shot type. Add labels because they answer a retrieval question, not because every file needs more labels."]}],["$","li","b6295",{"children":[["$","strong","b6293",{"children":["Check the details before reuse."]}]," Filter to video, narrow by the relevant tags, and inspect the candidate's length and dimensions before placing it on the canvas."]}],["$","li","b6298",{"children":[["$","strong","b6296",{"children":["Share with anyone."]}]," Send a public asset link to anyone on the internet. They don't need a Melius account to view it."]}]]}]
2f:["$","h2","b6300",{"id":"why-the-library-belongs-beside-the-work","className":"scroll-mt-28","children":["Why the library belongs beside the work"]}]
30:["$","p","b6302",{"children":["A stored clip becomes more valuable when it can be used again without rebuilding the context around it. Melius connects asset management to a node-based creative canvas, so a reference or a finished shot can become an input to the next piece of work."]}]
31:["$","p","b6310",{"children":["That's the same argument behind the ",["$","$L43","b6305",{"link":{"_type":"link","_key":"b6304","href":"/blog/modern-creative-workflow-tools","isNewTab":false},"children":["modern creative workflow"]}],": the time goes into moving and reconciling material as much as making it. For video specifically, the ",["$","$L43","b6308",{"link":{"_type":"link","_key":"b6307","href":"/blog/ai-video-generators-filmmakers-compared","isNewTab":false},"children":["filmmaker's comparison"]}]," looks at what happens between generating a shot and finishing a sequence."]}]
32:["$","h2","b6312",{"id":"frequently-asked-questions","className":"scroll-mt-28","children":["Frequently asked questions"]}]
33:["$","div","b6313",{"className":"faq-list my-10 flex flex-col divide-y divide-black/10 border-y border-black/10","children":[["$","details","0",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["Can I store and organize video files on Melius?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"Yes. The asset library supports video alongside other media, with folders, names, tags, search and filtering to help organize the collection."}]]}],["$","details","1",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["Can I filter videos by more than one tag?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"Yes. An asset must carry every selected tag to match. Use that to narrow a collection by several properties, such as a product and a shot type."}]]}],["$","details","2",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["What metadata can I inspect?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"Available details include dimensions, duration, file size and creation time. Generated assets can also carry recorded prompt and model or tool information. The fields shown depend on the asset and the information available for it."}]]}],["$","details","3",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["Can I share assets with someone outside my team?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"Yes. You can share assets with anyone on the internet using a public link. They don't need a Melius account to view them."}]]}],["$","details","4",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["Can I search for an asset without knowing its filename?","$L44"]}],"$L45"]}]]}]
34:["$","p","b6318",{"children":["Open ",["$","$L43","b6316",{"link":{"_type":"link","_key":"b6315","href":"https://app.melius.com","isNewTab":false},"children":["Melius"]}]," with one campaign's footage. Give it names and tags that someone else could find without asking you."]}]
36:["$","$L35","post-google-vertex-ai-alternatives-creative-teams",{"post":{"_key":"post-google-vertex-ai-alternatives-creative-teams","slug":"google-vertex-ai-alternatives-creative-teams","category":"comparisons","title":"Google Vertex AI alternatives for creative teams","isoDate":"2026-09-16","date":"September 16, 2026","readTime":"20 Min Read","excerpt":"Seven ways to reach Veo without a cloud project, compared on setup, where the work lives, throughput, and what you give up in governance.","image":{"url":"/images/blog/google-vertex-ai-alternatives-creative-teams/compass-cover.webp"},"authors":[{"name":"Melius Team"}],"faq":[{"question":"Does Melius have Gemini Omni Flash?","answer":"Yes. Melius supports Gemini Omni Flash and Gemini Omni Flash 1.1 alongside Veo 3.1, Kling, Wan and Seedance in the same creative workspace."}],"tableOfContents":[{"_key":"what-should-a-creative-team-use-instead-of-google-vertex-ai","title":"What should a creative team use instead of Google Vertex AI?"},{"_key":"what-to-know-before-you-pick","title":"What to know before you pick"},{"_key":"what-separates-a-creative-surface-from-an-inference-endpoint","title":"What separates a creative surface from an inference endpoint?"},{"_key":"the-seven-compared","title":"The seven compared"},{"_key":"1-melius","title":"1. Melius"},{"_key":"2-google-flow","title":"2. Google Flow"},{"_key":"3-flora","title":"3. Flora"},{"_key":"4-runway","title":"4. Runway"},{"_key":"5-adobe-firefly","title":"5. Adobe Firefly"},{"_key":"6-krea","title":"6. Krea"},{"_key":"7-fal-ai","title":"7. fal.ai"},{"_key":"when-the-platform-is-still-the-right-answer","title":"When the platform is still the right answer"},{"_key":"frequently-asked-questions","title":"FAQ"}],"content":[{"_type":"block","_key":"b6399","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6398","text":"What should a creative team use instead of Google Vertex AI?","marks":[]}],"anchorId":"what-should-a-creative-team-use-instead-of-google-vertex-ai"},{"_type":"block","_key":"b6401","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6400","text":"Use a creative platform that resells the same Veo models, because almost all of them do and none of them charge more for it. Vertex is Google Cloud's model-serving infrastructure, so the video model you reach through it is the identical model you reach through Melius, Runway, Adobe Firefly, Krea or Google's own Flow, at the same published per-second rate. What changes is everything around the model: whether you need a cloud project to start, where the output lands, and how fast you can iterate.","marks":[]}]},{"_type":"block","_key":"b6403","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6402","text":"One thing to know before you start comparing: Vertex AI isn't called that any more. At Cloud Next 2026 Google renamed the platform to Gemini Enterprise Agent Platform and Vertex AI Studio became Agent Studio. The marketing URL cloud.google.com/vertex-ai now lands on the Agent Platform product page, the model reference and Provisioned Throughput trees have moved, and the older doc paths still resolve while serving renamed content. Veo on Vertex AI is Veo on Gemini Enterprise Agent Platform. If you're evaluating it on a page that still uses the old name, check the date on the page.","marks":[]}]},{"_type":"block","_key":"b6405","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6404","text":"What to know before you pick","marks":[]}],"anchorId":"what-to-know-before-you-pick"},{"_type":"block","_key":"b6407","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6406","text":"The model is the same and so is the price. fal.ai charges Google's exact list rate for Veo 3.1, $0.20 a second silent and $0.40 with audio at 1080p, with no cloud project and no bucket. So Vertex is not the cheap route, it's the same route with more setup.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6409","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6408","text":"Audio doubles the cost on the flagship, and you pay for every clip the model successfully returns, usable or not. An 8-second Veo 3.1 clip at 1080p with audio is $3.20, so ten takes to land one shot is $32. Failed requests aren't charged, which is the one piece of good news in the billing model.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6411","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6410","text":"Veo on Vertex runs in a single region, us-central1, and takes English prompts only. Clips are 4, 6 or 8 seconds, in 16:9 or 9:16.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6413","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6412","text":"Google built Flow for exactly this reason. It's Google's own creative surface for Veo, it has a canvas, and it costs $19.99 a month, which tells you what Google thinks Vertex is for.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6415","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6414","text":"What separates a creative surface from an inference endpoint?","marks":[]}],"anchorId":"what-separates-a-creative-surface-from-an-inference-endpoint"},{"_type":"block","_key":"b6417","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6416","text":"Four questions, and the first one ends the evaluation for most creative teams before quality ever comes up.","marks":[]}]},{"_type":"block","_key":"b6419","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6418","text":"Can a creative start without a cloud project?","marks":[]}]},{"_type":"block","_key":"b6421","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6420","text":"Read Google's own prerequisites for generating a video on the platform. You sign in to or create a Google Cloud account. You select or create a project, which needs the Project Creator role. You enable the platform API, which needs either Owner or Service Usage Admin. Then, in the console, you set an output directory by browsing to a Cloud Storage bucket you have created.","marks":[]}]},{"_type":"block","_key":"b6423","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6422","text":"That's an account, a project, two named IAM roles and a storage bucket before the first frame exists, and a billing account on top in practice. There is a no-code interface, Media Studio, and it is a model menu plus a prompt box and four parameters: aspect ratio, number of results, video length and output directory. None of this is a criticism of the product. It's a description of infrastructure, and it's the reason a creative director can't self-serve here.","marks":[]}]},{"_type":"block","_key":"b6425","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6424","text":"Where does the work live?","marks":[]}]},{"_type":"block","_key":"b6427","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6426","text":"On Vertex, output goes to a `gs://` bucket. The documented flow points your generations at Cloud Storage rather than into an in-product library, and nothing in the docs describes a gallery, a version history or a comment thread. A GCP project with IAM roles is a permissions model, not a shared workspace, and finding the third take of a shot you generated last Tuesday means knowing your own bucket structure.","marks":[]}]},{"_type":"block","_key":"b6429","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6428","text":"This is the gap the alternatives fill, and it's worth being specific about what filling it means: a canvas or a library that holds the takes, versions you can step back through, assets a teammate can find without asking you, and a link you can send to a client. Those aren't conveniences on a production, they're most of the work.","marks":[]}]},{"_type":"block","_key":"b6431","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6430","text":"Does the throughput match how you work?","marks":[]}]},{"_type":"block","_key":"b6433","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6432","text":"This is the finding that surprised us most, and it comes straight from Google's documentation. Veo is excluded from pay-as-you-go on the platform, so sustained capacity comes from Provisioned Throughput, which is sold in units called GSUs. The enforcement window on a reservation of 1 to 9 GSUs is 2,000 seconds.","marks":[]}]},{"_type":"block","_key":"b6435","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6434","text":"Google's own worked example spells out what that means: with 1 GSU you can generate a four-second Veo 3 video within a few minutes, and then you can't generate another of the same size until the window ends. Do the division and a 2,000-second window is one four-second clip with audio roughly every 33 minutes, because audio burns the allowance at twice the rate of picture. Getting to one clip a minute means the 60-second window, which the table only grants at 67 GSUs or more.","marks":[]}]},{"_type":"block","_key":"b6437","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6436","text":"Creative iteration doesn't work at one take per half hour. It works in bursts of ten or twenty variations while an idea is still warm, which is what a per-second on-demand endpoint gives you and what a reserved-capacity window does not.","marks":[]}]},{"_type":"block","_key":"b6439","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6438","text":"What do you give up in governance?","marks":[]}]},{"_type":"block","_key":"b6441","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6440","text":"Honestly, quite a lot, and this is where Vertex earns its place. Veo on the platform supports data residency, customer-managed encryption keys, VPC Service Controls and Access Transparency. Google contractually commits not to use your data to train or tune models without your instruction, across both GA and pre-GA models. Generally available Veo versions are on Google's list of indemnified generative AI services, covering both training data and generated output. And it all lands on one cloud invoice, which in a large organization can save months of procurement.","marks":[]}]},{"_type":"block","_key":"b6443","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6442","text":"No creative platform below offers that stack. If you're at a company where legal needs an indemnity and security needs VPC Service Controls, the honest answer is that you should use the platform, and give a creative team something else for exploration.","marks":[]}]},{"_type":"block","_key":"b6445","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6444","text":"Two caveats on the governance case, though. Zero data retention isn't the default; prompts may be logged for abuse monitoring and an exception has to be requested, and for advanced models Google's own addendum says zero retention may not be possible. And the indemnity covers generally available versions only, so Veo 3.1 Lite, still in preview, sits outside it. Veo also isn't named as a covered service in either the generative AI SLA, which covers specific Gemini inference methods, or the platform SLA, which covers training and batch prediction. If an availability guarantee matters to you, get it in writing before assuming Veo carries one.","marks":[]}]},{"_type":"block","_key":"b6447","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6446","text":"The seven compared","marks":[]}],"anchorId":"the-seven-compared"},{"_type":"block","_key":"b6449","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6448","text":"Capabilities and list prices as of September 2026, from each platform's own documentation and pricing pages. Several are running sales that will have ended by the time you read this, so these are list prices. Veo access is stated as each platform documents it.","marks":[]}]},{"_type":"portableTable","_key":"b6450","rows":[{"_key":"b6451","cells":[{"_key":"b6452","text":[{"_type":"block","_key":"b6454","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6453","text":"Platform","marks":["strong"]}]}]},{"_key":"b6455","text":[{"_type":"block","_key":"b6457","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6456","text":"Veo access","marks":["strong"]}]}]},{"_key":"b6458","text":[{"_type":"block","_key":"b6460","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6459","text":"Where work lives","marks":["strong"]}]}]},{"_key":"b6461","text":[{"_type":"block","_key":"b6463","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6462","text":"Entry price","marks":["strong"]}]}]},{"_key":"b6464","text":[{"_type":"block","_key":"b6466","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6465","text":"Best at","marks":["strong"]}]}]}]},{"_key":"b6467","cells":[{"_key":"b6468","text":[{"_type":"block","_key":"b6470","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6469","text":"Melius","marks":[]}]}]},{"_key":"b6471","text":[{"_type":"block","_key":"b6473","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6472","text":"Veo 3.1, Gemini Omni Flash and Gemini Omni Flash 1.1, plus roughly 40 other video and image models","marks":[]}]}]},{"_key":"b6474","text":[{"_type":"block","_key":"b6476","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6475","text":"Multiplayer node canvas, shared workspaces, up to 8 seats on self-serve plans; unlimited seats on Enterprise","marks":[]}]}]},{"_key":"b6477","text":[{"_type":"block","_key":"b6479","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6478","text":"Plans start at $18 a month","marks":[]}]}]},{"_key":"b6480","text":[{"_type":"block","_key":"b6482","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6481","text":"Routing between models inside one workflow","marks":[]}]}]}]},{"_key":"b6483","cells":[{"_key":"b6484","text":[{"_type":"block","_key":"b6486","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6485","text":"Google Flow","marks":[]}]}]},{"_key":"b6487","text":[{"_type":"block","_key":"b6489","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6488","text":"Veo 3.1, Gemini Omni, Nano Banana Pro","marks":[]}]}]},{"_key":"b6490","text":[{"_type":"block","_key":"b6492","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6491","text":"Flow canvas and Scenebuilder","marks":[]}]}]},{"_key":"b6493","text":[{"_type":"block","_key":"b6495","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6494","text":"Free tier, then $19.99 a month","marks":[]}]}]},{"_key":"b6496","text":[{"_type":"block","_key":"b6498","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6497","text":"Google's own models with a real creative surface","marks":[]}]}]}]},{"_key":"b6499","cells":[{"_key":"b6500","text":[{"_type":"block","_key":"b6502","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6501","text":"Flora","marks":[]}]}]},{"_key":"b6503","text":[{"_type":"block","_key":"b6505","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6504","text":"Veo 3.1, plus Seedance and Kling","marks":[]}]}]},{"_key":"b6506","text":[{"_type":"block","_key":"b6508","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6507","text":"Team canvas with live cursors and comments","marks":[]}]}]},{"_key":"b6509","text":[{"_type":"block","_key":"b6511","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6510","text":"$$18 per seat a month","marks":[]}]}]},{"_key":"b6512","text":[{"_type":"block","_key":"b6514","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6513","text":"Node workflows a team edits together","marks":[]}]}]}]},{"_key":"b6515","cells":[{"_key":"b6516","text":[{"_type":"block","_key":"b6518","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6517","text":"Runway","marks":[]}]}]},{"_key":"b6519","text":[{"_type":"block","_key":"b6521","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6520","text":"Veo 3.1, alongside its own Gen-4.5","marks":[]}]}]},{"_key":"b6522","text":[{"_type":"block","_key":"b6524","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6523","text":"Projects, brand kits, asset storage","marks":[]}]}]},{"_key":"b6525","text":[{"_type":"block","_key":"b6527","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6526","text":"$$15 a month","marks":[]}]}]},{"_key":"b6528","text":[{"_type":"block","_key":"b6530","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6529","text":"Generation plus a genuine edit surface","marks":[]}]}]}]},{"_key":"b6531","cells":[{"_key":"b6532","text":[{"_type":"block","_key":"b6534","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6533","text":"Adobe Firefly","marks":[]}]}]},{"_key":"b6535","text":[{"_type":"block","_key":"b6537","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6536","text":"Veo 3.1 and 3.1 Fast as partner models","marks":[]}]}]},{"_key":"b6538","text":[{"_type":"block","_key":"b6540","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6539","text":"Firefly Boards, and the Creative Cloud pipeline","marks":[]}]}]},{"_key":"b6541","text":[{"_type":"block","_key":"b6543","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6542","text":"$$9.99 a month","marks":[]}]}]},{"_key":"b6544","text":[{"_type":"block","_key":"b6546","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6545","text":"Working where the rest of post already happens","marks":[]}]}]}]},{"_key":"b6547","cells":[{"_key":"b6548","text":[{"_type":"block","_key":"b6550","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6549","text":"Krea","marks":[]}]}]},{"_key":"b6551","text":[{"_type":"block","_key":"b6553","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6552","text":"Veo 3, 3 Fast, 3.1, 3.1 Fast and 3.1 Lite","marks":[]}]}]},{"_key":"b6554","text":[{"_type":"block","_key":"b6556","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6555","text":"Generation library, collaborative on Business","marks":[]}]}]},{"_key":"b6557","text":[{"_type":"block","_key":"b6559","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6558","text":"$$9 a month, Veo from $35","marks":[]}]}]},{"_key":"b6560","text":[{"_type":"block","_key":"b6562","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6561","text":"The widest Veo variant coverage","marks":[]}]}]}]},{"_key":"b6563","cells":[{"_key":"b6564","text":[{"_type":"block","_key":"b6566","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6565","text":"fal.ai","marks":[]}]}]},{"_key":"b6567","text":[{"_type":"block","_key":"b6569","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6568","text":"Veo 3.1 at Google's exact list price","marks":[]}]}]},{"_key":"b6570","text":[{"_type":"block","_key":"b6572","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6571","text":"Nothing, it's an API","marks":[]}]}]},{"_key":"b6573","text":[{"_type":"block","_key":"b6575","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6574","text":"Pay per use","marks":[]}]}]},{"_key":"b6576","text":[{"_type":"block","_key":"b6578","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6577","text":"Keeping an API without keeping a cloud project","marks":[]}]}]}]}]},{"_type":"block","_key":"b6580","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6579","text":"1. Melius","marks":[]}],"anchorId":"1-melius"},{"_type":"block","_key":"b6582","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6581","text":"Melius is the Agentic OS for creative work: you describe the outcome and an agent builds the workflow, routes each step to a model and leaves every step editable. A node-based canvas sits underneath, so the pipeline is visible and re-runnable, and plenty of people drive it from Slack or the command line without opening the canvas at all.","marks":[]}]},{"_type":"block","_key":"b6584","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6583","text":"Against Vertex the difference is what surrounds the model. Veo 3.1 sits alongside Gemini Omni Flash and Gemini Omni Flash 1.1 among roughly forty video and image models on the same subscription and the same credit pool, so comparing Veo against Kling, Wan or Seedance on one shot is a branch, not a second vendor. And the canvas is the thing Vertex has no equivalent of: the takes stay where you made them, teammates see the work live, and changing an upstream node re-runs everything below it.","marks":[]}]},{"_type":"block","_key":"b6586","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6585","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b6588","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6587","text":"Veo 3.1 sits alongside Gemini Omni Flash, Gemini Omni Flash 1.1, Kling, Wan and Seedance in the same library of leading models on one subscription, so per-step routing is a setting rather than a procurement exercise.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6590","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6589","text":"Every canvas is real-time and collaborative by default, with presence for people and for agents, so there's no session to share or enable.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6592","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6591","text":"Up to 8 seats on self-serve plans and unlimited seats on Enterprise, with shared credits for the team.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6594","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6593","text":"It's reachable from Slack, the Model Context Protocol (MCP), a CLI and a REST API, so an agent you already use can drive the canvas.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6596","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6595","text":"You own what you create and can use it commercially, subject to the underlying model providers' terms, and Melius does not use your work to train AI models.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6598","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6597","text":"Search with AI, on Professional and above, searches the team library by description, not by filename, which is the thing a storage bucket cannot do.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6600","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6599","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b6602","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6601","text":"Melius does not offer the governance stack, and for some buyers that settles it. There's no VPC Service Controls, no customer-managed encryption keys, no data-residency selection and no IP indemnity of the kind Google extends to generally available Veo. A regulated enterprise with a security review will find Vertex answers questions Melius does not.","marks":[]}]},{"_type":"block","_key":"b6604","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6603","text":"The catch: the best place to work with Veo, and not the place to satisfy a procurement questionnaire.","marks":[]}]},{"_type":"block","_key":"b6606","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6605","text":"Best for: creative teams and agencies who want Veo next to every other leading model, in a workspace where the process and the assets stay put. Current numbers are on the pricing page.","marks":[]}]},{"_type":"block","_key":"b6608","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6607","text":"2. Google Flow","marks":[]}],"anchorId":"2-google-flow"},{"_type":"block","_key":"b6610","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6609","text":"The most honest alternative to Google's infrastructure is Google's own creative product. Flow is what Google built for people who want to make things with Veo rather than serve it, and its existence is the clearest evidence that Vertex was never meant to be a creative surface.","marks":[]}]},{"_type":"block","_key":"b6612","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6611","text":"It has an adaptable canvas, Scenebuilder, video extension, video-to-video editing, characters and avatars, and natural-language iterative editing. There's also a gallery of about a dozen featured tools, from a video resizer to a storyboard studio, which you can remix, and you can describe a new tool in plain language if you're on a paid tier. It reaches Gemini Omni and Nano Banana Pro too, not only Veo.","marks":[]}]},{"_type":"block","_key":"b6614","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6613","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b6616","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6615","text":"No cloud project, no IAM roles, no bucket. A consumer Google account and a subscription.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6618","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6617","text":"Scenebuilder and the canvas give you somewhere for a sequence to exist instead of a folder of files.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6620","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6619","text":"Natural-language iterative editing, so a note becomes a revision instead of a new prompt.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6622","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6621","text":"Every tier including the free one carries 50 daily credits, with paid plans adding a monthly pool on top, so evaluating it costs nothing.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6624","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6623","text":"It reaches Gemini Omni Flash, currently at the top of the blind text-to-video rankings.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6626","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6625","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b6628","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6627","text":"It's Google models only, which is the whole point and also the limitation: no Kling, no Seedance, no Wan, so a shot that Veo handles badly has nowhere else to go. Flow is sold as an individual Google AI subscription with no per-seat or team tier, so credits sit with one account and two people on one project means two subscriptions. Tools can be shared and remixed, but the credit pool cannot.","marks":[]}]},{"_type":"block","_key":"b6630","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6629","text":"Access is also conditional in ways a professional tool usually is not: 18 or over, a consumer Google account, and features that Google says may vary by subscription tier, platform and region. The visible watermark on the lower tiers is the practical blocker for client work, and removing it means the top tier.","marks":[]}]},{"_type":"block","_key":"b6632","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6631","text":"The catch: the right creative surface for Veo, built for one person at a time.","marks":[]}]},{"_type":"block","_key":"b6634","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6633","text":"Best for: individuals working with Google's models who want Google's own tooling and don't need a second model family or a shared workspace.","marks":[]}]},{"_type":"block","_key":"b6636","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6635","text":"3. Flora","marks":[]}],"anchorId":"3-flora"},{"_type":"block","_key":"b6638","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6637","text":"Flora is the closest thing to Melius in shape: an infinite creative canvas where you wire models, transforms and assets into reusable visual pipelines, with an agent that chains steps conversationally. It carries Veo 3.1 alongside Seedance, Kling and a long tail of others.","marks":[]}]},{"_type":"block","_key":"b6640","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6639","text":"Where it leans hardest is live team editing. Real-time cursors, commenting, shared team assets and usage analytics are the product's centre of gravity, and it's priced per seat accordingly.","marks":[]}]},{"_type":"block","_key":"b6642","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6641","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b6644","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6643","text":"Real-time cursors and commenting directly on the canvas, so review happens where the work is.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6646","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6645","text":"Shared team assets and usage analytics, which is the governance a creative lead actually wants.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6648","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6647","text":"Node workflows are reusable, so a pipeline that worked becomes a template.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6650","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6649","text":"An in-canvas video timeline for trimming, arranging and rendering.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6652","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6651","text":"SSO on the enterprise tier, which is rare at this end of the market.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6654","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6653","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b6656","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6655","text":"Pricing is per seat with metered usage on top, so the bill has two moving parts and a busy month moves both. The free plan excludes video models entirely, which means you can't evaluate the thing you came for without paying.","marks":[]}]},{"_type":"block","_key":"b6658","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6657","text":"Flora has no model of its own either, so rights on any given clip inherit from whichever model the node called, and that's a per-node question rather than a per-platform answer.","marks":[]}]},{"_type":"block","_key":"b6660","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6659","text":"The catch: excellent collaboration, on a bill with two variables.","marks":[]}]},{"_type":"block","_key":"b6662","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6661","text":"Best for: small teams who want a shared canvas and are comfortable with seat-based pricing plus usage.","marks":[]}]},{"_type":"block","_key":"b6664","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6663","text":"4. Runway","marks":[]}],"anchorId":"4-runway"},{"_type":"block","_key":"b6666","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6665","text":"Runway is the incumbent creative video platform, and it's the one entry here with a frontier research lab of its own shipping continuously: Gen-4.5, then Aleph 2.0, Ruby, Solaris and GWM Worlds 2. Aleph 2.0 with Edit Studio also gives it the strongest editing surface in the comparison, where an instruction propagates across cuts in a multi-shot sequence instead of applying to one clip.","marks":[]}]},{"_type":"block","_key":"b6668","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6667","text":"It also hosts other people's models, Veo 3.1 among them, plus Wan 3.0 and Seedance 2.5, and in September it shipped plugins that put its lineup inside Premiere Pro and After Effects.","marks":[]}]},{"_type":"block","_key":"b6670","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6669","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b6672","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6671","text":"Edit Studio is a real edit surface, taking an input video between 2 and 30 seconds at up to 1080p with no more than ten cuts.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6674","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6673","text":"Its own models sit beside the third-party ones, so you can compare Gen-4.5 against Veo on the same platform.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6676","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6675","text":"Ruby turns an SDR generation into true HDR and exports 16-bit EXR, which nothing else here offers.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6678","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6677","text":"Brand kits and 20GB to 500GB of asset storage by tier, so the work has a home.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6680","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6679","text":"The Premiere and After Effects plugins remove the round trip for anyone cutting in Adobe.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6682","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6681","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b6684","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6683","text":"Runway's terms of use say inputs and outputs may be used to train and improve its models, on every plan except Enterprise. For a team working on unreleased client material that's a genuine objection, and it's the sharpest contrast with Vertex in this whole comparison, because Google's contractual position on training is the stronger one.","marks":[]}]},{"_type":"block","_key":"b6686","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6685","text":"The credit arithmetic is also unforgiving. Gen-4.5 costs 12 credits a second, and the $15 Standard plan's 625 monthly credits buy 52 seconds of it on Runway's own published figure, so budget by the shot rather than by the month.","marks":[]}]},{"_type":"block","_key":"b6688","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6687","text":"The catch: the best editing in the category, with the weakest training-data position.","marks":[]}]},{"_type":"block","_key":"b6690","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6689","text":"Best for: teams who want to generate and assemble in one place and can put the work on an Enterprise plan if confidentiality matters.","marks":[]}]},{"_type":"block","_key":"b6692","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6691","text":"5. Adobe Firefly","marks":[]}],"anchorId":"5-adobe-firefly"},{"_type":"block","_key":"b6694","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6693","text":"Adobe reaches Veo 3.1 and Veo 3.1 Fast as partner models, alongside Luma Ray3, Kling 3.0 and Runway Gen-4.5, and in September it went further than anyone else by putting generative models directly into the Premiere timeline: draw a range on a track, describe what you need, and generate without leaving the application.","marks":[]}]},{"_type":"block","_key":"b6696","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6695","text":"Firefly Boards is the canvas, but the real argument is position. If your team already finishes in Premiere and After Effects, this is the only option on the list where the model shows up inside the tool you were going to use anyway.","marks":[]}]},{"_type":"block","_key":"b6698","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6697","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b6700","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6699","text":"Generation inside the Premiere timeline, with sequence settings matched automatically and the credit cost shown before you commit.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6702","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6701","text":"Firefly plus partner models from Google Veo, Kling, Runway and Luma, all reachable from one picker.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6704","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6703","text":"Firefly's own model is trained on licensed Adobe Stock and public domain content and never on customer work.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6706","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6705","text":"Firefly Custom Models let a studio train on its own assets so generations conform to a house look.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6708","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6707","text":"Entry pricing is $9.99 a month for 2,000 credits, the cheapest way onto Veo with a creative surface attached, though partner models are a premium feature that draws on that allowance.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6710","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6709","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b6712","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6711","text":"The commercial-safety guarantee covers Firefly's own model only. The moment you pick Veo, Kling, Runway or Luma from that same picker you inherit their terms instead, and the interface makes them look equivalent when they aren't. Firefly's own video model is also well behind the frontier on quality, so the value is pipeline position, not output.","marks":[]}]},{"_type":"block","_key":"b6714","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6713","text":"Credits do not roll over, which penalizes the lumpy production calendar most teams actually run, and Boards is a lighter canvas than Melius or Flora, not a workflow surface.","marks":[]}]},{"_type":"block","_key":"b6716","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6715","text":"The catch: the best place to work, and you still have to read the terms per model.","marks":[]}]},{"_type":"block","_key":"b6718","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6717","text":"Best for: teams already inside Creative Cloud who want the round trip gone.","marks":[]}]},{"_type":"block","_key":"b6720","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6719","text":"6. Krea","marks":[]}],"anchorId":"6-krea"},{"_type":"block","_key":"b6722","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6721","text":"Krea has the widest Veo coverage of anything here, carrying Veo 3, 3 Fast, 3.1, 3.1 Fast and 3.1 Lite, so if you specifically want to compare Veo variants against each other it's the most direct route. It runs Seedance and Vidu alongside them.","marks":[]}]},{"_type":"block","_key":"b6724","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6723","text":"Its own contribution is Krea Realtime, a model that streams frames as they generate and lets you change the prompt mid-generation, which is genuinely useful for look development rather than final pixels.","marks":[]}]},{"_type":"block","_key":"b6726","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6725","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b6728","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6727","text":"All five current Veo variants in one place, which no other platform here matches.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6730","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6729","text":"Realtime Canvas renders a sketch toward photoreal fast enough to direct interactively.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6732","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6731","text":"A commercial license starts on the $9 Basic tier, which is the lowest entry to cleared output on this list.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6734","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6733","text":"A free tier with 100 daily units, enough to judge the models.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6736","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6735","text":"Nodes on the Pro tier for chaining steps into a repeatable workflow.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6738","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6737","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b6740","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6739","text":"Two tiers are doing different jobs here and it's easy to conflate them. The $9 Basic plan is where a commercial license starts, but it carries only selected video models, and Krea says the Pro plan at $35 is what unlocks all of them, so Basic is not established as a route to Veo. Collaboration is also thin until the Business tier, where the product is described as a workspace for teams; below that it's a strong individual tool with a library.","marks":[]}]},{"_type":"block","_key":"b6742","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6741","text":"Krea's published pricing was also difficult to read reliably, with figures differing between sources, so confirm the tier you want before committing.","marks":[]}]},{"_type":"block","_key":"b6744","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6743","text":"The catch: the most Veo variants, the least team structure.","marks":[]}]},{"_type":"block","_key":"b6746","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6745","text":"Best for: individuals and small teams doing model comparison and look development.","marks":[]}]},{"_type":"block","_key":"b6748","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6747","text":"7. fal.ai","marks":[]}],"anchorId":"7-fal-ai"},{"_type":"block","_key":"b6750","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6749","text":"If what you actually wanted from Vertex was an API, fal is the answer, and the pricing comparison makes the argument on its own. fal charges Google's exact published rate for Veo 3.1: $0.20 a second at 720p and 1080p without audio, $0.40 with, $0.40 and $0.60 at 4K, with no minimums.","marks":[]}]},{"_type":"block","_key":"b6752","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6751","text":"Same model, same price, no cloud project, no IAM roles, no storage bucket, no allowlist request and no reserved-capacity window. That is the whole pitch and it's a strong one.","marks":[]}]},{"_type":"block","_key":"b6754","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6753","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b6756","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6755","text":"Google's list price per second, so choosing it costs nothing in unit economics.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6758","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6757","text":"Genuinely on-demand, with no provisioned-throughput window between takes.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6760","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6759","text":"Wan, Kling and other models are behind the same API, so switching models is a parameter.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6762","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6761","text":"Pay per use with no subscription, which suits irregular volume.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6764","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6763","text":"A playground alongside the API, so a non-developer can at least check output.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6766","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b6765","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b6768","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6767","text":"It's not a creative surface and doesn't pretend to be. No canvas, no versions, no asset library, no collaboration, no brand controls. If nobody on the team writes code, this solves nothing.","marks":[]}]},{"_type":"block","_key":"b6770","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6769","text":"You also give up the governance stack without gaining a workspace, so it's the wrong answer for the enterprise buyer who chose Vertex for VPC Service Controls and the wrong answer for the creative director who wanted somewhere to work.","marks":[]}]},{"_type":"block","_key":"b6772","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6771","text":"The catch: it removes the cloud project and adds nothing else.","marks":[]}]},{"_type":"block","_key":"b6774","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6773","text":"Best for: engineering-supported teams who want Veo behind their own product and never wanted a console.","marks":[]}]},{"_type":"block","_key":"b6776","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6775","text":"When the platform is still the right answer","marks":[]}],"anchorId":"when-the-platform-is-still-the-right-answer"},{"_type":"block","_key":"b6778","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6777","text":"There's a real case for staying, and it isn't about the model. If your security review requires VPC Service Controls, customer-managed encryption keys or a data-residency commitment, no creative platform on this list will pass it. If legal requires an indemnity covering both training data and generated output, Google extends one on generally available Veo versions and the alternatives do not. If procurement is the binding constraint, putting AI spend on an existing cloud invoice can be worth more than any feature.","marks":[]}]},{"_type":"block","_key":"b6780","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6779","text":"The mistake is treating that as one decision. Governance and iteration are different requirements with different users, and the teams handling this well buy both: the platform for anything that ships through a controlled pipeline, and a creative surface where exploration actually happens. The alternative is a creative team that files a ticket to try an idea, which is how ideas stop being tried.","marks":[]}]},{"_type":"block","_key":"b6782","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6781","text":"So the question to ask isn't which one is better. It's which of the two problems you have, and whether the answer is the same for the person doing a security review and the person trying twenty versions of a shot before lunch.","marks":[]}]},{"_type":"block","_key":"b6784","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6783","text":"Frequently asked questions","marks":[]}],"anchorId":"frequently-asked-questions"},{"_type":"faqList","_key":"b6785","items":"$36:props:post:faq"},{"_type":"block","_key":"b6790","style":"normal","markDefs":[{"_type":"link","_key":"b6787","href":"https://app.melius.com","isNewTab":true}],"children":[{"_type":"span","_key":"b6786","text":"Run the same shot through Veo 3.1 and three other video models on one canvas, with no cloud project, no storage bucket and no capacity window between takes. ","marks":[]},{"_type":"span","_key":"b6788","text":"Open Melius","marks":["b6787"]},{"_type":"span","_key":"b6789","text":".","marks":[]}]}]}}]
37:["$","$L35","post-product-hero-shot",{"post":{"_key":"post-product-hero-shot","slug":"product-hero-shot","category":"guides","title":"How to generate a product hero shot on Melius","metaTitle":"How to make product photos with AI: the hero shot","isoDate":"2026-09-14","date":"September 14, 2026","readTime":"7 Min Read","excerpt":"Generate a product hero shot from a pack shot on Melius, and keep the product dimensionally and visually accurate instead of nearly right.","image":{"url":"/images/blog/product-hero-shot/cover.webp"},"authors":[{"name":"Melius Team"}],"faq":[{"question":"Can I use AI for product photography?","answer":"Yes, for hero shots, lifestyle scenes, background variants and channel-specific crops, generated from a pack shot you already have. What it does not do on its own is guarantee the product is accurate, which is why the workflow feeds in the product's real specifications and branding as separate inputs and ends with a check against the actual item."},{"question":"What is a product hero shot?","answer":"The main image a shopper sees first, on a listing, an ad or a landing page. It has to read at a glance and it has to look like the thing that arrives, which is why it's the shot where product fidelity matters most."},{"question":"Why does my logo come out wrong in AI product photos?","answer":"Because the model draws your logo from scratch on every generation. It rebuilds an approximation of everything in frame, and a logo is exactly the kind of arbitrary artwork that can't be inferred from context. Adding the logo file as its own reference node, and instructing the prompt not to redraw it, is the fix."},{"question":"Do I still need a photographer?","answer":"For the input, often yes. This workflow starts from a clean pack shot, and the quality of that photograph sets the ceiling on everything generated from it. What changes is the volume: one good pack shot can carry a season of scenes, ratios and variants that would each have been a separate setup."},{"question":"How do I keep a product consistent across many shots?","answer":"Build the canvas once on a single SKU until the output is right, then duplicate it and swap the inputs. Reusing the graph is what keeps the lighting and the framing from drifting between shots, and it's how high-volume teams produce variants at catalogue scale."},{"question":"What resolution should I generate product shots at?","answer":"2K or higher. Generating at 2K isn't the same as upscaling a 1K image afterwards: the model has more room to resolve fabric weave, embossed marks and label typography while it works, and upscaling later operates on an image whose fine detail is already gone. Note that the canvas preview is downscaled at any resolution, so judge sharpness from the full-screen view or the download."},{"question":"How much does generating product photos cost?","answer":"Generation runs on credits from one shared pool, whichever model a step uses, so trying the same shot on two models costs nothing extra in setup. Current plans and credit allowances are on the pricing page."}],"tableOfContents":[{"_key":"key-takeaways","title":"Key takeaways"},{"_key":"product-hero-shots-from-a-pack-shot","title":"Product hero shots from a pack shot"},{"_key":"why-generated-products-come-back-nearly-right","title":"Why generated products come back nearly right"},{"_key":"building-the-shot-step-by-step","title":"Building the shot, step by step"},{"_key":"where-product-shots-go-wrong","title":"Where product shots go wrong"},{"_key":"scaling-one-shot-across-a-catalogue","title":"Scaling one shot across a catalogue"},{"_key":"why-this-runs-the-way-it-does-on-melius","title":"Why this runs the way it does on Melius"},{"_key":"frequently-asked-questions","title":"FAQ"}],"content":[{"_type":"block","_key":"b6032","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6031","text":"Key takeaways","marks":[]}],"anchorId":"key-takeaways"},{"_type":"block","_key":"b6034","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6033","text":"A hero shot needs three separate inputs, not one prompt. A clean product shot, your product's real specifications, and a style reference each go in as their own node, and the prompt's job is mostly to say what must not change.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6036","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6035","text":"Branding is the part the model invents. An image model regenerates a logo rather than placing your logo file, so the mark comes back nearly right and specifically wrong. Give it the artwork as its own input and tell it not to redraw it.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6038","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6037","text":"A lifestyle photo is not a product reference. The model needs a clean, evenly lit view of the product itself. Mood references and product references do different jobs and go in separately.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6040","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6039","text":"Generate at 2K or higher, not 1K. Fine detail is where fidelity is won or lost: fabric weave, embossing, label type. More resolution gives the model more to work with on exactly those features.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6042","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6041","text":"Correct on the node, don't start over. When scale or placement is off, edit that node's prompt with the specific fix and re-run it. Re-prompting the whole canvas throws away the parts that worked.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6044","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6043","text":"Product hero shots from a pack shot","marks":[]}],"anchorId":"product-hero-shots-from-a-pack-shot"},{"_type":"block","_key":"b6046","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6045","text":"To generate a product hero shot on Melius, put a clean pack shot of the product on the canvas, add its real specifications and a style reference as separate inputs, connect all three into an image-to-image node at 2K, and write a prompt that names the scene while stating plainly that the product itself must not change. Then run three or four variations and inspect them full screen.","marks":[]}]},{"_type":"block","_key":"b6048","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6047","text":"The workflow is easy. Getting the product to look like your product is the part that takes practice, and it's the complaint marketers raise most often on onboarding calls. The shot is beautiful and the proportions are subtly off, or the logo resembles your logo, or the fabric drapes like a stock photo rather than like the thing you sell. Nearly all of that traces to one cause, and it's fixable.","marks":[]}]},{"_type":"block","_key":"b6050","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6049","text":"Why generated products come back nearly right","marks":[]}],"anchorId":"why-generated-products-come-back-nearly-right"},{"_type":"block","_key":"b6052","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6051","text":"An image model doesn't paste your product into a scene. Whatever falls inside the region it generates gets rebuilt as an approximation from what it can infer, so anything it can't infer gets invented. Your logo isn't a shape it can reason its way to, real proportions aren't recoverable from one photograph, and the weight and fall of your material isn't something a prompt adjective conveys.","marks":[]}]},{"_type":"block","_key":"b6054","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6053","text":"What fixes it is giving the model your actual assets as distinct inputs, then being explicit about which of them are fixed. Prompt wording alone won't get you there. Every step below removes one more thing from the set the model is guessing at.","marks":[]}]},{"_type":"block","_key":"b6056","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6055","text":"Building the shot, step by step","marks":[]}],"anchorId":"building-the-shot-step-by-step"},{"_type":"block","_key":"b6061","style":"normal","markDefs":[{"_type":"link","_key":"b6058","href":"https://docs.melius.com/help-center/marketers/recipes/product-swap","isNewTab":false}],"children":[{"_type":"span","_key":"b6057","text":"The click path is in the ","marks":[]},{"_type":"span","_key":"b6059","text":"help centre recipe for product photos and swaps","marks":["b6058"]},{"_type":"span","_key":"b6060","text":". The shape of the work is this:","marks":[]}]},{"_type":"block","_key":"b6063","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6062","text":"Drop your pack shot on the canvas. A clean product photo on a neutral background. If you have several angles, bring them all in and unified-group them, so the agent works from every angle rather than one.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6065","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6064","text":"Give the agent the real specifications. Ask it in chat to pull dimensions, materials and colour from your product page URL and save them as a text node. It now has your stated specs to work from rather than inferring everything from a photograph.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6067","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6066","text":"Add the logo as its own node. If the product carries visible branding, put the logo file on the canvas separately and connect it in. In the prompt, tell the model to use that reference exactly and not to redraw it.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6069","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6068","text":"Add a style reference for the look. A moodboard or a past campaign, turned into a style description. It governs light, composition and mood, and stays separate from everything describing the product.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6071","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6070","text":"Create an image-to-image node at 2K. Melius recommends Nano Banana Pro for material and lighting fidelity, and GPT Image 2 (High) where packaging text has to be legible (guidance current as of September 2026). Set the ratio you're shipping, and go 2K or 4K rather than 1K: the small features are the ones that give a shot away.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6073","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6072","text":"Wire the inputs to their jobs. Pack shot into the image input. Specifications, style description and logo into context. Then reference them by name in the prompt with @ mentions so the model knows which input governs what.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6075","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6074","text":"Write the prompt around what stays fixed. Name the scene in one line, then spend the rest on constraints: use the exact product from the reference, don't restyle it, don't change its colour, don't modify its shape or proportions.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6077","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6076","text":"Run three or four variations and inspect them full screen. The canvas preview is downscaled, and downscaling hides precisely the defects you're checking for. Open each candidate properly before you pick one.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6079","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6078","text":"Check the output against the actual item. Shape, colour, logo, any packaging text, proportions. A clean pack shot and real specs improve your odds; they do not remove the review step.","marks":[]}],"listItem":"number","level":1},{"_type":"block","_key":"b6081","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6080","text":"Where product shots go wrong","marks":[]}],"anchorId":"where-product-shots-go-wrong"},{"_type":"block","_key":"b6083","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6082","text":"A lifestyle photo was used as the product reference. The product is small, partly hidden and lit for mood, so the model never gets a clean look at it. Add a studio shot or a transparent PNG as a separate product input.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6085","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6084","text":"No specifications went in. Dimensions and materials get inferred from a single image, and the model has no way to know how big the thing is or what it's made of.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6087","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6086","text":"The logo was left to the model. Branding is the one element where close enough is still wrong, because anyone who knows the brand knows what the mark should look like. It needs to be an input, not an output.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6089","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6088","text":"The whole thing got re-prompted over one flaw. When the product is 20% too small or facing the wrong way, that's a one-clause correction on the existing node, not a fresh start.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6094","style":"normal","markDefs":[{"_type":"link","_key":"b6091","href":"https://docs.melius.com/help-center/marketers/picking-models","isNewTab":false}],"children":[{"_type":"span","_key":"b6090","text":"Typography and material were asked of one model. Rendering legible packaging copy and rendering convincing material are different problems, and a canvas can use a different model at each step. ","marks":[]},{"_type":"span","_key":"b6092","text":"Our per-job model guidance","marks":["b6091"]},{"_type":"span","_key":"b6093","text":" is in the help centre, and it changes as models ship.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b6096","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6095","text":"Scaling one shot across a catalogue","marks":[]}],"anchorId":"scaling-one-shot-across-a-catalogue"},{"_type":"block","_key":"b6098","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6097","text":"Once a canvas produces a shot you'd ship, the graph is the asset. Duplicate it, swap the pack shot and the specifications for the next SKU, and the light, composition and constraints carry over. That's how a team working through a catalogue gets consistency instead of forty shots that each look slightly different.","marks":[]}]},{"_type":"block","_key":"b6100","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6099","text":"The neighbouring jobs start from the same graph: background variants for seasonal scenes, a swap to drop your product into a scene you already have, re-composition for each channel's ratio. Melius ships a Product Swapper preset for the swap once it becomes routine.","marks":[]}]},{"_type":"block","_key":"b6102","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6101","text":"Why this runs the way it does on Melius","marks":[]}],"anchorId":"why-this-runs-the-way-it-does-on-melius"},{"_type":"block","_key":"b6104","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6103","text":"Melius is the Agentic OS for creative work, built on a node-based canvas where each input and output is a node and edges pass one node's result into the next. That structure is what makes product fidelity tractable: the pack shot, the specifications, the logo and the style are four things the graph holds separately, so you change one without disturbing the other three and re-run everything downstream.","marks":[]}]},{"_type":"block","_key":"b6106","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6105","text":"You brief an agent in plain language and it wires the graph and runs the models. Every step stays open, so the prompt behind a nearly-right shot is right there to correct. You direct; the agent produces.","marks":[]}]},{"_type":"block","_key":"b6108","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6107","text":"The models are on one subscription. Melius spans a library of leading models for image, video and audio, and agents route each step to the strongest one for that step unless you choose per node.","marks":[]}]},{"_type":"block","_key":"b6110","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6109","text":"You own the content you create on Melius and can use, publish, and distribute it commercially, subject to the underlying model providers' terms. Melius doesn't claim ownership of your work and doesn't use it to train AI models.","marks":[]}]},{"_type":"block","_key":"b6118","style":"normal","markDefs":[{"_type":"link","_key":"b6112","href":"/blog/static-ad-from-style-reference","isNewTab":false},{"_type":"link","_key":"b6115","href":"/blog/nano-banana-image-models","isNewTab":false}],"children":[{"_type":"span","_key":"b6111","text":"For related workflows, see ","marks":[]},{"_type":"span","_key":"b6113","text":"building a static ad from a style reference","marks":["b6112"]},{"_type":"span","_key":"b6114","text":" and ","marks":[]},{"_type":"span","_key":"b6116","text":"choosing a Nano Banana model","marks":["b6115"]},{"_type":"span","_key":"b6117","text":".","marks":[]}]},{"_type":"block","_key":"b6120","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6119","text":"Frequently asked questions","marks":[]}],"anchorId":"frequently-asked-questions"},{"_type":"faqList","_key":"b6121","items":"$37:props:post:faq"},{"_type":"block","_key":"b6126","style":"normal","markDefs":[{"_type":"link","_key":"b6123","href":"https://app.melius.com","isNewTab":false}],"children":[{"_type":"span","_key":"b6122","text":"Have a pack shot and a product page? ","marks":[]},{"_type":"span","_key":"b6124","text":"Open Melius","marks":["b6123"]},{"_type":"span","_key":"b6125","text":" and build the canvas on one SKU first.","marks":[]}]}]}}]
