3d:I[49710,["/_next/static/immutable/chunks/176631nmv93q8.js","/_next/static/immutable/chunks/20pevlmjlhelo.js","/_next/static/immutable/chunks/1chr4r7q0x6jr.js","/_next/static/immutable/chunks/3c0zy4y93486l.js","/_next/static/immutable/chunks/06w2rvx3-kxxg.js","/_next/static/immutable/chunks/2qicka26b4zda.js","/_next/static/immutable/chunks/2_1it5ua3j5ir.js","/_next/static/immutable/chunks/29d69g982pymu.js","/_next/static/immutable/chunks/0sog918pi80uv.js","/_next/static/immutable/chunks/0zke7d8fy0v9q.js","/_next/static/immutable/chunks/1xm1-c_qty48z.js","/_next/static/immutable/chunks/08pto-z6i41o-.js","/_next/static/immutable/chunks/200nhymd1sxma.js"],"default"]
14:["$","li","b6040",{"children":["Generate at 2K or higher, not 1K. Fine detail is where fidelity is won or lost: fabric weave, embossing, label type. More resolution gives the model more to work with on exactly those features."]}]
15:["$","li","b6042",{"children":["Correct on the node, don't start over. When scale or placement is off, edit that node's prompt with the specific fix and re-run it. Re-prompting the whole canvas throws away the parts that worked."]}]
16:["$","h2","b6044",{"id":"product-hero-shots-from-a-pack-shot","className":"scroll-mt-28","children":["Product hero shots from a pack shot"]}]
17:["$","p","b6046",{"children":["To generate a product hero shot on Melius, put a clean pack shot of the product on the canvas, add its real specifications and a style reference as separate inputs, connect all three into an image-to-image node at 2K, and write a prompt that names the scene while stating plainly that the product itself must not change. Then run three or four variations and inspect them full screen."]}]
18:["$","p","b6048",{"children":["The workflow is easy. Getting the product to look like your product is the part that takes practice, and it's the complaint marketers raise most often on onboarding calls. The shot is beautiful and the proportions are subtly off, or the logo resembles your logo, or the fabric drapes like a stock photo rather than like the thing you sell. Nearly all of that traces to one cause, and it's fixable."]}]
19:["$","h2","b6050",{"id":"why-generated-products-come-back-nearly-right","className":"scroll-mt-28","children":["Why generated products come back nearly right"]}]
1a:["$","p","b6052",{"children":["An image model doesn't paste your product into a scene. Whatever falls inside the region it generates gets rebuilt as an approximation from what it can infer, so anything it can't infer gets invented. Your logo isn't a shape it can reason its way to, real proportions aren't recoverable from one photograph, and the weight and fall of your material isn't something a prompt adjective conveys."]}]
1b:["$","p","b6054",{"children":["What fixes it is giving the model your actual assets as distinct inputs, then being explicit about which of them are fixed. Prompt wording alone won't get you there. Every step below removes one more thing from the set the model is guessing at."]}]
1c:["$","h2","b6056",{"id":"building-the-shot-step-by-step","className":"scroll-mt-28","children":["Building the shot, step by step"]}]
1d:["$","p","b6061",{"children":["The click path is in the ",["$","$L39","b6059",{"link":{"_type":"link","_key":"b6058","href":"https://docs.melius.com/help-center/marketers/recipes/product-swap","isNewTab":false},"children":["help centre recipe for product photos and swaps"]}],". The shape of the work is this:"]}]
1e:["$","ol","b6063-parent",{"children":[["$","li","b6063",{"children":["Drop your pack shot on the canvas. A clean product photo on a neutral background. If you have several angles, bring them all in and unified-group them, so the agent works from every angle rather than one."]}],["$","li","b6065",{"children":["Give the agent the real specifications. Ask it in chat to pull dimensions, materials and colour from your product page URL and save them as a text node. It now has your stated specs to work from rather than inferring everything from a photograph."]}],["$","li","b6067",{"children":["Add the logo as its own node. If the product carries visible branding, put the logo file on the canvas separately and connect it in. In the prompt, tell the model to use that reference exactly and not to redraw it."]}],["$","li","b6069",{"children":["Add a style reference for the look. A moodboard or a past campaign, turned into a style description. It governs light, composition and mood, and stays separate from everything describing the product."]}],["$","li","b6071",{"children":["Create an image-to-image node at 2K. Melius recommends Nano Banana Pro for material and lighting fidelity, and GPT Image 2 (High) where packaging text has to be legible (guidance current as of September 2026). Set the ratio you're shipping, and go 2K or 4K rather than 1K: the small features are the ones that give a shot away."]}],["$","li","b6073",{"children":["Wire the inputs to their jobs. Pack shot into the image input. Specifications, style description and logo into context. Then reference them by name in the prompt with @ mentions so the model knows which input governs what."]}],["$","li","b6075",{"children":["Write the prompt around what stays fixed. Name the scene in one line, then spend the rest on constraints: use the exact product from the reference, don't restyle it, don't change its colour, don't modify its shape or proportions."]}],["$","li","b6077",{"children":["Run three or four variations and inspect them full screen. The canvas preview is downscaled, and downscaling hides precisely the defects you're checking for. Open each candidate properly before you pick one."]}],["$","li","b6079",{"children":["Check the output against the actual item. Shape, colour, logo, any packaging text, proportions. A clean pack shot and real specs improve your odds; they do not remove the review step."]}]]}]
1f:["$","h2","b6081",{"id":"where-product-shots-go-wrong","className":"scroll-mt-28","children":["Where product shots go wrong"]}]
20:["$","ul","b6083-parent",{"children":[["$","li","b6083",{"children":["A lifestyle photo was used as the product reference. The product is small, partly hidden and lit for mood, so the model never gets a clean look at it. Add a studio shot or a transparent PNG as a separate product input."]}],["$","li","b6085",{"children":["No specifications went in. Dimensions and materials get inferred from a single image, and the model has no way to know how big the thing is or what it's made of."]}],["$","li","b6087",{"children":["The logo was left to the model. Branding is the one element where close enough is still wrong, because anyone who knows the brand knows what the mark should look like. It needs to be an input, not an output."]}],["$","li","b6089",{"children":["The whole thing got re-prompted over one flaw. When the product is 20% too small or facing the wrong way, that's a one-clause correction on the existing node, not a fresh start."]}],["$","li","b6094",{"children":["Typography and material were asked of one model. Rendering legible packaging copy and rendering convincing material are different problems, and a canvas can use a different model at each step. ",["$","$L39","b6092",{"link":{"_type":"link","_key":"b6091","href":"https://docs.melius.com/help-center/marketers/picking-models","isNewTab":false},"children":["Our per-job model guidance"]}]," is in the help centre, and it changes as models ship."]}]]}]
21:["$","h2","b6096",{"id":"scaling-one-shot-across-a-catalogue","className":"scroll-mt-28","children":["Scaling one shot across a catalogue"]}]
22:["$","p","b6098",{"children":["Once a canvas produces a shot you'd ship, the graph is the asset. Duplicate it, swap the pack shot and the specifications for the next SKU, and the light, composition and constraints carry over. That's how a team working through a catalogue gets consistency instead of forty shots that each look slightly different."]}]
23:["$","p","b6100",{"children":["The neighbouring jobs start from the same graph: background variants for seasonal scenes, a swap to drop your product into a scene you already have, re-composition for each channel's ratio. Melius ships a Product Swapper preset for the swap once it becomes routine."]}]
24:["$","h2","b6102",{"id":"why-this-runs-the-way-it-does-on-melius","className":"scroll-mt-28","children":["Why this runs the way it does on Melius"]}]
25:["$","p","b6104",{"children":["Melius is the Agentic OS for creative work, built on a node-based canvas where each input and output is a node and edges pass one node's result into the next. That structure is what makes product fidelity tractable: the pack shot, the specifications, the logo and the style are four things the graph holds separately, so you change one without disturbing the other three and re-run everything downstream."]}]
26:["$","p","b6106",{"children":["You brief an agent in plain language and it wires the graph and runs the models. Every step stays open, so the prompt behind a nearly-right shot is right there to correct. You direct; the agent produces."]}]
27:["$","p","b6108",{"children":["The models are on one subscription. Melius spans a library of leading models for image, video and audio, and agents route each step to the strongest one for that step unless you choose per node."]}]
28:["$","p","b6110",{"children":["You own the content you create on Melius and can use, publish, and distribute it commercially, subject to the underlying model providers' terms. Melius doesn't claim ownership of your work and doesn't use it to train AI models."]}]
29:["$","p","b6118",{"children":["For related workflows, see ",["$","$L39","b6113",{"link":{"_type":"link","_key":"b6112","href":"/blog/static-ad-from-style-reference","isNewTab":false},"children":["building a static ad from a style reference"]}]," and ",["$","$L39","b6116",{"link":{"_type":"link","_key":"b6115","href":"/blog/nano-banana-image-models","isNewTab":false},"children":["choosing a Nano Banana model"]}],"."]}]
2a:["$","h2","b6120",{"id":"frequently-asked-questions","className":"scroll-mt-28","children":["Frequently asked questions"]}]
2b:["$","div","b6121",{"className":"faq-list my-10 flex flex-col divide-y divide-black/10 border-y border-black/10","children":[["$","details","0",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["Can I use AI for product photography?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"Yes, for hero shots, lifestyle scenes, background variants and channel-specific crops, generated from a pack shot you already have. What it does not do on its own is guarantee the product is accurate, which is why the workflow feeds in the product's real specifications and branding as separate inputs and ends with a check against the actual item."}]]}],["$","details","1",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["What is a product hero shot?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"The main image a shopper sees first, on a listing, an ad or a landing page. It has to read at a glance and it has to look like the thing that arrives, which is why it's the shot where product fidelity matters most."}]]}],["$","details","2",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["Why does my logo come out wrong in AI product photos?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"Because the model draws your logo from scratch on every generation. It rebuilds an approximation of everything in frame, and a logo is exactly the kind of arbitrary artwork that can't be inferred from context. Adding the logo file as its own reference node, and instructing the prompt not to redraw it, is the fix."}]]}],["$","details","3",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["Do I still need a photographer?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"For the input, often yes. This workflow starts from a clean pack shot, and the quality of that photograph sets the ceiling on everything generated from it. What changes is the volume: one good pack shot can carry a season of scenes, ratios and variants that would each have been a separate setup."}]]}],"$L3a","$L3b","$L3c"]}]
2c:["$","p","b6126",{"children":["Have a pack shot and a product page? ",["$","$L39","b6124",{"link":{"_type":"link","_key":"b6123","href":"https://app.melius.com","isNewTab":false},"children":["Open Melius"]}]," and build the canvas on one SKU first."]}]
2d:["$","section","related",{"className":"relative w-full pb-section bg-gray-background","children":[["$","$L11",null,{"color":"gray"}],["$","div",null,{"className":"relative z-10 mx-auto w-full max-w-300 px-5 lg:px-8","children":[["$","h2",null,{"className":"t-h-2 mb-12 text-center text-balance text-gray-dark-1","children":"Related Articles"}],["$","div",null,{"className":"mx-auto grid w-full max-w-max grid-cols-1 gap-11 md:grid-cols-2 lg:grid-cols-3","children":[["$","$L3d","post-ai-video-generators-filmmakers-compared",{"post":{"_key":"post-ai-video-generators-filmmakers-compared","slug":"ai-video-generators-filmmakers-compared","category":"comparisons","title":"AI video generators for filmmakers, compared","isoDate":"2026-09-14","date":"September 14, 2026","readTime":"22 Min Read","excerpt":"Eight tools compared on what a director actually needs: shot control, consistency across cuts, an editorial surface, and whether the footage clears.","image":{"url":"/images/blog/ai-video-generators-filmmakers-compared/cover.webp"},"authors":[{"name":"Melius Team"}],"faq":[{"question":"What is the best AI video generator for filmmakers?","answer":"There isn't one, and the honest answer depends on which constraint binds. Runway has the best edit surface, Luma the best color and finishing, Kling the best per-shot camera control, Google Flow the best dialogue and coverage, and Moonvalley Marey and Adobe Firefly both emphasize licensed training data for commercial work. Melius combines access to leading models with image, video and audio uploads and an in-app multi-track editor, so generation and assembly can happen in one workflow."},{"question":"Can you use AI-generated video in a film festival entry?","answer":"It depends on the festival, and the rules are mostly about disclosure rather than prohibition. The Academy's 99th Oscars rules require acting roles to be credited in the legal billing and demonstrably performed by humans with their consent, and screenplays to be human-authored, which closes those two categories to AI while leaving the rest of the ballot open. The same rules say generative AI tools neither help nor harm the chances of a nomination, with each branch judging the degree to which a human was at the heart of the creative authorship. Sundance, SXSW and Tribeca lean on disclosure. Cannes publishes no AI provision in its 2026 feature-film regulations at all, so check the specific festival's current rules before you submit."},{"question":"Is Sora still available?","answer":"No. OpenAI discontinued the Sora web and app experiences on 26 April 2026, and its own help centre states the Sora API will be discontinued on 24 September 2026. OpenAI has not announced a successor video model. Several roundups and a few platforms still list Sora 2 as available, so treat any current recommendation of it as out of date."},{"question":"How long can AI-generated video clips be?","answer":"Native single-shot length runs from a few seconds to 30 depending on the model, and that number matters more than any advertised maximum. Veo 3.1 does 8 seconds, Gemini Omni Flash 10, Kling 3.0 up to 15, Luma's Ray3.2 offers 5 or 10 seconds for text-to-video and image-to-video, or up to 20 seconds when modifying existing video, and Seedance 2.5 up to 30 in a single generation. Anything longer is stitched, and stitching is where faces, wardrobe and lighting start to drift."},{"question":"Do you own the rights to AI-generated footage?","answer":"Usually yes on a paid plan, but the terms differ enough that they need checking per tool before anything is delivered. On Melius, you own what you create and can use it commercially, subject to the underlying model providers' terms, and Melius does not use your work to train AI models. Elsewhere the variation is real: Runway trains on your inputs and outputs on every plan below Enterprise, Luma requires an active paid subscription at the moment of generation for commercial rights to vest, and free tiers across the category generally grant the provider far broader rights than paid ones."},{"question":"Which AI video model is the highest quality right now?","answer":"On blind preference testing, Alibaba's Wan 3.0 and Google's Gemini Omni Flash are tied at the top, followed by MiniMax H3 Max and then the Seedance 2.0 entry. The uncomfortable part for a filmmaker is that the top of that board is almost entirely models with restricted, unclear or litigated Western commercial terms, and that neither Runway's Gen-4.5 nor any Luma model appears anywhere on the with-audio board at all, despite being the two most production-ready tools here. Quality rankings and usability rankings are not the same list."}],"tableOfContents":[{"_key":"which-ai-video-generator-should-a-filmmaker-use","title":"Which AI video generator should a filmmaker use?"},{"_key":"what-to-know-before-you-pick","title":"What to know before you pick"},{"_key":"what-separates-a-good-tool-for-film-work","title":"What separates a good tool for film work?"},{"_key":"the-eight-compared","title":"The eight compared"},{"_key":"1-melius","title":"1. Melius"},{"_key":"2-runway","title":"2. Runway"},{"_key":"3-google-flow","title":"3. Google Flow"},{"_key":"4-luma","title":"4. Luma"},{"_key":"5-kling","title":"5. Kling"},{"_key":"6-moonvalley-marey","title":"6. Moonvalley Marey"},{"_key":"7-ltx-studio","title":"7. LTX Studio"},{"_key":"8-adobe","title":"8. Adobe"},{"_key":"what-still-needs-a-camera","title":"What still needs a camera"},{"_key":"frequently-asked-questions","title":"FAQ"}],"content":[{"_type":"block","_key":"b5575","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5574","text":"Which AI video generator should a filmmaker use?","marks":[]}],"anchorId":"which-ai-video-generator-should-a-filmmaker-use"},{"_type":"block","_key":"b5577","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5576","text":"Decide first whether the footage has to clear, because that single question splits this category in two and the split has nothing to do with output quality. If the work is going to a client, a festival or a distributor, provenance and rights govern, and the models at the top of the quality leaderboards are mostly the ones you can't use. If it's a test, a pitch piece or a look-development pass, pick on control and ignore the paperwork.","marks":[]}]},{"_type":"block","_key":"b5579","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5578","text":"The second thing to settle is where the cut happens. Some of these tools generate and hand you files. Some now generate inside a timeline. That difference decides whether you're editing a film or reconciling a folder of clips, and it matters more day to day than any spec on the model card.","marks":[]}]},{"_type":"block","_key":"b5581","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5580","text":"What to know before you pick","marks":[]}],"anchorId":"what-to-know-before-you-pick"},{"_type":"block","_key":"b5583","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5582","text":"Native shot length is the spec that matters, not maximum length. Stitching is where faces drift, wardrobe shifts and lighting rolls, so a tool that gives you 20 seconds in one take beats one that reaches 20 by joining four.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5585","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5584","text":"For the 99th Oscars the Academy requires acting roles to be credited in the film's legal billing and demonstrably performed by humans with their consent, and screenplays to be human-authored. That closes the acting and writing categories to AI and leaves the rest of the ballot open.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5587","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5586","text":"Check who trains on your material. Runway trains on inputs and outputs by default on every plan below Enterprise, and free tiers across this category generally grant much broader rights than paid ones.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5589","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5588","text":"Test the second and third shot, never the first. Identity drift across a sequence ruins a scene faster than any single clip's quality, and it doesn't show up in a demo reel.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5591","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5590","text":"What separates a good tool for film work?","marks":[]}],"anchorId":"what-separates-a-good-tool-for-film-work"},{"_type":"block","_key":"b5593","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5592","text":"Four criteria, and the last one eliminates most of the current quality leaders for anything that has to be delivered.","marks":[]}]},{"_type":"block","_key":"b5595","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5594","text":"It's directable, not promptable","marks":[]}]},{"_type":"block","_key":"b5597","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5596","text":"A prompt describes a vibe. A shot list describes a lens, a height, a move and a duration. The tools worth a director's time let you specify those separately from the content, so you can keep the scene and change the coverage.","marks":[]}]},{"_type":"block","_key":"b5599","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5598","text":"The gap here is wide. Kling's Video 3.0 Omni takes duration, shot size, perspective and camera movement per shot in a custom multi-shot plan. Seedance 2.5 accepts 3D camera blockouts, which is the closest thing in the category to actual blocking. Most other tools offer a preset menu and hope.","marks":[]}]},{"_type":"block","_key":"b5601","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5600","text":"The character survives the cut","marks":[]}]},{"_type":"block","_key":"b5603","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5602","text":"Consistency inside one clip is a solved problem. Consistency across a scene isn't, and it's the thing that separates footage you can edit from footage you can only post. Look for reference systems that persist: multiple reference images, character nodes, first and last frame conditioning, or a conversational context that holds a face and a wardrobe across successive generations.","marks":[]}]},{"_type":"block","_key":"b5605","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5604","text":"The honest test is a shot-reverse-shot. Generate a wide, then a matching close, then go back to the wide. If the jacket changed, the tool cannot cut a scene yet.","marks":[]}]},{"_type":"block","_key":"b5607","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5606","text":"It lands in a timeline","marks":[]}]},{"_type":"block","_key":"b5609","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5608","text":"2026 is the year this stopped being a nice-to-have. Adobe put generative models inside the Premiere timeline in September, Runway built a purpose-built edit surface around its editing model, and LTX Studio ships a script-to-shot-sequence front end. Melius also includes an in-app multi-track editor, so you can generate shots, arrange them and layer audio in one workspace. Tools without an editing surface still ask you to export, import and reconcile.","marks":[]}]},{"_type":"block","_key":"b5611","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5610","text":"The round trip isn't a small tax. It's where versions multiply, where a re-generated shot loses its place in the cut, and where most of the time on an AI-assisted project actually goes.","marks":[]}]},{"_type":"block","_key":"b5613","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5612","text":"The footage clears","marks":[]}]},{"_type":"block","_key":"b5615","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5614","text":"Two models in this comparison are trained only on material their makers licensed: Moonvalley's Marey, built largely on B-roll that filmmakers and agencies deliberately licensed plus archive partnerships, and Adobe's Firefly, trained on licensed Adobe Stock and public domain content and never on customer work. Everything else carries some degree of open question.","marks":[]}]},{"_type":"block","_key":"b5617","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5616","text":"The question isn't academic in 2026. Disney and Paramount Skydance sent cease-and-desist letters to ByteDance over Seedance 2.0, MiniMax is in active copyright litigation brought by Disney, Universal and Warner Bros. Discovery, and its open-weights license excludes the US, UK, EU and South Korea by default, and Alibaba's Wan 3.0 is API-only and closed-weight, with no published weights or license text at all. A legal department will clear Marey and Firefly. It'll ask hard questions about the rest.","marks":[]}]},{"_type":"block","_key":"b5619","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5618","text":"The eight compared","marks":[]}],"anchorId":"the-eight-compared"},{"_type":"block","_key":"b5621","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5620","text":"Capabilities as of September 2026, from each tool's own documentation, model cards and pricing pages. No scores: which shot looks better is a judgment call, so every column here is something you can verify.","marks":[]}]},{"_type":"portableTable","_key":"b5622","rows":[{"_key":"b5623","cells":[{"_key":"b5624","text":[{"_type":"block","_key":"b5626","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5625","text":"Tool","marks":["strong"]}]}]},{"_key":"b5627","text":[{"_type":"block","_key":"b5629","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5628","text":"Best at","marks":["strong"]}]}]},{"_key":"b5630","text":[{"_type":"block","_key":"b5632","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5631","text":"Native single shot","marks":["strong"]}]}]},{"_key":"b5633","text":[{"_type":"block","_key":"b5635","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5634","text":"Editorial surface","marks":["strong"]}]}]},{"_key":"b5636","text":[{"_type":"block","_key":"b5638","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5637","text":"Clearance posture","marks":["strong"]}]}]}]},{"_key":"b5639","cells":[{"_key":"b5640","text":[{"_type":"block","_key":"b5642","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5641","text":"Melius","marks":[]}]}]},{"_key":"b5643","text":[{"_type":"block","_key":"b5645","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5644","text":"Reaching every leading video model in one workflow","marks":[]}]}]},{"_key":"b5646","text":[{"_type":"block","_key":"b5648","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5647","text":"Depends on the model you route to","marks":[]}]}]},{"_key":"b5649","text":[{"_type":"block","_key":"b5651","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5650","text":"In-app multi-track editor, plus canvas-based workflows","marks":[]}]}]},{"_key":"b5652","text":[{"_type":"block","_key":"b5654","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5653","text":"You own the output, subject to each model provider's terms","marks":[]}]}]}]},{"_key":"b5655","cells":[{"_key":"b5656","text":[{"_type":"block","_key":"b5658","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5657","text":"Runway","marks":[]}]}]},{"_key":"b5659","text":[{"_type":"block","_key":"b5661","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5660","text":"Propagating an edit across a multi-shot sequence","marks":[]}]}]},{"_key":"b5662","text":[{"_type":"block","_key":"b5664","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5663","text":"2 to 10 seconds on Gen-4.5","marks":[]}]}]},{"_key":"b5665","text":[{"_type":"block","_key":"b5667","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5666","text":"Edit Studio, plus Premiere and After Effects plugins","marks":[]}]}]},{"_key":"b5668","text":[{"_type":"block","_key":"b5670","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5669","text":"Trains on your work on every plan below Enterprise","marks":[]}]}]}]},{"_key":"b5671","cells":[{"_key":"b5672","text":[{"_type":"block","_key":"b5674","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5673","text":"Google Flow","marks":[]}]}]},{"_key":"b5675","text":[{"_type":"block","_key":"b5677","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5676","text":"Coverage with native synchronized dialogue","marks":[]}]}]},{"_key":"b5678","text":[{"_type":"block","_key":"b5680","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5679","text":"4, 6 or 8 seconds on Veo 3.1, 10 on Gemini Omni Flash","marks":[]}]}]},{"_key":"b5681","text":[{"_type":"block","_key":"b5683","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5682","text":"Flow canvas and Scenebuilder","marks":[]}]}]},{"_key":"b5684","text":[{"_type":"block","_key":"b5686","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5685","text":"SynthID on every output, visible watermark is a toggle","marks":[]}]}]}]},{"_key":"b5687","cells":[{"_key":"b5688","text":[{"_type":"block","_key":"b5690","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5689","text":"Luma","marks":[]}]}]},{"_key":"b5691","text":[{"_type":"block","_key":"b5693","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5692","text":"Color and finishing that survive a real grade","marks":[]}]}]},{"_key":"b5694","text":[{"_type":"block","_key":"b5696","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5695","text":"5 or 10 seconds; up to 20 in video-to-video","marks":[]}]}]},{"_key":"b5697","text":[{"_type":"block","_key":"b5699","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5698","text":"None, it exports to yours","marks":[]}]}]},{"_key":"b5700","text":[{"_type":"block","_key":"b5702","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5701","text":"You retain outputs, commercial use needs a paid plan","marks":[]}]}]}]},{"_key":"b5703","cells":[{"_key":"b5704","text":[{"_type":"block","_key":"b5706","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5705","text":"Kling","marks":[]}]}]},{"_key":"b5707","text":[{"_type":"block","_key":"b5709","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5708","text":"Per-shot camera direction and blocking","marks":[]}]}]},{"_key":"b5710","text":[{"_type":"block","_key":"b5712","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5711","text":"3 to 15 seconds on Video 3.0","marks":[]}]}]},{"_key":"b5713","text":[{"_type":"block","_key":"b5715","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5714","text":"None","marks":[]}]}]},{"_key":"b5716","text":[{"_type":"block","_key":"b5718","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5717","text":"Terms expect outputs marked as AI generated","marks":[]}]}]}]},{"_key":"b5719","cells":[{"_key":"b5720","text":[{"_type":"block","_key":"b5722","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5721","text":"Moonvalley Marey","marks":[]}]}]},{"_key":"b5723","text":[{"_type":"block","_key":"b5725","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5724","text":"Footage a legal department will clear","marks":[]}]}]},{"_key":"b5726","text":[{"_type":"block","_key":"b5728","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5727","text":"5 or 10 seconds via its inference partner","marks":[]}]}]},{"_key":"b5729","text":[{"_type":"block","_key":"b5731","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5730","text":"None, built for your pipeline","marks":[]}]}]},{"_key":"b5732","text":[{"_type":"block","_key":"b5734","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5733","text":"Trained only on owned and licensed data","marks":[]}]}]}]},{"_key":"b5735","cells":[{"_key":"b5736","text":[{"_type":"block","_key":"b5738","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5737","text":"LTX Studio","marks":[]}]}]},{"_key":"b5739","text":[{"_type":"block","_key":"b5741","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5740","text":"Pre-production structure, and open weights","marks":[]}]}]},{"_key":"b5742","text":[{"_type":"block","_key":"b5744","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5743","text":"Multishot in one pass, auto duration","marks":[]}]}]},{"_key":"b5745","text":[{"_type":"block","_key":"b5747","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5746","text":"Script to shot sequence, plus an edit suite","marks":[]}]}]},{"_key":"b5748","text":[{"_type":"block","_key":"b5750","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5749","text":"Open-weights license with a revenue threshold","marks":[]}]}]}]},{"_key":"b5751","cells":[{"_key":"b5752","text":[{"_type":"block","_key":"b5754","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5753","text":"Adobe","marks":[]}]}]},{"_key":"b5755","text":[{"_type":"block","_key":"b5757","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5756","text":"Generating without leaving the cut","marks":[]}]}]},{"_key":"b5758","text":[{"_type":"block","_key":"b5760","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5759","text":"2 seconds of Generative Extend","marks":[]}]}]},{"_key":"b5761","text":[{"_type":"block","_key":"b5763","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5762","text":"Premiere Pro and After Effects","marks":[]}]}]},{"_key":"b5764","text":[{"_type":"block","_key":"b5766","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5765","text":"Firefly is licensed-only, partner models are not","marks":[]}]}]}]}]},{"_type":"block","_key":"b5768","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5767","text":"1. Melius","marks":[]}],"anchorId":"1-melius"},{"_type":"block","_key":"b5770","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5769","text":"Melius is the Agentic OS for creative work: you describe what you want and an agent builds the workflow, routes each step to a model and leaves every step open for you to change. A node-based canvas sits underneath, so a sequence is a graph you can inspect, branch and re-run, not a queue of unrelated jobs.","marks":[]}]},{"_type":"block","_key":"b5772","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5771","text":"For film work the argument is reach. One subscription puts Veo 3.1, Kling 3, Wan 3.0 and the Seedance family on the same canvas, alongside the rest of the library of leading models and the lipsync and avatar models. That matters because no single video model currently wins on shot control, audio, duration and grade at once, and the alternative to routing between them is eight subscriptions and eight interfaces.","marks":[]}]},{"_type":"block","_key":"b5774","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5773","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5776","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5775","text":"Upload images, video and audio to the shared asset library and canvas, so a project can start with existing footage as well as generated material.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5778","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5777","text":"Per-step model routing, so the model that carries the motion isn't the one asked to hold a face, and the choice is per node, not per project.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5780","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5779","text":"Branching, which is the natural shape of comparing two directions on the same shot without rebuilding anything.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5782","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5781","text":"A Storyboard template turns a single image into a nine-panel sequence, which is a fast way to agree coverage before you spend on generation.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5784","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5783","text":"Reference and character nodes carry one look across every clip in a set, and changing an upstream node re-runs everything below it.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5786","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5785","text":"Every canvas is real-time and collaborative by default, so a director and a producer work in one place instead of trading exports.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5788","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5787","text":"It's drivable from Slack, a command line, an API and the Model Context Protocol (MCP), so a look-development pass can run from wherever the rest of the team already works.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5790","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5789","text":"Melius includes video editing and an in-app multi-track editor for arranging shots, timing and layering audio. Stitch nodes are another way to assemble clips on the canvas, not the only way to edit. You can work with generated shots and uploaded footage in the same workspace.","marks":[]}]},{"_type":"block","_key":"b5792","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5791","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b5794","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5793","text":"The trade-off is at the model level: supported references, native shot lengths, audio generation and output formats vary by the model you select. A shared workspace does not make those capabilities identical, so choose the model for each shot's requirements.","marks":[]}]},{"_type":"block","_key":"b5796","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5795","text":"The catch: one workspace brings generation, assets and editing together, but each model still has its own capabilities and terms.","marks":[]}]},{"_type":"block","_key":"b5798","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5797","text":"Best for: directors and small teams who want look development, previz, shot exploration and multi-track editing in one place, with a visible, re-runnable process and support for existing footage.","marks":[]}]},{"_type":"block","_key":"b5803","style":"normal","markDefs":[{"_type":"link","_key":"b5800","href":"/pricing","isNewTab":false}],"children":[{"_type":"span","_key":"b5799","text":"See ","marks":[]},{"_type":"span","_key":"b5801","text":"Melius pricing","marks":["b5800"]},{"_type":"span","_key":"b5802","text":" for current plans and allowances.","marks":[]}]},{"_type":"block","_key":"b5805","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5804","text":"2. Runway","marks":[]}],"anchorId":"2-runway"},{"_type":"block","_key":"b5807","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5806","text":"Runway is the closest thing this category has to an industry standard, and in 2026 it has become the most editorially serious of the pure-plays. Aleph 2.0 and Edit Studio, both shipped on 21 May, give you a real edit surface where an instruction propagates across cuts in a multi-shot sequence rather than applying to one clip. Ruby, added in late August, is a Runway-native color grading model that takes an SDR input and produces true HDR.","marks":[]}]},{"_type":"block","_key":"b5809","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5808","text":"September brought Runway plugins for Premiere Pro and After Effects, which puts its whole lineup inside the applications editors already live in. It also now hosts third-party models, including Wan 3.0 and Seedance 2.5 at 1080p, which is the cleanest route a US filmmaker has to either.","marks":[]}]},{"_type":"block","_key":"b5811","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5810","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5813","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5812","text":"Edit Studio takes an input video between 2 and 30 seconds at up to 1080p with no more than ten cuts, and Aleph 2.0 applies your edit across the relevant shots.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5815","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5814","text":"Runway builds its own frontier models and ships them continuously: Aleph 2.0 and Ruby this summer, then Solaris and GWM Worlds 2 within four days of each other in late August and early September.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5817","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5816","text":"Genuine camera and motion control that assumes you know what a camera does.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5819","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5818","text":"The Adobe plugins remove the round trip for anyone cutting in Premiere.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5821","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5820","text":"Long-established use in professional film and advertising, so craft knowledge and tutorials are easy to find.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5823","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5822","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b5825","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5824","text":"Two problems, and the first is uncomfortable. Runway's terms of use say inputs and outputs may be used to train and improve its models, and that applies to every plan except Enterprise, which is where you get no training on your data plus uncapped IP indemnification. For a director working on unreleased material that's a real objection, not a technicality.","marks":[]}]},{"_type":"block","_key":"b5827","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5826","text":"The second is the credit budget. Runway meters generation by model and duration, so compare the current plan allowance with the shots and revisions you expect to produce. Gen-4.5 also sits outside the top ten on the blind preference boards, so you are paying for the surface around the model more than for the model.","marks":[]}]},{"_type":"block","_key":"b5829","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5828","text":"The catch: the best edit surface in the category, on a model that no longer tops the rankings.","marks":[]}]},{"_type":"block","_key":"b5831","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5830","text":"Best for: editors and directors who want generation and assembly in one place and are cutting in Premiere anyway.","marks":[]}]},{"_type":"block","_key":"b5833","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5832","text":"3. Google Flow","marks":[]}],"anchorId":"3-google-flow"},{"_type":"block","_key":"b5835","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5834","text":"Flow is Google's filmmaking front end, and it's the strongest all-rounder here for narrative coverage. Veo 3.1 produces 4, 6 or 8 second clips at 1080p and 4K, with 8 seconds available at those resolutions or when you pass reference images, and it generates native synchronized audio covering dialogue, effects and ambience in the same pass.","marks":[]}]},{"_type":"block","_key":"b5837","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5836","text":"Gemini Omni Flash, announced in May, is the more interesting half. It's any-to-any, generates with native audio, and holds a character consistent across cuts through multi-turn editing, where Google's own framing is that the physics hold up and the scene remembers what came before. So you refine by talking about it instead of re-uploading references each time. Voice editing is not part of it.","marks":[]}]},{"_type":"block","_key":"b5839","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5838","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5841","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5840","text":"Native synchronized dialogue with accurate lip movement, which removes a whole ADR-shaped problem.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5843","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5842","text":"Ingredients to Video takes multiple reference images controlling character, object and style at once.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5845","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5844","text":"Frames to Video gives you start and end image control, and Extend runs a sequence past a minute.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5847","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5846","text":"Video-to-video editing, Characters and Avatars round out the surface, so a fix does not always mean a fresh generation.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5849","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5848","text":"Gemini Omni Flash sits at the top of the blind text-to-video rankings, so the quality is not a compromise.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5851","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5850","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b5853","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5852","text":"The clip ceiling is 8 seconds on Veo and 10 on Omni, which is short enough to shape how you write. Every Flow output also carries an invisible SynthID watermark, detectable programmatically rather than visible to a viewer. The visible watermark is a separate thing and it is worth getting right: it's a toggle in your own profile menu, not a paid-tier perk, and Flow applies it automatically only if you're in India, South Korea or Vietnam.","marks":[]}]},{"_type":"block","_key":"b5855","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5854","text":"Google's commercial-rights language is also notably hard to locate for a product being sold to professionals, and Flow's own community forum carries unanswered questions about it. Note too that Flow is an individual Google AI subscription with no team tier, so a second person on the project means a second subscription.","marks":[]}]},{"_type":"block","_key":"b5857","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5856","text":"The catch: the best all-round output, and the shortest shots.","marks":[]}]},{"_type":"block","_key":"b5859","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5858","text":"Best for: directors who need dialogue and coverage more than long takes, and who can absorb the top tier.","marks":[]}]},{"_type":"block","_key":"b5861","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5860","text":"4. Luma","marks":[]}],"anchorId":"4-luma"},{"_type":"block","_key":"b5863","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5862","text":"Luma's Ray3.2, out in June, has the best finishing story in the category by a distance, and it's the only entry here that a colorist would recognize as pipeline-ready. It generates in native 16-bit color and exports 16-bit EXR frames in ACES2065-1, which drop straight into a grade and a comp without a conversion step.","marks":[]}]},{"_type":"block","_key":"b5865","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5864","text":"It also gives the most granular in-clip pacing control available: Multi-Keyframe sets up to 16 keyframes inside a single clip, and performance tracking follows the full expressive state of up to eight faces frame by frame, with motion transfer and camera motion transfer alongside it.","marks":[]}]},{"_type":"block","_key":"b5867","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5866","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5869","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5868","text":"Resolutions from 360p to 1080p, with Modify Video reaching up to 20 seconds at 24fps and Reframe handling sources up to 16 seconds.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5871","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5870","text":"EXR output in ACES2065-1 and native 16-bit color, so the footage behaves like footage in a grade, and HDR works in video-to-video too.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5873","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5872","text":"16 keyframes per clip for real control over beats inside a shot.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5875","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5874","text":"Performance tracking across eight faces, and Modify Video preserves lip sync and dialogue timing when face tracking is on.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5877","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5876","text":"Ray3.2 was developed with working creatives from film, advertising and games, and ships an API aimed at studio pipelines.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5879","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5878","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b5881","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5880","text":"No native audio on text-to-video or image-to-video. Luma's own FAQ is blunt about it: voiceover, music and sound effects are a separate step. Modify Video and Reframe preserve audio that already exists, but Luma will not generate a soundtrack, so anything with dialogue needs a second tool. The bigger constraint is length. Text-to-video and image-to-video produce 5-second or 10-second native clips, and the 20-second figure you will see quoted belongs to Modify Video, which needs footage to start from.","marks":[]}]},{"_type":"block","_key":"b5883","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5882","text":"Commercial rights need care too. Luma's terms tie commercial use to whether an output was produced during an active paid subscription term. Check the current plan's commercial-use terms before generating client work; Luma also reserves the right to embed watermarks at its own discretion.","marks":[]}]},{"_type":"block","_key":"b5885","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5884","text":"The catch: the most professional output in the category, in five and ten second pieces, with no sound.","marks":[]}]},{"_type":"block","_key":"b5887","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5886","text":"Best for: teams with a finishing pipeline who care about grade and comp, who work in short pieces, and who handle audio separately anyway.","marks":[]}]},{"_type":"block","_key":"b5889","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5888","text":"5. Kling","marks":[]}],"anchorId":"5-kling"},{"_type":"block","_key":"b5891","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5890","text":"Kling is the best per-shot directing tool available, and Video 3.0 Omni is why. Custom Multi-Shot lets you specify duration, shot size, perspective and camera movement for each shot in a sequence, which is a shot list rather than a prompt. Element binding locks up to three elements, built from a character video or two to four reference images, so a subject holds its shape through a zoom, pan or tilt.","marks":[]}]},{"_type":"block","_key":"b5893","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5892","text":"Its native audio is unusually capable too: five languages, mixed-language performance in one video, Chinese dialects and English accents, and precise referencing of which character is speaking in a multi-character scene.","marks":[]}]},{"_type":"block","_key":"b5895","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5894","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5897","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5896","text":"Custom Multi-Shot gives per-shot control over size, perspective, movement and duration.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5899","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5898","text":"Automatic multi-shot planning for when you want the model to propose coverage.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5901","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5900","text":"Element binding holds up to three bound subjects stable through camera movement.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5903","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5902","text":"Multi-character dialogue with correct speaker attribution in the same pass.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5905","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5904","text":"Kling O1, from December 2025, does natural-language post work with no manual masking or keyframing.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5907","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5906","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b5909","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5908","text":"Kling's resolution story needs reading carefully. The standard Video 3.0 and 3.0 Omni modes run at 1080p and 720p, and a separate one-click native 4K mode was added to the 3.0 series in April with separate credit pricing. So 4K is real here, it just isn't what the default credit tiers give you. Shots run 3 to 15 seconds.","marks":[]}]},{"_type":"block","_key":"b5911","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5910","text":"The larger issue is what the terms ask of you. Kling's global service is operated by Kling AI Pte. Ltd. under Singapore law, and its terms require you to label the output interface with the Kling brand, or to prominently indicate that the output was generated by Kling AI where no brand mark carries through. They also bar use for political campaigning, advocacy or lobbying without written consent. For festival and client delivery that labelling expectation is awkward at best. There's also no editorial surface at all.","marks":[]}]},{"_type":"block","_key":"b5913","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5912","text":"The catch: the best shot control, wrapped in the most delivery friction.","marks":[]}]},{"_type":"block","_key":"b5915","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5914","text":"Best for: directors who want genuine blocking control on shots that will be finished and cleared elsewhere.","marks":[]}]},{"_type":"block","_key":"b5917","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5916","text":"6. Moonvalley Marey","marks":[]}],"anchorId":"6-moonvalley-marey"},{"_type":"block","_key":"b5919","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5918","text":"Marey puts training-data provenance at the center of its pitch to production teams. Moonvalley's own claim is that it's the first commercially safe video model, trained only on licensed high-resolution footage, with no scraped content and no user submissions.","marks":[]}]},{"_type":"block","_key":"b5921","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5920","text":"The control set is also the most director-shaped in the category: camera control from a single image, motion transfer from a reference video, trajectory control by drawing paths, keyframing between reference images on a timeline, pose control to guide performance timing, shot extension, and reference layers giving separate control per character or object.","marks":[]}]},{"_type":"block","_key":"b5923","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5922","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5925","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5924","text":"Moonvalley emphasizes licensed training data, giving production teams a provenance claim to evaluate alongside delivery requirements.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5927","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5926","text":"Trajectory control by drawing the path a subject or camera takes.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5929","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5928","text":"Motion transfer from reference video, and pose control for performance timing.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5931","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5930","text":"Reference layers, so a character and a prop are directed independently.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5933","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5932","text":"3D-aware scene manipulation, with shots editable after generation including reframing and background change.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5935","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5934","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b5937","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5936","text":"Clips are short, and Moonvalley publishes no duration figure anywhere on its own site, which is itself a signal. Its listing with fal, the inference partner it names, offers 5 or 10 seconds with 5 as the default. Output is native 1080p, Marey does not appear on the quality leaderboards at all, and its look is deliberately painterly instead of photoreal, which suits some projects and rules out others.","marks":[]}]},{"_type":"block","_key":"b5939","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5938","text":"The bigger concern is momentum. Moonvalley names no model beyond Marey, and its own blog has published nothing since August 2025. Check that the company is still shipping before you build a production around it.","marks":[]}]},{"_type":"block","_key":"b5941","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5940","text":"The catch: licensed training data is a central selling point, but confirm that the product and support meet your production needs.","marks":[]}]},{"_type":"block","_key":"b5943","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5942","text":"Best for: commercial and studio work where provenance is a gating requirement rather than a preference.","marks":[]}]},{"_type":"block","_key":"b5945","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5944","text":"7. LTX Studio","marks":[]}],"anchorId":"7-ltx-studio"},{"_type":"block","_key":"b5947","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5946","text":"LTX Studio is the one entry with a genuine pre-production surface. You go from script and scene description to a shot sequence with consistent characters, and there's an edit suite attached, not a prompt box and a download folder.","marks":[]}]},{"_type":"block","_key":"b5949","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5948","text":"Underneath it, LTX-2.5 is an open-weights audio-video world model released on 11 August. It generates 4K HDR, and it holds character, environment and voice consistent across cuts in a single multishot pass, which is the specific problem most tools solve badly.","marks":[]}]},{"_type":"block","_key":"b5951","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5950","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5953","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5952","text":"Script to shot sequence, so the tool matches how a film is actually planned.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5955","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5954","text":"Native multishot generation holding character, environment and voice across cuts in one pass.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5957","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5956","text":"4K HDR output, which almost nothing else here reaches natively.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5959","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5958","text":"Open weights on Hugging Face with day-one ComfyUI support, so a studio that can't send footage to a cloud can run it locally.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5961","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5960","text":"API pricing varies by resolution and generation tier, so check the current rate for the output your project needs.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5963","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5962","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b5965","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5964","text":"Commercial use depends on the plan; an entry-level personal-use tier is not interchangeable with a commercial subscription. The compute-second allowances differ between Lightricks' own surfaces, so confirm what you're buying before committing. The open-weights license also has a revenue threshold; larger organizations need to review the applicable commercial terms.","marks":[]}]},{"_type":"block","_key":"b5967","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5966","text":"It's also a less familiar tool than the others, with a smaller body of craft knowledge around it, so expect to work things out instead of looking them up.","marks":[]}]},{"_type":"block","_key":"b5969","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5968","text":"The catch: the best planning surface, and the least company behind it in the US market.","marks":[]}]},{"_type":"block","_key":"b5971","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5970","text":"Best for: teams who want structure before generation, and studios that need weights on their own hardware.","marks":[]}]},{"_type":"block","_key":"b5973","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5972","text":"8. Adobe","marks":[]}],"anchorId":"8-adobe"},{"_type":"block","_key":"b5975","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5974","text":"Adobe is the entry that changed the workflow rather than the model. In September it shipped a generative media tool directly into the Premiere timeline: draw a range on a track, describe what you need, and generate without leaving the application. The model picker includes Adobe's own Firefly alongside partner models from Google Veo, Kling, Runway and Luma.","marks":[]}]},{"_type":"block","_key":"b5977","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5976","text":"That reframes the whole question. For an editor, this is no longer which AI video generator to buy; it's which model to call from the sequence, with the credit cost shown in the taskbar before you commit.","marks":[]}]},{"_type":"block","_key":"b5979","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5978","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5981","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5980","text":"Generation inside the timeline, with sequence settings matched automatically and cost shown before you spend.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5983","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5982","text":"Firefly plus four partner vendors reachable from one interface, so you're not choosing a favorite and living with its weak side.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5985","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5984","text":"Generate Sound Effects lets you use your own voice to guide the rhythm, timing and intensity of the result.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5987","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5986","text":"Firefly's own video model is trained on licensed Adobe Stock and public domain content and never on customer work.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5989","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5988","text":"Firefly Custom Models let a studio train on its own assets so generations conform to a house look.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5991","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5990","text":"Object Masking downloads its models once and then runs against your local GPU, so the tracking work stays on your machine.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5993","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5992","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b5995","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5994","text":"Firefly's own video model is well behind the frontier on quality, so the value here is position in the pipeline, not what comes out of the model. Generative Extend is capped at 2 seconds of video. The commercial-safety guarantee covers Firefly only, and the moment you pick Veo, Kling, Runway or Luma from that same timeline you inherit their terms instead, which is easy to forget when the picker makes them look equivalent.","marks":[]}]},{"_type":"block","_key":"b5997","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5996","text":"Early hands-on reporting has been mixed on the new audio features: ProVideo Coalition's Scott Simmons found some generated tracks usable and others out of sync and off the mark, and noted that audio designers are watching this with skepticism.","marks":[]}]},{"_type":"block","_key":"b5999","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5998","text":"The catch: the right place to work, not the best thing to generate with.","marks":[]}]},{"_type":"block","_key":"b6001","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6000","text":"Best for: editors already in Premiere, who want the round trip gone and will pick a partner model per shot.","marks":[]}]},{"_type":"block","_key":"b6003","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6002","text":"What still needs a camera","marks":[]}],"anchorId":"what-still-needs-a-camera"},{"_type":"block","_key":"b6005","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6004","text":"None of this replaces a shoot, and the gap isn't where most coverage puts it. It isn't resolution or realism; those are close enough now for a lot of work. It's duration, continuity and performance. Every tool here generates in units of seconds, holds a character imperfectly across cuts, and gives you a performance you selected, not one you directed on the day.","marks":[]}]},{"_type":"block","_key":"b6007","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6006","text":"So the useful reading of this category in 2026 is that it's strongest before and around a shoot and not instead of one: previz and look development, coverage you couldn't afford, plates and elements, extensions, and the shots that exist to be cut against something real. The directors getting the most out of it are treating it as another unit, not as a replacement for the crew.","marks":[]}]},{"_type":"block","_key":"b6009","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b6008","text":"Which also means the tool you pick matters less than where it sits in your process. A model you can reach from the canvas you're already working in, or from the sequence you're already cutting, will get used. One that needs its own tab and its own export ritual will not.","marks":[]}]},{"_type":"block","_key":"b6014","style":"normal","markDefs":[{"_type":"link","_key":"b6011","href":"/blog/trim-arrange-export-video","isNewTab":false}],"children":[{"_type":"span","_key":"b6010","text":"For the next step, see ","marks":[]},{"_type":"span","_key":"b6012","text":"trimming, arranging and exporting video","marks":["b6011"]},{"_type":"span","_key":"b6013","text":".","marks":[]}]},{"_type":"block","_key":"b6016","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b6015","text":"Frequently asked questions","marks":[]}],"anchorId":"frequently-asked-questions"},{"_type":"faqList","_key":"b6017","items":"$2d:props:children:1:props:children:1:props:children:0:props:post:faq"},{"_type":"block","_key":"b6022","style":"normal","markDefs":[{"_type":"link","_key":"b6019","href":"https://app.melius.com","isNewTab":true}],"children":[{"_type":"span","_key":"b6018","text":"Block out a sequence from one still, run the same shot through Veo, Kling, Wan and Seedance side by side on one canvas, then take the takes that work into your edit. ","marks":[]},{"_type":"span","_key":"b6020","text":"Open Melius","marks":["b6019"]},{"_type":"span","_key":"b6021","text":".","marks":[]}]},{"_type":"block","_key":"b6030","style":"normal","markDefs":[{"_type":"link","_key":"b6024","href":"/blog/where-to-run-seedance-2-5","isNewTab":false},{"_type":"link","_key":"b6027","href":"/blog/one-subscription-every-model","isNewTab":false}],"children":[{"_type":"span","_key":"b6023","text":"Related reading: ","marks":[]},{"_type":"span","_key":"b6025","text":"where to run Seedance 2.5","marks":["b6024"]},{"_type":"span","_key":"b6026","text":" and ","marks":[]},{"_type":"span","_key":"b6028","text":"one subscription for every AI model","marks":["b6027"]},{"_type":"span","_key":"b6029","text":".","marks":[]}]}]}}],"$L3e","$L3f"]}]]}]]}]
30:null
38:"$d:props:children:1:props:serverProvidedParams:params"
7:300
3a:["$","details","4",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["How do I keep a product consistent across many shots?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"Build the canvas once on a single SKU until the output is right, then duplicate it and swap the inputs. Reusing the graph is what keeps the lighting and the framing from drifting between shots, and it's how high-volume teams produce variants at catalogue scale."}]]}]
3b:["$","details","5",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["What resolution should I generate product shots at?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"2K or higher. Generating at 2K isn't the same as upscaling a 1K image afterwards: the model has more room to resolve fabric weave, embossed marks and label typography while it works, and upscaling later operates on an image whose fine detail is already gone. Note that the canvas preview is downscaled at any resolution, so judge sharpness from the full-screen view or the download."}]]}]
3c:["$","details","6",{"className":"faq-item","children":[["$","summary",null,{"className":"t-b-1 text-gray-dark-1 flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium select-none [&::-webkit-details-marker]:hidden","children":["How much does generating product photos cost?",["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","aria-hidden":"true","className":"text-foreground-muted size-5 shrink-0 transition-transform duration-200 [[open]_&]:rotate-180","children":["$","path",null,{"d":"M6 9l6 6 6-6","stroke":"currentColor","strokeWidth":"2","strokeLinecap":"round","strokeLinejoin":"round"}]}]]}],["$","p",null,{"className":"t-b-1 text-foreground-muted m-0 pr-8 pb-5","children":"Generation runs on credits from one shared pool, whichever model a step uses, so trying the same shot on two models costs nothing extra in setup. Current plans and credit allowances are on the pricing page."}]]}]
3e:["$","$L3d","post-where-to-run-seedance-2-5",{"post":{"_key":"post-where-to-run-seedance-2-5","slug":"where-to-run-seedance-2-5","category":"comparisons","title":"Where to run Seedance 2.5: platforms compared","isoDate":"2026-09-12","date":"September 12, 2026","readTime":"17 Min Read","excerpt":"Six platforms compared on the resolution they actually expose, what a 5-second take costs, reference limits, and whether there is anywhere to work.","image":{"url":"/images/blog/where-to-run-seedance-2-5/cover.webp"},"authors":[{"name":"Melius Team"}],"faq":[{"question":"Where can you use Seedance 2.5?","answer":"ByteDance's own surfaces carry it, meaning Volcano Engine Ark in China, BytePlus ModelArk internationally, plus Dreamina, Jimeng and CapCut, and so do a long list of resellers including fal, Segmind, OpenRouter, Replicate, Together, Krea, Flora, Leonardo and Melius. BytePlus is the cheapest first-party route outside China, Segmind is the cheapest route to 1080p, and Melius supports up to 1080p and puts it beside every other leading video model in one workflow."},{"question":"Does Seedance 2.5 support 4K?","answer":"No. ByteDance's own capability documentation caps Seedance 2.5 at 1080p, in 10-bit H.265, and lists 4K only for Seedance 2.0. Several platforms advertise native 4K on 2.5, and that claim is wrong; where a 4K file is actually delivered, an upscaler has run after generation. Magnific documents this correctly, rendering at 480p or 720p and upscaling afterwards."},{"question":"How long can a Seedance 2.5 video be?","answer":"Up to 30 seconds in a single generation, at any whole-second length from 4 upward, which is double Seedance 2.0's 15-second ceiling. The Seed model page notes the take can then be extended twice. A 180-second long-video mode appears on Dreamina's page and gets repeated elsewhere, but it isn't in ByteDance's own model specification, so treat it as a Dreamina-specific beta and not a property of the model."},{"question":"How much does Seedance 2.5 cost?","answer":"A 5-second 720p clip with audio costs roughly $1.16 through ByteDance's international surface or OpenRouter, about $1.19 on Segmind, and about $2.31 on fal, so the spread across the field is close to 2x. The token-priced platforms bill the same formula, which multiplies input and output duration by width, height and frame rate, and only successful generations are charged. 1080p runs about two and a half times the 720p rate, and audio is free everywhere."},{"question":"Is Seedance 2.5 better than Seedance 2.0?","answer":"For most jobs yes, but not for all of them, and the reason is resolution. Seedance 2.5 doubles the single-generation length to 30 seconds, raises the reference budget from 15 files to 50, and is the first in the family to accept an audio-only reference. The base Seedance 2.0 remains the only version that generates 4K. So if you need maximum resolution in a short clip, 2.0 is still the right model."},{"question":"Can you use your own footage as a reference in Seedance 2.5?","answer":"The model accepts up to 10 reference videos as part of its 50-file budget, but there's a restriction to check on your platform first: ByteDance's own documentation states that reference images and videos containing real human faces cannot be uploaded directly, offering reuse of the model's own outputs, a preset virtual-portrait library or licensed footage as the alternatives. Support for bringing in your own video also varies by platform, so verify that specific path before building a workflow on it."}],"tableOfContents":[{"_key":"where-should-you-run-seedance-2-5","title":"Where to run it"},{"_key":"what-to-know-before-you-pick","title":"Before you pick"},{"_key":"what-is-new-in-seedance-2-5","title":"What is new"},{"_key":"what-separates-a-good-place-to-run-it","title":"How to choose"},{"_key":"the-six-compared","title":"Comparison table"},{"_key":"1-melius","title":"1. Melius"},{"_key":"2-bytedance-direct","title":"2. ByteDance direct"},{"_key":"3-fal-ai","title":"3. fal.ai"},{"_key":"4-segmind","title":"4. Segmind"},{"_key":"5-openrouter","title":"5. OpenRouter"},{"_key":"6-krea","title":"6. Krea"},{"_key":"where-seedance-2-5-is-not-available","title":"Availability"},{"_key":"frequently-asked-questions","title":"FAQ"}],"content":[{"_type":"block","_key":"b5208","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5207","text":"Where should you run Seedance 2.5?","marks":[]}],"anchorId":"where-should-you-run-seedance-2-5"},{"_type":"block","_key":"b5210","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5209","text":"Start with the resolution you need, because that's the axis platforms actually differ on and several of them quietly cap it. Seedance 2.5 supports 480p, 720p and 1080p, and some of the places selling it expose only the first two. If 720p is fine, you have a lot of good options and the cheapest ones are very cheap. If you need 1080p, the list shortens immediately.","marks":[]}]},{"_type":"block","_key":"b5212","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5211","text":"The second thing to settle is whether you want an endpoint or a workspace. The per-second price spread from the cheapest API to the most expensive is only about 2x, which is small enough that it rarely decides anything. What differs by much more is whether the platform gives you somewhere for the takes to live, other models to compare against, and a way to run the same shot again next week.","marks":[]}]},{"_type":"block","_key":"b5214","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5213","text":"What to know before you pick","marks":[]}],"anchorId":"what-to-know-before-you-pick"},{"_type":"block","_key":"b5216","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5215","text":"Seedance 2.5 does not do 4K. ByteDance's own capability table caps it at 1080p and lists 4K only for the base Seedance 2.0, yet several platforms advertise native 4K on 2.5. Where you see 4K delivered, it's an upscaler running after the fact.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5218","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5217","text":"Audio is free on the token-priced platforms. It's generated in the same pass and the billing formula has no audio term, so switching it off saves you nothing. That's specific to the 2.x line: Seedance 1.5 Pro does price audio separately.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5220","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5219","text":"It's slow. Measured end-to-end latency runs to several minutes for a single generation, so budget in minutes, not seconds, and don't design an interactive loop around it.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5222","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5221","text":"Feeding in a reference video is metered on input duration plus output duration, so a 30-second reference with a 5-second result can cost several times a text-only take of the same length.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5224","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5223","text":"What is new in Seedance 2.5","marks":[]}],"anchorId":"what-is-new-in-seedance-2-5"},{"_type":"block","_key":"b5226","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5225","text":"ByteDance's Seed team launched Seedance 2.5 on 31 July 2026, and it reached the public developer API on BytePlus ModelArk in early August. Against Seedance 2.0 it doubles the maximum single generation from 15 seconds to 30, and takes the reference budget from 15 files to 50: up to 30 images, 10 videos and 10 audio clips. It's also the first in the family to accept an audio-only reference, where the whole 2.0 line required audio to be paired with an image or a video.","marks":[]}]},{"_type":"block","_key":"b5228","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5227","text":"The trade is real and it's rarely mentioned. The base Seedance 2.0 generates 4K with 10-bit output and Seedance 2.5 does not, topping out at 1080p in 10-bit H.265. So 2.5 is the longer, more referenceable model and 2.0 is still the higher-resolution one, which means the upgrade isn't automatic for every job.","marks":[]}]},{"_type":"block","_key":"b5230","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5229","text":"Worth knowing before you plan around benchmarks: Seedance 2.5 has no leaderboard standing yet. Any Elo figure you see attached to Seedance is the 2.0 entry, which as of early September sits fifth on text-to-video with audio and second on image-to-video with audio. ByteDance has published no benchmark numbers for 2.5, only qualitative claims, so the widely repeated prompt-adherence improvement figure traces to platform marketing rather than to a ByteDance source.","marks":[]}]},{"_type":"block","_key":"b5232","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5231","text":"What separates a good place to run it?","marks":[]}],"anchorId":"what-separates-a-good-place-to-run-it"},{"_type":"block","_key":"b5234","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5233","text":"Four things, and the first one is where most of the confusion in this category lives.","marks":[]}]},{"_type":"block","_key":"b5236","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5235","text":"The resolution it actually exposes","marks":[]}]},{"_type":"block","_key":"b5238","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5237","text":"A platform can carry Seedance 2.5 and still not give you all of it. 1080p is available on Melius, on ByteDance's own surfaces, on fal, Segmind and Krea, and on several of the smaller API resellers. It isn't available on OpenRouter, on Higgsfield, or on Magnific, all of which cap at 720p.","marks":[]}]},{"_type":"block","_key":"b5240","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5239","text":"Then there's the 4K question, which is worth being blunt about because so much of the coverage is wrong. Pollo, Kie.ai, CapCut and Dreamina pages all describe native 4K on this model. The model doesn't have it. Magnific is the one platform that states the mechanism honestly: it renders at 480p and 720p, and its separate video upscaler takes the finished take to 4K afterwards. That's a legitimate way to get a 4K deliverable, and it isn't the same claim.","marks":[]}]},{"_type":"block","_key":"b5242","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5241","text":"What a take actually costs","marks":[]}]},{"_type":"block","_key":"b5244","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5243","text":"The token-priced platforms all bill the same underlying formula, which multiplies input and output duration by width, height and frame rate, and only successful generations are charged, so a run killed by content moderation costs nothing. That makes the comparison unusually clean: for a 5-second 720p clip with audio, ByteDance's international surface and OpenRouter both land near $1.16, Segmind is a fraction under $1.19, and fal is roughly $2.31, which is exactly double ByteDance's token rate.","marks":[]}]},{"_type":"block","_key":"b5246","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5245","text":"So the spread is about 2x across the whole field, and it's small in absolute terms. Ten takes at 720p costs somewhere between $12 and $23 depending where you run them, which isn't usually the number that decides a production. Where cost does bite is 1080p, roughly two and a half times the 720p rate, and reference video, which adds the input clip's duration to the bill.","marks":[]}]},{"_type":"block","_key":"b5248","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5247","text":"Whether it takes the references you have","marks":[]}]},{"_type":"block","_key":"b5250","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5249","text":"The 50-file reference budget is the headline feature and it comes with a restriction almost nobody mentions: reference images and videos containing real human faces cannot be uploaded directly on ByteDance's own platform. The documented workarounds are reusing outputs the model itself produced, drawing from a preset virtual-portrait library, or supplying licensed footage.","marks":[]}]},{"_type":"block","_key":"b5252","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5251","text":"That constraint propagates unevenly. Some resellers surface it as a liability notice, a couple sell relaxed-moderation tiers that require faces to be verified in an asset library first, and at least one API reseller's documentation still carries the old 2.0 audio limits of three files and 15 seconds paired with an image. If holding a specific real person across a 30-second take is the job, verify that path on your chosen platform before you plan around it.","marks":[]}]},{"_type":"block","_key":"b5254","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5253","text":"Whether there is anywhere to work","marks":[]}]},{"_type":"block","_key":"b5256","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5255","text":"Most of this list is an endpoint. You send a request, you get a URL back, and what happens next is your problem, which on ByteDance's own platform is more pressing than it sounds: task records are kept for seven days and the output video URL expires after 24 hours with a download cap. Fetch and re-host immediately or you'll lose the take.","marks":[]}]},{"_type":"block","_key":"b5258","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5257","text":"The alternative is a platform that holds the work: the take, the version before it, the reference set that produced it, and the other models you compared against. That's the difference between running a model and having a process, and it's the reason the price spread matters less than it looks.","marks":[]}]},{"_type":"block","_key":"b5260","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5259","text":"The six compared","marks":[]}],"anchorId":"the-six-compared"},{"_type":"block","_key":"b5265","style":"normal","markDefs":[{"_type":"link","_key":"b5262","href":"/pricing","isNewTab":false}],"children":[{"_type":"span","_key":"b5261","text":"Capabilities and prices as of September 2026, from each platform's own documentation and ","marks":[]},{"_type":"span","_key":"b5263","text":"pricing page","marks":["b5262"]},{"_type":"span","_key":"b5264","text":"s. Two ByteDance promotions on 1080p rates are live and end mid-September, so the figures here are list rates where a promotion applies.","marks":[]}]},{"_type":"portableTable","_key":"b5266","rows":[{"_key":"b5267","cells":[{"_key":"b5268","text":[{"_type":"block","_key":"b5270","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5269","text":"Platform","marks":["strong"]}]}]},{"_key":"b5271","text":[{"_type":"block","_key":"b5273","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5272","text":"Max resolution","marks":["strong"]}]}]},{"_key":"b5274","text":[{"_type":"block","_key":"b5276","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5275","text":"5 seconds at 720p","marks":["strong"]}]}]},{"_key":"b5277","text":[{"_type":"block","_key":"b5279","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5278","text":"Interface","marks":["strong"]}]}]},{"_key":"b5280","text":[{"_type":"block","_key":"b5282","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5281","text":"Best at","marks":["strong"]}]}]}]},{"_key":"b5283","cells":[{"_key":"b5284","text":[{"_type":"block","_key":"b5286","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5285","text":"Melius","marks":[]}]}]},{"_key":"b5287","text":[{"_type":"block","_key":"b5289","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5288","text":"1080p","marks":[]}]}]},{"_key":"b5290","text":[{"_type":"block","_key":"b5292","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5291","text":"Credits, on one shared pool","marks":[]}]}]},{"_key":"b5293","text":[{"_type":"block","_key":"b5295","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5294","text":"Canvas, agent, Slack, API, CLI","marks":[]}]}]},{"_key":"b5296","text":[{"_type":"block","_key":"b5298","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5297","text":"Comparing it against every other video model","marks":[]}]}]}]},{"_key":"b5299","cells":[{"_key":"b5300","text":[{"_type":"block","_key":"b5302","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5301","text":"ByteDance direct","marks":[]}]}]},{"_key":"b5303","text":[{"_type":"block","_key":"b5305","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5304","text":"1080p","marks":[]}]}]},{"_key":"b5306","text":[{"_type":"block","_key":"b5308","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5307","text":"About $1.16 on BytePlus","marks":[]}]}]},{"_key":"b5309","text":[{"_type":"block","_key":"b5311","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5310","text":"Console plus API","marks":[]}]}]},{"_key":"b5312","text":[{"_type":"block","_key":"b5314","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5313","text":"First-party access at the lowest rate","marks":[]}]}]}]},{"_key":"b5315","cells":[{"_key":"b5316","text":[{"_type":"block","_key":"b5318","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5317","text":"fal.ai","marks":[]}]}]},{"_key":"b5319","text":[{"_type":"block","_key":"b5321","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5320","text":"1080p","marks":[]}]}]},{"_key":"b5322","text":[{"_type":"block","_key":"b5324","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5323","text":"About $2.31","marks":[]}]}]},{"_key":"b5325","text":[{"_type":"block","_key":"b5327","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5326","text":"API plus playground","marks":[]}]}]},{"_key":"b5328","text":[{"_type":"block","_key":"b5330","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5329","text":"Developer experience, at twice the token rate","marks":[]}]}]}]},{"_key":"b5331","cells":[{"_key":"b5332","text":[{"_type":"block","_key":"b5334","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5333","text":"Segmind","marks":[]}]}]},{"_key":"b5335","text":[{"_type":"block","_key":"b5337","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5336","text":"1080p","marks":[]}]}]},{"_key":"b5338","text":[{"_type":"block","_key":"b5340","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5339","text":"About $1.19, audio free","marks":[]}]}]},{"_key":"b5341","text":[{"_type":"block","_key":"b5343","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5342","text":"API plus playground","marks":[]}]}]},{"_key":"b5344","text":[{"_type":"block","_key":"b5346","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5345","text":"The cheapest 1080p per second","marks":[]}]}]}]},{"_key":"b5347","cells":[{"_key":"b5348","text":[{"_type":"block","_key":"b5350","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5349","text":"OpenRouter","marks":[]}]}]},{"_key":"b5351","text":[{"_type":"block","_key":"b5353","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5352","text":"720p","marks":[]}]}]},{"_key":"b5354","text":[{"_type":"block","_key":"b5356","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5355","text":"About $1.16, at cost","marks":[]}]}]},{"_key":"b5357","text":[{"_type":"block","_key":"b5359","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5358","text":"API plus playground","marks":[]}]}]},{"_key":"b5360","text":[{"_type":"block","_key":"b5362","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5361","text":"Pass-through pricing and published latency","marks":[]}]}]}]},{"_key":"b5363","cells":[{"_key":"b5364","text":[{"_type":"block","_key":"b5366","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5365","text":"Krea","marks":[]}]}]},{"_key":"b5367","text":[{"_type":"block","_key":"b5369","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5368","text":"1080p","marks":[]}]}]},{"_key":"b5370","text":[{"_type":"block","_key":"b5372","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5371","text":"Credits, free daily tier","marks":[]}]}]},{"_key":"b5373","text":[{"_type":"block","_key":"b5375","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5374","text":"UI first, API optional","marks":[]}]}]},{"_key":"b5376","text":[{"_type":"block","_key":"b5378","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5377","text":"Trying it without a commitment","marks":[]}]}]}]}]},{"_type":"block","_key":"b5380","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5379","text":"1. Melius","marks":[]}],"anchorId":"1-melius"},{"_type":"block","_key":"b5385","style":"normal","markDefs":[{"_type":"link","_key":"b5382","href":"/blog/one-subscription-every-model","isNewTab":false}],"children":[{"_type":"span","_key":"b5381","text":"Melius is the Agentic OS for creative work: you describe what you want and the Melius agent Mel builds the workflow, routes each step to a model and leaves every step editable. Seedance 2.5 is one node on a canvas that also holds Veo 3.1, Kling 3 and Wan 3.0, part of a library of leading models sharing ","marks":[]},{"_type":"span","_key":"b5383","text":"one subscription and one credit pool","marks":["b5382"]},{"_type":"span","_key":"b5384","text":".","marks":[]}]},{"_type":"block","_key":"b5390","style":"normal","markDefs":[{"_type":"link","_key":"b5387","href":"/blog/seedance-2-5","isNewTab":false}],"children":[{"_type":"span","_key":"b5386","text":"Melius has ","marks":[]},{"_type":"span","_key":"b5388","text":"published its own usage data","marks":["b5387"]},{"_type":"span","_key":"b5389","text":" on this, which is the most interesting number available about Seedance adoption anywhere: over a 30-day window the Seedance family accounted for 54.6% of every video generation on the platform, up from 26.7% when it was previously measured. Nobody's routed to Seedance by default. People run it beside Kling, Veo and Wan on the same canvas and keep choosing it, which is a stronger signal than any benchmark on a model with no leaderboard standing.","marks":[]}]},{"_type":"block","_key":"b5392","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5391","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5394","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5393","text":"Seedance 2.5 runs at 480p, 720p and 1080p on the same credit pool as every other model, so comparing it against Veo, Kling or Wan on one shot costs nothing extra in setup or subscriptions.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5396","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5395","text":"The canvas holds the takes, the references and the versions, with per-node history and an active-version selector, so a good take does not depend on you saving a URL.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5398","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5397","text":"Reference and character nodes carry a look across every clip in a set, and changing an upstream node re-runs everything below it.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5400","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5399","text":"Branching is the natural way to test two reference sets against the same prompt without rebuilding the graph.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5402","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5401","text":"Every canvas is real-time and collaborative by default, so a director and an editor watch the same takes arrive.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5404","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5403","text":"It's drivable from Slack, the Model Context Protocol (MCP), a CLI and an API, which matters on a model this slow because you can start a batch and go elsewhere.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5406","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5405","text":"The canvas accepts image, video and audio uploads, so you can bring your own reference assets into the workflow.","marks":[]}]},{"_type":"block","_key":"b5408","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5407","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b5410","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5409","text":"The choice is about workflow, not resolution. Melius supports 1080p directly, with the takes, references and versions held together on the canvas. If you already have storage, review and orchestration in your own stack, a standalone API may fit that setup better.","marks":[]}]},{"_type":"block","_key":"b5412","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5411","text":"The catch: you are choosing a shared creative workspace as well as model access. Its value is in comparing models and keeping the work together across a project.","marks":[]}]},{"_type":"block","_key":"b5417","style":"normal","markDefs":[{"_type":"link","_key":"b5414","href":"/pricing","isNewTab":false}],"children":[{"_type":"span","_key":"b5413","text":"Best for: teams weighing Seedance 2.5 against the rest of the field, or using it as one step inside a longer piece of work. Plans start at $18 a month as of September 2026, with current numbers on the ","marks":[]},{"_type":"span","_key":"b5415","text":"pricing page","marks":["b5414"]},{"_type":"span","_key":"b5416","text":".","marks":[]}]},{"_type":"block","_key":"b5419","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5418","text":"2. ByteDance direct","marks":[]}],"anchorId":"2-bytedance-direct"},{"_type":"block","_key":"b5421","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5420","text":"Going to the source means one of two clouds, and they aren't interchangeable. Volcano Engine's Ark platform is the China-domestic surface: prices in yuan, Chinese-first documentation, a Beijing endpoint, and model activation gated behind a balance or savings plan of at least Â¥200. BytePlus ModelArk is the international surface, with dollar pricing, English documentation and the same resolution tiers.","marks":[]}]},{"_type":"block","_key":"b5423","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5422","text":"For a team outside China, BytePlus is the route, and it's the cheapest first-party access there is. The model IDs differ between the two clouds, sharing a suffix but not a prefix, so code written against one won't run on the other unchanged.","marks":[]}]},{"_type":"block","_key":"b5425","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5424","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5427","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5426","text":"The lowest published rate anywhere, at roughly $1.16 for a 5-second 720p take with audio on BytePlus.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5429","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5428","text":"Full 1080p in 10-bit H.265, plus mov output with PCM audio, which no reseller in this comparison mentions.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5431","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5430","text":"The complete mode set, including the omni-modal reference path that splits by prompt intent into reference, edit and extend.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5433","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5432","text":"The only published rate limits in the category: 600 requests a minute and 10 concurrent tasks for verified business accounts, 180 and 3 for individuals, counted per primary account and per model rather than per plan.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5435","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5434","text":"Eleven prompt languages, and an optional watermark that's off by default.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5437","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5436","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b5439","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5438","text":"Asset handling is the sharp edge. Task records last seven days and the output URL expires after 24 hours with a 100-download cap, so anything you want to keep has to be pulled down and stored by you, immediately. There's no library, no versioning and no collaboration.","marks":[]}]},{"_type":"block","_key":"b5441","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5440","text":"The two-cloud split is also a genuine trap for teams that read the wrong documentation, and the Ark side's yuan pricing and balance threshold make it impractical for most non-China buyers regardless of whether they could register.","marks":[]}]},{"_type":"block","_key":"b5443","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5442","text":"The catch: the cheapest and most complete access, with a 24-hour memory.","marks":[]}]},{"_type":"block","_key":"b5445","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5444","text":"Best for: engineering teams outside China who want first-party access at the lowest rate and already have somewhere to put the files.","marks":[]}]},{"_type":"block","_key":"b5447","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5446","text":"3. fal.ai","marks":[]}],"anchorId":"3-fal-ai"},{"_type":"block","_key":"b5449","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5448","text":"fal is the developer platform most teams reach for, and it carries Seedance 2.5 across three endpoints: text-to-video, image-to-video and reference-to-video. Its API schema exposes 1080p, though its own marketing copy still says up to 720p, so trust the schema. The documentation is the clearest of any reseller here, and the playground means a non-developer can at least check output before anyone writes code.","marks":[]}]},{"_type":"block","_key":"b5451","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5450","text":"The reason to know the numbers is that fal is the expensive option. Its token rate is exactly double ByteDance's, which works out to roughly $2.31 for a 5-second 720p take and around $13.87 for 30 seconds.","marks":[]}]},{"_type":"block","_key":"b5453","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5452","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5455","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5454","text":"Three separate endpoints, so the mode is explicit, not inferred from what you passed.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5457","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5456","text":"Full 1080p, with per-token pricing published for each resolution tier.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5459","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5458","text":"A playground alongside the API, which shortens evaluation considerably.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5461","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5460","text":"Documentation states plainly that enabling audio does not change the token count.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5463","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5462","text":"Wan, Kling and much else sit behind the same API, so swapping models is a parameter change.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5465","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5464","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b5467","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5466","text":"You are paying twice ByteDance's rate for the same model, and unlike the Veo situation where resellers match Google's list price, here the markup is real and it's 100%. On a project of any volume that's the whole conversation.","marks":[]}]},{"_type":"block","_key":"b5469","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5468","text":"It's also an API and nothing more: no canvas, no asset library, no versions, no collaboration. Nothing wrong with that, but it means fal solves the access problem and none of the production problem.","marks":[]}]},{"_type":"block","_key":"b5471","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5470","text":"The catch: the best developer experience at the worst unit price.","marks":[]}]},{"_type":"block","_key":"b5473","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5472","text":"Best for: teams already building on fal who value one integration over the cost difference.","marks":[]}]},{"_type":"block","_key":"b5475","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5474","text":"4. Segmind","marks":[]}],"anchorId":"4-segmind"},{"_type":"block","_key":"b5477","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5476","text":"Segmind is the cheapest way to reach 1080p, at roughly $0.5876 a second, and its 720p rate of about $0.2389 is within a rounding error of ByteDance's own. It publishes per-second prices by resolution instead of making you compute tokens, which is the most usable pricing presentation in this comparison.","marks":[]}]},{"_type":"block","_key":"b5479","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5478","text":"It carries text-to-video, image-to-video with first and last frame handles, and reference-to-video, and it states outright that audio is free.","marks":[]}]},{"_type":"block","_key":"b5481","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5480","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5483","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5482","text":"Per-second prices published by resolution: about $0.1065 at 480p, $0.2389 at 720p and $0.5876 at 1080p.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5485","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5484","text":"The cheapest 1080p access of any platform here.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5487","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5486","text":"First and last frame handles on image-to-video, exposed as explicit parameters.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5489","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5488","text":"A playground alongside the API.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5491","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5490","text":"Pricing is stated in dollars per second, so a 10-second take costs what you would expect without arithmetic.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5493","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5492","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b5495","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5494","text":"Segmind markets itself on running Seedance 2.5 without a moderation filter, which is its own claim rather than a documented platform feature, and it's a positioning choice worth understanding before you route client work through it. Rate limits aren't published, so throughput on a real batch is unknown until you hit it.","marks":[]}]},{"_type":"block","_key":"b5497","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5496","text":"Like fal it's an endpoint with a playground, so there's no library, no versions and nowhere for a team to work.","marks":[]}]},{"_type":"block","_key":"b5499","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5498","text":"The catch: the best price for 1080p, from the platform with the least published about its limits.","marks":[]}]},{"_type":"block","_key":"b5501","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5500","text":"Best for: cost-sensitive teams who need 1080p and are handling storage and review elsewhere.","marks":[]}]},{"_type":"block","_key":"b5503","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5502","text":"5. OpenRouter","marks":[]}],"anchorId":"5-openrouter"},{"_type":"block","_key":"b5505","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5504","text":"OpenRouter passes Seedance 2.5 through at ByteDance's own token rate with no markup, which makes it the cheapest route that isn't ByteDance itself. It's also the only platform in this comparison that publishes measured performance, and those numbers are the most useful thing on this page for anyone planning a batch.","marks":[]}]},{"_type":"block","_key":"b5507","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5506","text":"As of early September it reported a median end-to-end latency for this model of about 316 seconds, a 90th percentile around 781 and a 99th near 1,700, on roughly 90% three-day availability. Those are rolling windows that move, so treat them as an order of magnitude: this is a model you queue, not one you sit and wait for.","marks":[]}]},{"_type":"block","_key":"b5509","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5508","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5511","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5510","text":"Pass-through pricing at ByteDance's rate, so no markup on top of first-party cost.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5513","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5512","text":"Published latency percentiles and availability, which nobody else provides and which change how you design a job.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5515","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5514","text":"Text-to-video and first and last frame modes, with the full 50-file reference budget.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5517","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5516","text":"One API key across a very large number of models from different providers.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5519","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5518","text":"A playground for evaluation.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5521","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5520","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b5523","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5522","text":"It caps at 720p. Its own documentation confirms 480p and 720p only, so anything needing 1080p has to go elsewhere, and that rules it out for a lot of delivery work.","marks":[]}]},{"_type":"block","_key":"b5525","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5524","text":"The published availability figure is worth reading twice as well: roughly 90% over three days means a batch will see failures, so retry logic isn't optional. And as with the other API entries, there's no workspace of any kind.","marks":[]}]},{"_type":"block","_key":"b5527","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5526","text":"The catch: honest pricing and honest numbers, at two thirds of the resolution.","marks":[]}]},{"_type":"block","_key":"b5529","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5528","text":"Best for: teams who want first-party economics and real latency data, working at 720p.","marks":[]}]},{"_type":"block","_key":"b5531","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5530","text":"6. Krea","marks":[]}],"anchorId":"6-krea"},{"_type":"block","_key":"b5533","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5532","text":"Krea is the easiest way to try Seedance 2.5 properly without deciding anything first. It carries text-to-video, image-to-video and reference-to-video with native audio at up to 1080p, in an interface built for people rather than for integrations, and its free tier includes daily credits.","marks":[]}]},{"_type":"block","_key":"b5535","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5534","text":"It's also a genuine multi-model suite, not a Seedance page, so comparing this model against Veo variants, Vidu and the rest of the Seedance family happens in the same place.","marks":[]}]},{"_type":"block","_key":"b5537","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5536","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5539","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5538","text":"Full 1080p in a UI-first product, which is a rarer combination than it sounds.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5541","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5540","text":"Free daily credits, so evaluation costs nothing.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5543","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5542","text":"All three main modes including reference-to-video, with audio.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5545","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5544","text":"A commercial license starts on the entry paid tier.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5547","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5546","text":"Nodes on the Pro tier for chaining steps into something repeatable.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5549","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5548","text":"The trade-off","marks":[]}]},{"_type":"block","_key":"b5551","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5550","text":"Credits burn quickly on video, and the entry tiers include only limited video access, so the cheap plan isn't the plan that does the work. Krea's published pricing was also hard to read reliably, with figures differing between sources, so confirm the tier before committing.","marks":[]}]},{"_type":"block","_key":"b5553","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5552","text":"Collaboration is thin below the Business tier, and there's no real asset or version management for a team, so it's a strong individual tool rather than a place a production lives.","marks":[]}]},{"_type":"block","_key":"b5555","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5554","text":"The catch: the friendliest way in, on credits that go fast.","marks":[]}]},{"_type":"block","_key":"b5557","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5556","text":"Best for: individuals evaluating the model, or doing occasional 1080p work without an engineering conversation.","marks":[]}]},{"_type":"block","_key":"b5559","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5558","text":"Where Seedance 2.5 is not available","marks":[]}],"anchorId":"where-seedance-2-5-is-not-available"},{"_type":"block","_key":"b5561","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5560","text":"Some absences are worth stating, because a few widely-cited roundups get them wrong. Adobe Firefly carries no Seedance model at all: its video partner roster is Runway, Kling, Luma and Topaz, with no ByteDance model of any version. Novita lists no Seedance model either, despite carrying 65 other video models. Canva publishes no Seedance integration.","marks":[]}]},{"_type":"block","_key":"b5563","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5562","text":"Several platforms do have it but publish too little to plan against: Replicate and Together both carry it without a resolution breakdown or a usable rate card, and one API reseller's 2.5 documentation still shows the 2.0 reference limits of three audio files and 15 seconds requiring a companion image, which is either a genuine platform restriction or a documentation bug and is worth one test call before you commit.","marks":[]}]},{"_type":"block","_key":"b5565","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5564","text":"The general lesson from checking all of this is that the model moved faster than the pages describing it. Version numbers, resolution ceilings and reference limits are all being quoted from the previous release across a lot of the web, so read the platform's own current documentation instead of a comparison post, this one included.","marks":[]}]},{"_type":"block","_key":"b5567","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5566","text":"Frequently asked questions","marks":[]}],"anchorId":"frequently-asked-questions"},{"_type":"faqList","_key":"b5568","items":"$3e:props:post:faq"},{"_type":"block","_key":"b5573","style":"normal","markDefs":[{"_type":"link","_key":"b5570","href":"https://app.melius.com","isNewTab":true}],"children":[{"_type":"span","_key":"b5569","text":"Run the same shot through Seedance 2.5, Veo, Kling and Wan on one canvas and one credit pool, then keep the take that works with the references that produced it. ","marks":[]},{"_type":"span","_key":"b5571","text":"Open Melius","marks":["b5570"]},{"_type":"span","_key":"b5572","text":".","marks":[]}]}]}}]
3f:["$","$L3d","post-ai-brand-mockup-tools-ranked",{"post":{"_key":"post-ai-brand-mockup-tools-ranked","slug":"ai-brand-mockup-tools-ranked","category":"comparisons","title":"AI brand mockup tools, ranked","isoDate":"2026-09-10","date":"September 10, 2026","readTime":"11 Min Read","excerpt":"Seven brand mockup tools ranked on the thing most roundups skip: whether your actual logo survives the render, or gets redrawn into something close to it.","image":{"url":"/images/blog/ai-brand-mockup-tools-ranked/cover.webp"},"authors":[{"name":"Melius Team"}],"faq":[{"question":"What is the best AI tool for brand mockups?","answer":"The best AI brand mockup tool depends on whether the scene you need already exists. If it doesn't, a canvas that generates the scene and composites your real logo on top, such as Melius, gets you a mockup nobody has photographed without redrawing your logo, and keeps the graph so the next brief starts from it. If the scene does already exist, a template-library tool like Placeit is quick and preserves your file by construction. For packaging with real structure, Pacdora's 3D renderer and dielines do a job the template tools don't attempt."},{"question":"Will AI mockup tools distort my logo?","answer":"Generative mockup tools will distort a logo unless the workflow puts your logo back on top as a layer. A diffusion model redraws the whole frame, so your mark is re-synthesized from scratch, which shows up as tapered strokes, shifted corner radii and garbled small text. Template libraries and 3D renderers don't have this problem at all, because your file is warped or mapped onto the surface. On a generative canvas the fix is compositing the real asset as a layer, or masking the region so only the surroundings regenerate."},{"question":"Which AI model is best at text in images?","answer":"GPT Image 2 is the model most often cited for multilingual in-image text, and OpenAI's own launch material names Bengali, Chinese, Hindi, Japanese and Korean as the languages where it gained most. Ideogram 4.0 takes bounding boxes and hex colors as structured input for layout, and Recraft's SVG output gives you letterforms as vector paths you can reshape by hand. Reliability falls away as the text gets longer on all of them, and Ideogram's own guide says long passages belong in a graphic editor afterward, so packaging back panels remain out of reach."},{"question":"Can I edit an AI-generated mockup later?","answer":"You cannot edit an AI-generated mockup the way you edit a template mockup. A generated image is a flat file with no smart object underneath, so swapping in a revised logo means generating the whole scene again and accepting that it won't match. Template and 3D tools keep the artwork as a separate replaceable object, and a node canvas keeps the graph, so you can change one input and re-run everything after it."},{"question":"What happened to Smartmockups?","answer":"Canva acquired it in 2021 and closed smartmockups.com on September 27, 2024. The domain now redirects to Canva's own mockups page, and the collection lives inside Canva's tools. Roundups still listing Smartmockups as a standalone product are out of date, which is worth checking generally, since this category consolidates fast and roundups are rarely refreshed."},{"question":"Do AI mockups work for print and merchandise?","answer":"AI mockups work for print and merchandise only if you check resolution and edges first. Generated output that looks clean on screen often carries soft edges, gradient artifacts and slight letterform distortion that become obvious on embroidery, small sizes and physical merchandise. Recraft supports 300 DPI and CMYK, and Pacdora exports high resolution on its top tier. Where the mark itself has to be exact, a composited or vector-mapped logo is safer than a generated one."}],"tableOfContents":[{"_key":"what-is-the-best-ai-brand-mockup-tool","title":"What is the best AI brand mockup tool?"},{"_key":"what-to-know-before-you-pick","title":"What to know before you pick"},{"_key":"the-three-mechanisms-and-what-each-does-to-your-logo","title":"The three mechanisms, and what each does to your logo"},{"_key":"what-separates-a-good-brand-mockup-tool","title":"What separates a good brand mockup tool"},{"_key":"the-seven-compared","title":"The seven compared"},{"_key":"1-melius","title":"1. Melius"},{"_key":"2-placeit","title":"2. Placeit"},{"_key":"3-adobe-illustrator-mockup","title":"3. Adobe Illustrator Mockup"},{"_key":"4-pacdora","title":"4. Pacdora"},{"_key":"5-dynamic-mockups","title":"5. Dynamic Mockups"},{"_key":"6-canva","title":"6. Canva"},{"_key":"7-recraft","title":"7. Recraft"},{"_key":"when-a-template-beats-a-generated-mockup","title":"When a template beats a generated mockup"},{"_key":"frequently-asked-questions","title":"Frequently asked questions"}],"content":[{"_type":"block","_key":"b4734","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b4733","text":"What is the best AI brand mockup tool?","marks":[]}],"anchorId":"what-is-the-best-ai-brand-mockup-tool"},{"_type":"block","_key":"b4736","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4735","text":"The best AI brand mockup tool is the one whose mechanism keeps your logo intact: a template library or a 3D renderer preserves the file you upload, and a generative model only does so if the workflow composites the logo back on top. Brand mockup tools make pixels in one of three ways, and the difference isn't a matter of quality: a template library warps your uploaded file onto a photograph, a 3D renderer maps it onto real geometry, and a generative model redraws the entire frame including your mark. The first two preserve your artwork by construction. The third doesn't, unless you make it.","marks":[]}]},{"_type":"block","_key":"b4738","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4737","text":"That distinction is missing from almost every roundup in this category, which sorts on template counts and price instead. It's also the only thing that matters when the output is going on a pitch deck, a print run or a product page, because a logo with a tapered stroke and a redrawn counter is not your logo.","marks":[]}]},{"_type":"block","_key":"b4740","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b4739","text":"What to know before you pick","marks":[]}],"anchorId":"what-to-know-before-you-pick"},{"_type":"block","_key":"b4742","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4741","text":"Work out which of the three mechanisms a tool uses before you look at anything else. Several vendors ship a library path and a generative path under one brand and one price, and only one of them preserves your file.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4744","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4743","text":"Generative models garble text as it gets longer. Ideogram's own prompting guide says short, punchy phrases work best, that the longer the text the higher the chance of spelling errors and distortions, and that long passages should be added afterward in a graphic editor. Fine for a logo lockup, useless for a packaging back panel.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4746","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4745","text":"A generated mockup is a flat file. There's no smart object underneath, so you can't swap tomorrow's design into yesterday's render without generating the whole thing again.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4748","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4747","text":"Check the commercial license tier, not just the price. On several tools here the free plan grants no commercial rights, and on one of them free-plan output is owned by the vendor and published publicly.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4750","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4749","text":"Screen-fine isn't print-fine. Soft edges and slight letterform distortion survive a slide and fall apart on embroidery, small sizes and merchandise.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4752","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b4751","text":"The three mechanisms, and what each does to your logo","marks":[]}],"anchorId":"the-three-mechanisms-and-what-each-does-to-your-logo"},{"_type":"block","_key":"b4754","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4753","text":"A template library pairs a pre-shot photograph with a fixed warp. Your file is mapped onto the surface by the template rather than redrawn, so the result is deterministic and repeatable, and the logo that comes back is exactly the one you supplied. The limit is that you can only use scenes someone already shot.","marks":[]}]},{"_type":"block","_key":"b4756","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4755","text":"True 3D rendering puts your artwork on an actual mesh as a texture or decal, then computes the lighting and distortion. Same fidelity guarantee, more freedom of angle, and it's the only route that handles packaging dielines properly. Adobe's Illustrator Mockup sits just off this category, using a neural network to infer the 3D shape of a single photograph and then mapping a vector decal onto it. Adobe says the feature preserves the quality of a decal as users place it on the 3D surface, and separately that vector decals keep a 3D preview working regardless of its resolution.","marks":[]}]},{"_type":"block","_key":"b4758","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4757","text":"Generative placement asks a diffusion or autoregressive model to produce the whole image. Nothing is preserved, because nothing is placed; it's all drawn. A comparison published in April 2026 by Creatsy, a PSD mockup vendor, put seven generative models across six products and found that Midjourney's logo text on a kraft bag came back recognizable from a distance and unreadable up close, and that label text was a mess across the board on a cosmetic jar. The ranking carries an obvious interest, but the observations are specific and easy to reproduce.","marks":[]}]},{"_type":"block","_key":"b4760","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4759","text":"The useful conclusion isn't that generative tools are bad at mockups. It's that a generative tool only preserves a mark if the workflow puts the mark back on top rather than asking the model to draw it.","marks":[]}]},{"_type":"block","_key":"b4762","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b4761","text":"What separates a good brand mockup tool","marks":[]}],"anchorId":"what-separates-a-good-brand-mockup-tool"},{"_type":"block","_key":"b4764","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4763","text":"There are four criteria here, and the first two are the ones most roundups skip.","marks":[]}]},{"_type":"block","_key":"b4766","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b4765","text":"Whether your artwork survives","marks":[]}]},{"_type":"block","_key":"b4768","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4767","text":"Ask where your file ends up in the pipeline. If it's a layer composited over the render, or a decal mapped onto geometry, it survives. If it's a description the model reads before drawing, it doesn't. Adobe documents this most fully and Dynamic Mockups states it plainly for its template path; most of the others don't say either way, so the mechanism is usually a better guide than the marketing copy.","marks":[]}]},{"_type":"block","_key":"b4770","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b4769","text":"Whether type stays legible","marks":[]}]},{"_type":"block","_key":"b4772","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4771","text":"Typography is where generative mockups break most visibly, and the models differ sharply. GPT Image 2 is the model most often cited for multilingual in-image text, and OpenAI's launch material names Bengali, Chinese, Hindi, Japanese and Korean as the languages where it gained most. Ideogram 4.0 takes bounding boxes and hex colors as structured input, so you control the layout. Recraft outputs scalable vector graphics (SVG), which turns a wrong letterform into a path you reshape instead of a generation you redo. None of them handles a paragraph.","marks":[]}]},{"_type":"block","_key":"b4774","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b4773","text":"Whether it holds a brand system","marks":[]}]},{"_type":"block","_key":"b4776","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4775","text":"One mockup is a demo. A brand needs the same palette, type and logo treatment across a deck, a storefront, a packaging render and a social placement. Look for something that pins those values once and applies them to everything afterward, and check where the pinning lives: an account-level brand kit follows you between projects, while a setup that lives inside one working file has to be carried over by hand each time.","marks":[]}]},{"_type":"block","_key":"b4778","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b4777","text":"What the license actually grants","marks":[]}]},{"_type":"block","_key":"b4780","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4779","text":"Licensing here isn't consistent from tool to tool. Some free tiers grant no commercial rights at all; one vendor retains ownership of free-plan images and publishes them in a public gallery; one 3D tool restricts its lower tiers to personal use and grants commercial use and resale only at the top; another caps commercial reproduction at a fixed number of copies per design on its mid tiers. Read the tier, not the homepage.","marks":[]}]},{"_type":"block","_key":"b4782","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b4781","text":"The seven compared","marks":[]}],"anchorId":"the-seven-compared"},{"_type":"block","_key":"b4784","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4783","text":"Scenes you can create asks whether you can get a mockup in a setting nobody has photographed, and whether your logo survives the trip. Brand system asks how much of a brand you can pin into the work, and whether it stays pinned: palette and type at minimum, at best the voice, photography rules and do-and-don't guidance an agent reads on every generation, and a point for whether that setup follows you to the next piece of work or has to be rebuilt. Team access is how many people can be in the work before it starts costing per head.","marks":[]}]},{"_type":"portableTable","_key":"b4785","rows":[{"_key":"b4786","cells":[{"_key":"b4787","text":[{"_type":"block","_key":"b4789","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4788","text":"Tool","marks":["strong"]}]}]},{"_key":"b4790","text":[{"_type":"block","_key":"b4792","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4791","text":"Mechanism","marks":["strong"]}]}]},{"_key":"b4793","text":[{"_type":"block","_key":"b4795","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4794","text":"Scenes you can create","marks":["strong"]}]}]},{"_key":"b4796","text":[{"_type":"block","_key":"b4798","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4797","text":"Brand system","marks":["strong"]}]}]},{"_key":"b4799","text":[{"_type":"block","_key":"b4801","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4800","text":"Team access","marks":["strong"]}]}]}]},{"_key":"b4802","cells":[{"_key":"b4803","text":[{"_type":"block","_key":"b4805","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4804","text":"Melius","marks":[]}]}]},{"_key":"b4806","text":[{"_type":"block","_key":"b4808","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4807","text":"Generative scene, composited artwork","marks":[]}]}]},{"_key":"b4809","text":[{"_type":"block","_key":"b4811","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4810","text":"5/5","marks":[]}]}]},{"_key":"b4812","text":[{"_type":"block","_key":"b4814","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4813","text":"4/5","marks":[]}]}]},{"_key":"b4815","text":[{"_type":"block","_key":"b4817","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4816","text":"5/5","marks":[]}]}]}]},{"_key":"b4818","cells":[{"_key":"b4819","text":[{"_type":"block","_key":"b4821","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4820","text":"Placeit","marks":[]}]}]},{"_key":"b4822","text":[{"_type":"block","_key":"b4824","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4823","text":"Template library","marks":[]}]}]},{"_key":"b4825","text":[{"_type":"block","_key":"b4827","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4826","text":"2/5","marks":[]}]}]},{"_key":"b4828","text":[{"_type":"block","_key":"b4830","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4829","text":"3/5","marks":[]}]}]},{"_key":"b4831","text":[{"_type":"block","_key":"b4833","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4832","text":"4/5","marks":[]}]}]}]},{"_key":"b4834","cells":[{"_key":"b4835","text":[{"_type":"block","_key":"b4837","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4836","text":"Illustrator Mockup","marks":[]}]}]},{"_key":"b4838","text":[{"_type":"block","_key":"b4840","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4839","text":"Inferred 3D, vector decal","marks":[]}]}]},{"_key":"b4841","text":[{"_type":"block","_key":"b4843","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4842","text":"4/5","marks":[]}]}]},{"_key":"b4844","text":[{"_type":"block","_key":"b4846","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4845","text":"2/5","marks":[]}]}]},{"_key":"b4847","text":[{"_type":"block","_key":"b4849","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4848","text":"2/5","marks":[]}]}]}]},{"_key":"b4850","cells":[{"_key":"b4851","text":[{"_type":"block","_key":"b4853","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4852","text":"Pacdora","marks":[]}]}]},{"_key":"b4854","text":[{"_type":"block","_key":"b4856","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4855","text":"True 3D render, plus dielines","marks":[]}]}]},{"_key":"b4857","text":[{"_type":"block","_key":"b4859","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4858","text":"3/5","marks":[]}]}]},{"_key":"b4860","text":[{"_type":"block","_key":"b4862","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4861","text":"1/5","marks":[]}]}]},{"_key":"b4863","text":[{"_type":"block","_key":"b4865","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4864","text":"2/5","marks":[]}]}]}]},{"_key":"b4866","cells":[{"_key":"b4867","text":[{"_type":"block","_key":"b4869","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4868","text":"Dynamic Mockups","marks":[]}]}]},{"_key":"b4870","text":[{"_type":"block","_key":"b4872","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4871","text":"Template library, plus a generative path","marks":[]}]}]},{"_key":"b4873","text":[{"_type":"block","_key":"b4875","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4874","text":"4/5","marks":[]}]}]},{"_key":"b4876","text":[{"_type":"block","_key":"b4878","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4877","text":"3/5","marks":[]}]}]},{"_key":"b4879","text":[{"_type":"block","_key":"b4881","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4880","text":"4/5","marks":[]}]}]}]},{"_key":"b4882","cells":[{"_key":"b4883","text":[{"_type":"block","_key":"b4885","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4884","text":"Canva","marks":[]}]}]},{"_key":"b4886","text":[{"_type":"block","_key":"b4888","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4887","text":"Template library, plus generative tools","marks":[]}]}]},{"_key":"b4889","text":[{"_type":"block","_key":"b4891","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4890","text":"3/5","marks":[]}]}]},{"_key":"b4892","text":[{"_type":"block","_key":"b4894","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4893","text":"4/5","marks":[]}]}]},{"_key":"b4895","text":[{"_type":"block","_key":"b4897","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4896","text":"2/5","marks":[]}]}]}]},{"_key":"b4898","cells":[{"_key":"b4899","text":[{"_type":"block","_key":"b4901","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4900","text":"Recraft","marks":[]}]}]},{"_key":"b4902","text":[{"_type":"block","_key":"b4904","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4903","text":"Both, template and generative","marks":[]}]}]},{"_key":"b4905","text":[{"_type":"block","_key":"b4907","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4906","text":"4/5","marks":[]}]}]},{"_key":"b4908","text":[{"_type":"block","_key":"b4910","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4909","text":"2/5","marks":[]}]}]},{"_key":"b4911","text":[{"_type":"block","_key":"b4913","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4912","text":"3/5","marks":[]}]}]}]}]},{"_type":"block","_key":"b4915","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b4914","text":"1. Melius","marks":[]}],"anchorId":"1-melius"},{"_type":"block","_key":"b4917","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4916","text":"Melius is the Agentic OS for creative work. The canvas exists so an agent can assemble the pipeline and leave every step open to you. Describe the mockup in plain language and Mel, the Melius agent, builds the pipeline, choosing the right model for the scene and the right one for the type. The scene node and the logo node stay separate in the design process, which is the reason your logo survives properly in the final output. You're never forced to choose between a generated environment and an intact logo.","marks":[]}]},{"_type":"block","_key":"b4925","style":"normal","markDefs":[{"_type":"link","_key":"b4919","href":"/blog/best-tools-ai-generated-design-concepts","isNewTab":false},{"_type":"link","_key":"b4922","href":"/blog/best-ai-tools-product-photo-variants","isNewTab":false}],"children":[{"_type":"span","_key":"b4918","text":"The Studio node is a layered editing surface with text overlays, and you can upload your own font file and use it in the layer panel. That means the practical workflow is: generate the scene, then composite the real logo as a layer on top, in your real typeface. Inpaint handles the middle ground by masking a region and regenerating only inside it, so a surface can be changed around artwork that stays put. Where a mark does have to be rendered into the image, per-step routing lets you send that node to GPT Image 2, which Melius recommends for visible typography and packaging shots with legible labels, while the surrounding scene goes to a model chosen for materials and lighting. The same node-separation logic carries over to ","marks":[]},{"_type":"span","_key":"b4920","text":"AI generated design concepts","marks":["b4919"]},{"_type":"span","_key":"b4921","text":" and to ","marks":[]},{"_type":"span","_key":"b4923","text":"product photo variants","marks":["b4922"]},{"_type":"span","_key":"b4924","text":".","marks":[]}]},{"_type":"block","_key":"b4927","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4926","text":"The brand system is a documented practice: a text node holding voice, hex codes, typography and photography rules, wired into every generation node on the canvas. It's reusable within a canvas, and worth knowing that it doesn't follow you to a new one, since context lives at the canvas level.","marks":[]}]},{"_type":"block","_key":"b4929","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b4928","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b4931","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4930","text":"Layered compositing, so the real mark sits on top of a generated scene, in a font file you uploaded.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4933","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4932","text":"Per-step model routing, so the typography node and the material node can use different models.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4935","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4934","text":"Masked inpainting, which changes a surface without touching the artwork on it.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4937","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4936","text":"Real product details go in as context, which matters for packaging mockups.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4939","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4938","text":"Magic Resize re-composes a mockup per aspect ratio instead of cropping it.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4941","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4940","text":"Up to 8 seats on self-serve plans for your team and client reviewers, with unlimited seats on Enterprise.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4943","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4942","text":"The trade-off: the fidelity here is a property of how you build the graph, not a guarantee the tool enforces. Ask a model to draw your logo and it will draw a logo. There's also no library of pre-shot scenes, so if what you want is a specific t-shirt on a specific model in three clicks, a template tool gets you there faster. And the brand anchor doesn't persist across canvases, which means copying it over or injecting it is a real step in the workflow.","marks":[]}]},{"_type":"block","_key":"b4951","style":"normal","markDefs":[{"_type":"link","_key":"b4945","href":"/pricing","isNewTab":false},{"_type":"link","_key":"b4948","href":"/models","isNewTab":false}],"children":[{"_type":"span","_key":"b4944","text":"Paid plans start at an accessible monthly rate, with current pricing on the ","marks":[]},{"_type":"span","_key":"b4946","text":"pricing page","marks":["b4945"]},{"_type":"span","_key":"b4947","text":" and the current library of leading models on the ","marks":[]},{"_type":"span","_key":"b4949","text":"models page","marks":["b4948"]},{"_type":"span","_key":"b4950","text":".","marks":[]}]},{"_type":"block","_key":"b4953","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4952","text":"Best for: brand and agency teams who need mockups in scenes nobody has photographed, and who need the logo in them to be the actual logo.","marks":[]}]},{"_type":"block","_key":"b4955","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b4954","text":"2. Placeit","marks":[]}],"anchorId":"2-placeit"},{"_type":"block","_key":"b4957","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4956","text":"Placeit is good at breadth, with a large mockup library and a template-library mechanism that preserves your artwork by construction. Upload the file, pick a scene, and the template conforms it to the fabric's folds and lighting, deterministically, every time.","marks":[]}]},{"_type":"block","_key":"b4959","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4958","text":"Its licensing is refreshingly plain: Placeit says a commercial license is included in all downloads, and the subscription carries unlimited downloads. The operative grant attaches to paid downloads, and it is revocable, so read the license terms if you are reselling.","marks":[]}]},{"_type":"block","_key":"b4961","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b4960","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b4963","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4962","text":"A large scene library, spanning apparel, print, packaging and devices.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4965","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4964","text":"Fidelity here is structural: the template warps your exact file onto a pre-shot scene, so what comes back is the file you supplied.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4967","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4966","text":"A Brand Kit holding logo, palette and font pairing, applied from the editor and persisting across designs.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4969","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4968","text":"A commercial license on every paid download, and repeatable output, so the same scene gives the same result next quarter.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4971","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4970","text":"The trade-off: you're limited to scenes that already exist. If the brief calls for your packaging on a market stall in a specific light, no library has it, and this is where generative tools do their real work. Its Brand Kit stores your business name, logo, palette and font pairing and applies them from inside the editor, so the brand side is covered; it's the scenes that are fixed.","marks":[]}]},{"_type":"block","_key":"b4973","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4972","text":"Best for: standard mockups where a stock scene is fine and fidelity is non-negotiable.","marks":[]}]},{"_type":"block","_key":"b4975","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b4974","text":"3. Adobe Illustrator Mockup","marks":[]}],"anchorId":"3-adobe-illustrator-mockup"},{"_type":"block","_key":"b4977","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4976","text":"Illustrator's Mockup feature shows that this job never required a generative model at all. A neural network predicts the shape of the scene from a single photograph, then meshing algorithms map a vector decal onto that inferred geometry. Adobe says the feature preserves the quality of a decal as users place it on the 3D surface, and it documents the mechanism, whereas the other vendors here only assert it.","marks":[]}]},{"_type":"block","_key":"b4979","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4978","text":"For anyone already working in vector, the path from artwork to mockup is short: the logo is already in the file.","marks":[]}]},{"_type":"block","_key":"b4981","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b4980","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b4983","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4982","text":"Vector decals stay vector, so the mark is resolution independent.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4985","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4984","text":"Works from a single ordinary photograph, with no prepared template needed.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4987","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4986","text":"Bundled with Illustrator, so it isn't another subscription.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4989","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4988","text":"Cylinders and simple curved surfaces such as mugs and cans map convincingly.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b4991","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4990","text":"The trade-off: the limits worth knowing are geometric. Testing the 2023 beta, CreativePro reported spheres came out poorly with no true spherical distortion, and fabric creases on a t-shirt were not followed, because the feature reads shape and not shading. Reviewers also reported the mapped artwork was not live-editable afterward, since expanding the appearance doesn't release the distorted logo. Mockup left beta in October 2024 and Adobe's release notes for that version claim precise vector placement on planar surfaces, which is exactly the flat-perspective case the beta handled worst, so treat the curved-surface findings as the ones still worth testing and re-test anything load-bearing on your own artwork. The feature requires Illustrator and the skills that go with it.","marks":[]}]},{"_type":"block","_key":"b4993","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4992","text":"Best for: designers already in Illustrator putting vector marks onto simple curved surfaces.","marks":[]}]},{"_type":"block","_key":"b4995","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b4994","text":"4. Pacdora","marks":[]}],"anchorId":"4-pacdora"},{"_type":"block","_key":"b4997","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4996","text":"Pacdora is good at packaging specifically, and it's the only tool here that treats a dieline as a first-class object. It pairs a large mockup and dieline library with a real 3D render engine, so a box is an actual box with actual geometry rather than a photograph of one.","marks":[]}]},{"_type":"block","_key":"b4999","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b4998","text":"For structural packaging work where the folds have to be right, that is the difference between a render and a proof.","marks":[]}]},{"_type":"block","_key":"b5001","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5000","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5003","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5002","text":"True 3D rendering, so artwork is a texture on real geometry and survives intact.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5005","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5004","text":"Dieline generation alongside the mockups.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5007","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5006","text":"High-resolution export on its higher tiers, plus video output, though the free tier exports no rendered images at all.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5009","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5008","text":"Free tier available for evaluation, with watermarked previews rather than exports.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5011","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5010","text":"The trade-off: the licensing needs reading carefully, because the split is sharp. Its lower tier is marked for personal use only, and commercial use plus a resale license arrive together only on its top tier. Pricing is per seat, billed annually or month-to-month, with the commercial tier costing meaningfully more.","marks":[]}]},{"_type":"block","_key":"b5013","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5012","text":"Best for: packaging design where structure and dielines matter as much as the render.","marks":[]}]},{"_type":"block","_key":"b5015","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5014","text":"5. Dynamic Mockups","marks":[]}],"anchorId":"5-dynamic-mockups"},{"_type":"block","_key":"b5017","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5016","text":"Dynamic Mockups exists for volume and automation. Alongside its template library it exposes an application programming interface (API) and batch export, with product catalogs and saved templates, which makes it the natural fit for print-on-demand work where hundreds of designs go onto the same set of blanks.","marks":[]}]},{"_type":"block","_key":"b5019","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5018","text":"Its free tier gives watermark-free web exports, which is unusual here.","marks":[]}]},{"_type":"block","_key":"b5021","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5020","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5023","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5022","text":"An API and batch export, so mockups can be generated programmatically per stock keeping unit (SKU).","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5025","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5024","text":"Product catalogs and saved templates for repeatable output.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5027","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5026","text":"Unlimited saved templates once you're on the paid tier.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5029","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5028","text":"A free tier with watermark-free web exports.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5031","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5030","text":"The trade-off: it ships both a library path and a generative path under one brand, and only the library path preserves your file, so it's on you to know which one you are using. API exports carry a watermark until you upgrade, while web exports don't. Worth reading the terms before you rely on it commercially, since the pricing page never mentions commercial use, and the terms of service license content for personal or internal business use only.","marks":[]}]},{"_type":"block","_key":"b5033","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5032","text":"Best for: print-on-demand and catalog automation at volume.","marks":[]}]},{"_type":"block","_key":"b5035","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5034","text":"6. Canva","marks":[]}],"anchorId":"6-canva"},{"_type":"block","_key":"b5037","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5036","text":"Canva covers the brand-system half of this, and its Brand Kit is deep. It acquired Smartmockups in 2021 and absorbed the library when the standalone site closed in 2024, so the scene collection is large, and the mockup templates preserve uploaded artwork.","marks":[]}]},{"_type":"block","_key":"b5039","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5038","text":"For a team already designing in Canva, the mockup is one step inside the document they are already building.","marks":[]}]},{"_type":"block","_key":"b5041","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5040","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5043","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5042","text":"A real brand kit applying fonts, colors and logos consistently across everything.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5045","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5044","text":"A large inherited mockup library from the Smartmockups acquisition.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5047","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5046","text":"Mockups sit inside the same document as the rest of the campaign.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5049","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5048","text":"A free tier that keeps the core tools.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5051","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5050","text":"The trade-off: Business is priced per person annually, so a reviewing stakeholder is a line item. Its generative tools sit alongside the template mockups, and the two behave differently on fidelity. Anyone still looking for smartmockups.com should know it closed on September 27, 2024 and now redirects to Canva's mockups page.","marks":[]}]},{"_type":"block","_key":"b5053","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5052","text":"Best for: teams already standardized on Canva who want brand consistency more than scene novelty.","marks":[]}]},{"_type":"block","_key":"b5055","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5054","text":"7. Recraft","marks":[]}],"anchorId":"7-recraft"},{"_type":"block","_key":"b5057","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5056","text":"Recraft does the one thing that makes generated type recoverable: it outputs SVG, so lettering that comes back slightly wrong arrives as clean vector paths you can reshape in a design tool instead of regenerating the whole image. In a category where typography is the main failure mode, that means a wrong letter is fixable.","marks":[]}]},{"_type":"block","_key":"b5059","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5058","text":"It also handles 300 DPI and CMYK output, which matters if the mockup is heading toward print.","marks":[]}]},{"_type":"block","_key":"b5061","style":"h3","markDefs":[],"children":[{"_type":"span","_key":"b5060","text":"What it does well","marks":[]}]},{"_type":"block","_key":"b5063","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5062","text":"Native SVG output with clean paths and structured layers, so lettering can be reshaped by hand.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5065","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5064","text":"300 DPI and CMYK support for print-bound work.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5067","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5066","text":"Both a template path and a generative path, covering two mechanisms in one tool.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5069","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5068","text":"A free tier of daily generations for evaluation.","marks":[]}],"listItem":"bullet","level":1},{"_type":"block","_key":"b5071","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5070","text":"The trade-off: the free plan is the one to read closely. Images generated on it are owned by Recraft, appear publicly in its community gallery, and carry no commercial license. Ownership and commercial rights arrive on the paid tiers, and Recraft's terms say images made while subscribed stay yours after the subscription ends. Two things to set expectations on: generated text arrives as outlined paths, so you can reshape a letter but you cannot retype a word, and its chat mode, which Recraft calls Agentic, carries context between turns and will chain a few steps, though it is not building a graph you keep.","marks":[]}]},{"_type":"block","_key":"b5073","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5072","text":"Best for: work where generated type has to be fixable, and print output is the destination.","marks":[]}]},{"_type":"block","_key":"b5075","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5074","text":"When a template beats a generated mockup","marks":[]}],"anchorId":"when-a-template-beats-a-generated-mockup"},{"_type":"block","_key":"b5077","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5076","text":"If the scene you need already exists, use the template. A t-shirt on a plain background, a phone in a hand, a poster on a brick wall: these are solved and free of fidelity risk, and generating them is slower. The library tools in this comparison exist because most mockup requests are ordinary.","marks":[]}]},{"_type":"block","_key":"b5079","style":"normal","markDefs":[],"children":[{"_type":"span","_key":"b5078","text":"Generation pays off when the scene doesn't exist and can't be shot: your packaging in a market you have never photographed, or a summer product in February. At that point the question stops being which tool has more templates and becomes whether the workflow can put your real artwork into an invented world without redrawing it. That's a compositing problem. The tools that keep the scene and the logo as separate steps can take that brief; the library tools can't.","marks":[]}]},{"_type":"block","_key":"b5081","style":"h2","markDefs":[],"children":[{"_type":"span","_key":"b5080","text":"Frequently asked questions","marks":[]}],"anchorId":"frequently-asked-questions"},{"_type":"faqList","_key":"b5082","items":"$3f:props:post:faq"},{"_type":"block","_key":"b5087","style":"normal","markDefs":[{"_type":"link","_key":"b5084","href":"https://app.melius.com","isNewTab":true}],"children":[{"_type":"span","_key":"b5083","text":"Generate the scene nobody has photographed, then composite your real logo on top in your real typeface, in one graph you can re-run for the next brief. ","marks":[]},{"_type":"span","_key":"b5085","text":"Open Melius","marks":["b5084"]},{"_type":"span","_key":"b5086","text":".","marks":[]}]}]}}]
7:C
