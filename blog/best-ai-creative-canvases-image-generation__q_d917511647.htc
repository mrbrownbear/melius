,null,{"className":"hidden lg:col-start-1 lg:block lg:justify-self-end lg:pr-4","children":["$","div",null,{"className":"bg-white sticky top-28 w-52 rounded-2xl p-6","children":["$","$L13",null,{"sections":[{"_key":"what-is-the-best-ai-creative-canvas-for-image-generation","title":"What is the best AI creative canvas for image generation?"},{"_key":"what-to-know-before-you-pick","title":"What to know before you pick"},{"_key":"what-separates-a-good-ai-canvas","title":"What separates a good AI canvas?"},{"_key":"the-five-compared","title":"The five compared"},{"_key":"1-melius","title":"1. Melius"},{"_key":"2-krea","title":"2. Krea"},{"_key":"3-flora","title":"3. Flora"},{"_key":"4-figma-weave","title":"4. Figma Weave"},{"_key":"5-comfyui","title":"5. ComfyUI"},{"_key":"when-you-don-t-need-a-canvas-at-all","title":"When you don't need a canvas at all"},{"_key":"frequently-asked-questions","title":"Frequently asked questions"}],"className":"w-full flex-col gap-4 overflow-visible md:static","linkClassName":"t-b-3 !font-semibold text-foreground-muted leading-snug transition-colors hover:text-gray-dark-1","activeLinkClassName":"text-orange"}]}]}],["$","div",null,{"className":"wysiwyg bg-white w-full min-w-0 rounded-3xl p-6 md:p-10 lg:col-start-2 lg:p-12","children":[["$","h2","b2887",{"id":"what-is-the-best-ai-creative-canvas-for-image-generation","className":"scroll-mt-28","children":["What is the best AI creative canvas for image generation?"]}],["$","p","b2889",{"children":["The right canvas is the one whose graph you won't have to build by hand, because on every tool here the graph is the product and the only real difference is who assembles it. A canvas beats a prompt box for anything with more than one step, since each prompt, image and edit becomes a node you can rewire and re-run instead of starting over. That part is settled."]}],["$","p","b2891",{"children":["What isn't settled is the cost of entry. Node tools have historically asked you to learn them first, which is a fine trade for a technical artist and a bad one for a creative director who just wants the work made. That's the axis these five separate on."]}],"$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42","$L43","$L44","$L45","$L46","$L47","$L48","$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f","$L50","$L51"]}]]}]]}],"$L52"]
