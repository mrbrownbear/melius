0:{"buildId":"","data":[{"rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","$L3",null,{"model":{"slug":"eleven_v3","name":"ElevenLabs v3","provider":"ElevenLabs","category":"audio","releasedAt":"2025-01-01","categoryLabel":"Audio model","tagline":"ElevenLabs' most expressive text-to-speech model","description":"ElevenLabs v3 is ElevenLabs' most expressive text-to-speech model, with nuanced delivery and emotion.","capabilities":["Turn written text into natural speech","Add expressive, emotional delivery"],"searchAliases":[],"faq":[{"question":"What is ElevenLabs v3?","answer":"ElevenLabs v3 is ElevenLabs' most expressive text-to-speech model, with nuanced delivery and emotion."},{"question":"How do I use ElevenLabs v3 on Melius?","answer":"Melius is a node-based canvas: add a audio node, pick ElevenLabs v3 from the model picker, and connect it to whatever should feed it or follow it. You only pay for what you generate."}]},"related":[{"slug":"scribe_v2","name":"ElevenLabs Scribe v2","provider":"ElevenLabs","category":"audio","releasedAt":"2025-01-01","categoryLabel":"Audio model","tagline":"Transcribe connected speech into text","description":"ElevenLabs Scribe v2 transcribes speech from connected audio. Select it on an audio node to turn recordings into text for further writing or analysis on the canvas.","capabilities":["Transcribe speech from connected audio into text"],"searchAliases":[],"faq":[{"question":"What is ElevenLabs Scribe v2?","answer":"ElevenLabs Scribe v2 transcribes speech from connected audio. Select it on an audio node to turn recordings into text for further writing or analysis on the canvas."},{"question":"How do I use ElevenLabs Scribe v2 on Melius?","answer":"Melius is a node-based canvas: add a audio node, pick ElevenLabs Scribe v2 from the model picker, and connect it to whatever should feed it or follow it. You only pay for what you generate."}]},{"slug":"sonilo-video-sfx","name":"Sonilo Video Sound Effects","provider":"Sonilo","category":"audio","releasedAt":"2026-07-30","categoryLabel":"Audio model","tagline":"Create a separate sound-effects track from video","description":"Sonilo Video Sound Effects generates an audio track matched to a connected video. The output is audio rather than a finished video, so you can use the effects separately in your workflow.","capabilities":["Generate effects from a connected video","Output a separate audio track"],"searchAliases":[],"faq":[{"question":"What is Sonilo Video Sound Effects?","answer":"Sonilo Video Sound Effects generates an audio track matched to a connected video. The output is audio rather than a finished video, so you can use the effects separately in your workflow."},{"question":"How do I use Sonilo Video Sound Effects on Melius?","answer":"Melius is a node-based canvas: add a audio node, pick Sonilo Video Sound Effects from the model picker, and connect it to whatever should feed it or follow it. You only pay for what you generate."}]},{"slug":"sonilo-sfx","name":"Sonilo Sound Effects","provider":"Sonilo","category":"audio","releasedAt":"2026-07-30","categoryLabel":"Audio model","tagline":"Generate sound effects from a text description","description":"Sonilo Sound Effects creates an audio effects track from your prompt. Describe the sound you need and choose a duration to produce effects for your creative workflow.","capabilities":["Generate sound effects from a text prompt"],"searchAliases":[],"faq":[{"question":"What is Sonilo Sound Effects?","answer":"Sonilo Sound Effects creates an audio effects track from your prompt. Describe the sound you need and choose a duration to produce effects for your creative workflow."},{"question":"How do I use Sonilo Sound Effects on Melius?","answer":"Melius is a node-based canvas: add a audio node, pick Sonilo Sound Effects from the model picker, and connect it to whatever should feed it or follow it. You only pay for what you generate."}]},{"slug":"xai-tts-v1","name":"xAI TTS v1","provider":"xAI","category":"audio","releasedAt":"2026-08-12","categoryLabel":"Audio model","tagline":"Generate spoken audio with xAI voices","description":"xAI TTS v1 converts text prompts into speech on Melius. Choose a voice and connect the generated audio to video, avatar, or other canvas workflows.","capabilities":["Generate speech from text"],"searchAliases":[],"faq":[{"question":"What is xAI TTS v1?","answer":"xAI TTS v1 converts text prompts into speech on Melius. Choose a voice and connect the generated audio to video, avatar, or other canvas workflows."},{"question":"How do I use xAI TTS v1 on Melius?","answer":"Melius is a node-based canvas: add a audio node, pick xAI TTS v1 from the model picker, and connect it to whatever should feed it or follow it. You only pay for what you generate."}]},{"slug":"minimax-speech-2.8-hd","name":"MiniMax Speech 2.8 HD","provider":"MiniMax","category":"audio","releasedAt":"2026-08-12","categoryLabel":"Audio model","tagline":"Text-to-speech generation with MiniMax voices","description":"MiniMax Speech 2.8 HD generates spoken audio from your text. Choose a voice on an audio node and create narration or voiceovers for downstream video and avatar workflows.","capabilities":["Generate speech from text"],"searchAliases":[],"faq":[{"question":"What is MiniMax Speech 2.8 HD?","answer":"MiniMax Speech 2.8 HD generates spoken audio from your text. Choose a voice on an audio node and create narration or voiceovers for downstream video and avatar workflows."},{"question":"How do I use MiniMax Speech 2.8 HD on Melius?","answer":"Melius is a node-based canvas: add a audio node, pick MiniMax Speech 2.8 HD from the model picker, and connect it to whatever should feed it or follow it. You only pay for what you generate."}]},{"slug":"gemini-3.1-flash-tts","name":"Gemini 3.1 Flash TTS","provider":"Google","category":"audio","releasedAt":"2026-08-04","categoryLabel":"Audio model","tagline":"Speech generation with expressive delivery instructions","description":"Gemini 3.1 Flash TTS generates speech from text with selectable voices. Include inline delivery instructions and expressive tags such as [laughing] and [whispering] to guide the performance.","capabilities":["Generate speech from text"],"searchAliases":[],"faq":[{"question":"What is Gemini 3.1 Flash TTS?","answer":"Gemini 3.1 Flash TTS generates speech from text with selectable voices. Include inline delivery instructions and expressive tags such as [laughing] and [whispering] to guide the performance."},{"question":"How do I use Gemini 3.1 Flash TTS on Melius?","answer":"Melius is a node-based canvas: add a audio node, pick Gemini 3.1 Flash TTS from the model picker, and connect it to whatever should feed it or follow it. You only pay for what you generate."}]},{"slug":"qwen-3-tts-1.7b","name":"Qwen3 TTS 1.7B","provider":"Alibaba","category":"audio","releasedAt":"2026-07-29","categoryLabel":"Audio model","tagline":"Alibaba text-to-speech on your canvas","description":"Qwen3 TTS 1.7B turns written text into spoken audio. Use it on an audio node to create narration or compare delivery with the other speech models in your canvas.","capabilities":["Generate speech from text"],"searchAliases":[],"faq":[{"question":"What is Qwen3 TTS 1.7B?","answer":"Qwen3 TTS 1.7B turns written text into spoken audio. Use it on an audio node to create narration or compare delivery with the other speech models in your canvas."},{"question":"How do I use Qwen3 TTS 1.7B on Melius?","answer":"Melius is a node-based canvas: add a audio node, pick Qwen3 TTS 1.7B from the model picker, and connect it to whatever should feed it or follow it. You only pay for what you generate."}]},{"slug":"fish-audio-s2.1-pro","name":"Fish Audio S2.1 Pro","provider":"Fish Audio","category":"audio","releasedAt":"2026-07-29","categoryLabel":"Audio model","tagline":"Generate speech from text with Fish Audio","description":"Fish Audio S2.1 Pro converts text into spoken audio on Melius. Select it on an audio node to create voiceovers and narration that you can connect to the rest of your workflow.","capabilities":["Generate speech from text"],"searchAliases":[],"faq":[{"question":"What is Fish Audio S2.1 Pro?","answer":"Fish Audio S2.1 Pro converts text into spoken audio on Melius. Select it on an audio node to create voiceovers and narration that you can connect to the rest of your workflow."},{"question":"How do I use Fish Audio S2.1 Pro on Melius?","answer":"Melius is a node-based canvas: add a audio node, pick Fish Audio S2.1 Pro from the model picker, and connect it to whatever should feed it or follow it. You only pay for what you generate."}]}]}]],["$L4","$L5","$L6","$L7","$L8"],"$L9"]}],"isPartial":"$@a","staleTime":"$b","varyParams":null},{"rsc":"$Lc","isPartial":"$@d","staleTime":"$b","varyParams":null},{"rsc":"$Le","isPartial":"$@f","staleTime":"$b","varyParams":"$10"},{"rsc":"$L11","isPartial":"$@12","staleTime":"$b","varyParams":"$10"}],"isUpgradeableISRFallback":false,"a":"$@13","rootVaryParams":null,"needsRuntimeRequest":"$@14"}
