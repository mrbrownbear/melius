{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/proxy.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/_next/(.*)",
      "dest": "https://cdn.jsdelivr.net/gh/mrbrownbear/melius@112a8898fd2d608081edddf0d4518443db2e20b2/_next/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "https://cdn.jsdelivr.net/gh/mrbrownbear/melius@112a8898fd2d608081edddf0d4518443db2e20b2/media/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "https://cdn.jsdelivr.net/gh/mrbrownbear/melius@112a8898fd2d608081edddf0d4518443db2e20b2/images/$1"
    },
    {
      "src": "/videos/(.*)",
      "dest": "https://cdn.jsdelivr.net/gh/mrbrownbear/melius@112a8898fd2d608081edddf0d4518443db2e20b2/videos/$1"
    },
    {
      "src": "/_external/(.*)",
      "dest": "https://cdn.jsdelivr.net/gh/mrbrownbear/melius@112a8898fd2d608081edddf0d4518443db2e20b2/_external/$1"
    },
    {
      "src": "/downloads/(.*)",
      "dest": "https://cdn.jsdelivr.net/gh/mrbrownbear/melius@112a8898fd2d608081edddf0d4518443db2e20b2/downloads/$1"
    },
    {
      "src": "/svg/(.*)",
      "dest": "https://cdn.jsdelivr.net/gh/mrbrownbear/melius@112a8898fd2d608081edddf0d4518443db2e20b2/svg/$1"
    },
    {
      "src": "/(icon(?:__q_[^/]+)?\\.png)",
      "dest": "https://cdn.jsdelivr.net/gh/mrbrownbear/melius@112a8898fd2d608081edddf0d4518443db2e20b2/$1"
    },
    {
      "src": "/(opengraph-image(?:__q_[^/]+)?\\.png)",
      "dest": "https://cdn.jsdelivr.net/gh/mrbrownbear/melius@112a8898fd2d608081edddf0d4518443db2e20b2/$1"
    },
    {
      "src": "/(twitter-image(?:__q_[^/]+)?\\.png)",
      "dest": "https://cdn.jsdelivr.net/gh/mrbrownbear/melius@112a8898fd2d608081edddf0d4518443db2e20b2/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/proxy.js?path=$1"
    }
  ]
}
