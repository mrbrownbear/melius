{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/media/:path*",
      "destination": "https://raw.githubusercontent.com/mrbrownbear/melius/main/media/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://raw.githubusercontent.com/mrbrownbear/melius/main/images/:path*"
    },
    {
      "source": "/videos/:path*",
      "destination": "https://raw.githubusercontent.com/mrbrownbear/melius/main/videos/:path*"
    },
    {
      "source": "/_external/:path*",
      "destination": "https://raw.githubusercontent.com/mrbrownbear/melius/main/_external/:path*"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).webm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
