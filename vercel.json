{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/proxy.js": {
      "maxDuration": 30
    },
    "api/asset.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "^/(.*\\.(?:js|mjs|css|woff|woff2|ttf|otf|png|jpg|jpeg|gif|webp|avif|svg|ico|mp4|webm|mp3|wav|glb|gltf|wasm|json|xml|txt|pdf))$",
      "destination": "/api/asset.js?path=$1"
    },
    {
      "source": "/_external/:path*",
      "destination": "/api/asset.js?path=_external/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/proxy.js?path=:path*"
    }
  ]
}
