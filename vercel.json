{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/proxy.js": {
      "maxDuration": 30
    },
    "api/asset.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/api/proxy.js?path="
    },
    {
      "src": "^/__health$",
      "dest": "/api/proxy.js?path=__health"
    },
    {
      "src": "^/__debug$",
      "dest": "/api/proxy.js?path=__debug"
    },
    {
      "src": "^/__client_error$",
      "methods": [
        "POST"
      ],
      "dest": "/api/proxy.js?path=__client_error"
    },
    {
      "src": "^/_external/(.*)$",
      "dest": "/api/asset.js?path=_external/$1"
    },
    {
      "src": "^/(.*\\.(?:png|jpg|jpeg|gif|webp|avif|svg|ico|mp4|webm|mp3|wav|glb|gltf|wasm|json|xml|txt|pdf))$",
      "dest": "/api/asset.js?path=$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/proxy.js?path=$1"
    }
  ]
}
